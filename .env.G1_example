# G1 默认值模板（v6：完整模板，不是覆盖模板）。
#
# 触发路径（项目既有规范）：
#   1. core/settings.py 通过 _cfg_str/_cfg_bool 从 .env 读键；
#   2. 如 .env 缺键或键值为空，从对应 .env.<ROBOT>_example 回填默认值；
#   3. NUWAX_ACTIVE_ROBOT=g1 时回填本文件；NUWAX_ACTIVE_ROBOT=go2 时回填 .env.GO2_example（.env.example 别名）；
#   4. 第三方机器人（未支持的 robot_id）兜底回填 .env.GO2_example。
#
# v6 修订要点（OpenSpec g1-rtabnav2-adapter v6）：
#   - v5 把本文件写成"覆盖模板"（只 7 个 NUWAX_GEOMETRY_* 键的子集），与项目"完整默认值模板"规范冲突；
#   - v6 改回"完整模板"：包含所有可能为空的 NUWAX_GEOMETRY_* 键，覆盖 G1 实机话题根因纠正值；
#   - 实机 .env 缺键时由 core/settings.py 自动从本文件回填（G1 模式），无须手动 cp；
#   - 本文件不包含 NUWAX_ACTIVE_ROBOT 键（由用户实机 .env 显式设置）。
#
# 与 .env.GO2_example（v5 改名自 .env.example）差异：
#   - 物理量（lidar/imu/odom/base/lidar_frame/robot_radius/inflation_radius）取 G1 实机话题值；
#   - 其他 50+ 算法调参键（costmap/TF/timestamp/crop/voxel 等）G1 与 GO2 通用，沿用 core/settings.py 默认；
#   - G1 端 R8 风险：drivers/g1/manifest.py:47 forbidden_apt_packages 复核未做，rtabmap-ros 实际安装路径未验证。

# ---------------------------------------------------------------------------
# 平台公共开关（与 GO2 范式共享；G1 端也启用）
# ---------------------------------------------------------------------------
NUWAX_GEOMETRY_ENABLED=true
NUWAX_GEOMETRY_REQUIRE_ROS2=true
NUWAX_GEOMETRY_SETUP_SCRIPT=/home/unitree/nuwax-robot-bridge/services/geometry/ros2_ws/install/setup.bash
NUWAX_GEOMETRY_GO2SLAM_SETUP_SCRIPT=/home/unitree/nuwax-robot-bridge/services/geometry/ros2_ws/src/GO2_RTABNAV2/ws/install/setup.bash

# ---------------------------------------------------------------------------
# 外部 RTAB-Map 栈（v6 关键修复：v5 没声明 G1 EXTERNAL_SCRIPT，runtime 报 geometry_runtime_unavailable）
# ---------------------------------------------------------------------------
NUWAX_GEOMETRY_EXTERNAL_ENABLED=true
NUWAX_GEOMETRY_EXTERNAL_SCRIPT=/home/unitree/nuwax-robot-bridge/services/geometry/ros2_ws/src/GO2_RTABNAV2/robot_slam.sh
NUWAX_GEOMETRY_EXTERNAL_ARGS=--mapping
NUWAX_GEOMETRY_EXTERNAL_PROCESS_NAME=robot_slam.sh
NUWAX_GEOMETRY_EXTERNAL_LOG_NAME=robot_slam.log
NUWAX_GEOMETRY_EXTERNAL_PROVIDES_MAP=true
NUWAX_GEOMETRY_EXTERNAL_PROVIDES_NAV2=true
NUWAX_GEOMETRY_EXTERNAL_PROVIDES_TF=true
NUWAX_GEOMETRY_EXTERNAL_INPUT_BRIDGE_ENABLED=false
NUWAX_GEOMETRY_EXTERNAL_POINT_CLOUD_BRIDGE_ENABLED=false
NUWAX_GEOMETRY_EXTERNAL_FRONTIER_TOPIC=explore/frontiers

# ---------------------------------------------------------------------------
# 物理量（G1 实机话题根因纠正：2026-06-29 用户实测）
# ---------------------------------------------------------------------------

# lidar topic — Livox Mid-360 原始点云（sensor_msgs/PointCloud2，livox_ros_driver2 命名）
NUWAX_GEOMETRY_POINT_CLOUD_TOPIC=/utlidar/cloud_livox_mid360

# lidar frame — livox_ros_driver2 默认；M0.1 实机探测后确认（候选：livox_mid360_link / livox_frame / mid360_link）
NUWAX_GEOMETRY_LIDAR_FRAME=livox_mid360_link

# imu topic — Livox Mid-360 内置 IMU；用作 gravity 约束（v4 D4 subscribe_imu=true）
NUWAX_GEOMETRY_IMU_TOPIC=/utlidar/imu_livox_mid360

# imu frame — Livox Mid-360 头部 IMU frame
NUWAX_GEOMETRY_IMU_FRAME=utlidar_imu

# base frame — G1 URDF 双足标准 base（pelvis 链接）
NUWAX_GEOMETRY_BASE_FRAME=pelvis

# odom frame — 全局 odom frame（不带 g1 前缀；与 GO2 沿用 "odom"）
NUWAX_GEOMETRY_ODOM_FRAME=odom

# odom topic (mapping 模式主输入) — Unitree SLAM mapping 路径输出
# localization 模式可改为 /unitree/slam_relocation/odom（按 mode 分发靠用户实机 source 时改）
NUWAX_GEOMETRY_ODOM_TOPIC=/unitree/slam_mapping/odom

# 多路 odom 输入（备用；本期不用；R6 风险触发时才用）
NUWAX_GEOMETRY_SECONDARY_ODOM_TOPICS=

# map frame — 全局坐标系
NUWAX_GEOMETRY_MAP_FRAME=map

# pose topic — 当前定位姿态（平台侧订阅）
NUWAX_GEOMETRY_POSE_TOPIC=
# v6 写过 /g1/pose_map 但实机不存在该 topic；v7 清空（core/settings.py 不读 POSE_TOPIC，
# Pose 流由 Rust 桥 gRPC 接管；详见 memory rust-bridge-must-stay-rmw-isolation）。

# 障碍栅格（融合 RTAB /map + /cloud_obstacles）
NUWAX_GEOMETRY_OCCUPANCY_TOPIC=/map_obstacles
NUWAX_GEOMETRY_CLOUD_MAP_TOPIC=/cloud_map
NUWAX_GEOMETRY_COST_MAP_TOPIC=/global_costmap/costmap

# TF topic（与 GO2 沿用）
NUWAX_GEOMETRY_TF_TOPIC=/tf
NUWAX_GEOMETRY_TF_STATIC_TOPIC=/tf_static

# 物理尺寸 — 圆模型；G1 躯干 36x26cm + 4cm 安全边 ≈ 0.20m（URDF 估算）
NUWAX_GEOMETRY_ROBOT_RADIUS=0.20
NUWAX_GEOMETRY_INFLATION_RADIUS=0.65
NUWAX_GEOMETRY_INFLATION_COST_SCALING=2.5

# ---------------------------------------------------------------------------
# RTAB-Map 模式参数（G1 链路按 Livox Mid-360 调整）
# ---------------------------------------------------------------------------

# RTAB-Map 必须 3D（v4 D4）：Reg/Force3DoF=false（与 GO2 2D=true 不同）
# 注意：launch.py 内默认 qos=2 (BEST_EFFORT) / subscribe_scan_cloud=true / subscribe_imu=true
# 算法调参（与 GO2 通用）：
NUWAX_GEOMETRY_MIN_TRAVERSABILITY_SCORE=0.5

# ---------------------------------------------------------------------------
# 算法调参（G1 与 GO2 通用；core/settings.py 默认值同步）
# ---------------------------------------------------------------------------
NUWAX_GEOMETRY_ODOM_MAX_AGE_SEC=0.5
NUWAX_GEOMETRY_ODOM_MAX_ANGULAR_COVARIANCE=1.0
NUWAX_GEOMETRY_ODOM_MAX_LINEAR_COVARIANCE=1.0
NUWAX_GEOMETRY_ODOM_QUALITY_SOURCE=topic_covariance
NUWAX_GEOMETRY_ODOM_REQUIRE_COVARIANCE=false

# 点云裁剪（核心范围）
NUWAX_GEOMETRY_POINT_CLOUD_MAX_AGE_SEC=0.5
NUWAX_GEOMETRY_POINT_CLOUD_MAX_POINTS=1200
NUWAX_GEOMETRY_POINT_CLOUD_MAX_RANGE_M=8.0
NUWAX_GEOMETRY_POINT_CLOUD_MIN_RANGE_M=0.15
NUWAX_GEOMETRY_POINT_CLOUD_PREPROCESS_ENABLED=true
NUWAX_GEOMETRY_POINT_CLOUD_VOXEL_SIZE_M=0.05

# 点云裁剪几何（沿用 GO2）
NUWAX_GEOMETRY_POINT_CLOUD_CROP_FORWARD_MAX_M=6.0
NUWAX_GEOMETRY_POINT_CLOUD_CROP_FORWARD_MIN_M=-0.5
NUWAX_GEOMETRY_POINT_CLOUD_CROP_LATERAL_M=3.0
NUWAX_GEOMETRY_POINT_CLOUD_CROP_MAX_Z_M=1.6
NUWAX_GEOMETRY_POINT_CLOUD_CROP_MIN_Z_M=-0.6

# TF freshness
NUWAX_GEOMETRY_TF_MAX_AGE_SEC=0.5

# 时间戳策略
NUWAX_GEOMETRY_MAX_SENSOR_SKEW_SEC=0.2
NUWAX_GEOMETRY_TIMESTAMP_REQUIRE_MONOTONIC=true
NUWAX_GEOMETRY_TIMESTAMP_SOURCE=sensor_header

# 平台桥接（G1 与 GO2 一致：关闭）
NUWAX_GEOMETRY_PLATFORM_CMD_VEL_BRIDGE_ENABLED=false
NUWAX_GEOMETRY_PLATFORM_ODOM_TF_BRIDGE_ENABLED=false

# CycloneDDS 配置（G1 端留空，用 foxy 默认）
NUWAX_GEOMETRY_CYCLONEDDS_LIB_DIR=
NUWAX_GEOMETRY_DDS_IFACE=

# Traversability（G1 与 GO2 通用）
NUWAX_GEOMETRY_TRAVERSABILITY_FILTER_ENABLED=true
NUWAX_GEOMETRY_TRAVERSABILITY_MAX_SLOPE_DEG=18.0
NUWAX_GEOMETRY_TRAVERSABILITY_MAX_STEP_HEIGHT_M=0.15
NUWAX_GEOMETRY_TRAVERSABILITY_OUTPUT_LAYER=traversability

# ---------------------------------------------------------------------------
# RTAB-Map profile（沿用 GO2 范式）
# ---------------------------------------------------------------------------
NUWAX_RTABMAP_PROFILE_NAME=external_slam_nav2
NUWAX_RTABMAP_PROFILE_ENABLED=true
NUWAX_RTABMAP_DEFAULT_PROFILE=true
NUWAX_RTABMAP_DATABASE_ROOT=/home/unitree/nuwax-robot-bridge/runtime_data/geometry/rtabmap
NUWAX_RTABMAP_PCD_ROOT=
NUWAX_RTABMAP_LAUNCH_PACKAGE=rtabmap_launch
NUWAX_RTABMAP_LAUNCH_FILE=rtabmap.launch.py
NUWAX_RTABMAP_OCCUPANCY_PROJECTION=projected_occupancy
NUWAX_RTABMAP_INPUT_CONTRACT=platform_geometry_inputs
NUWAX_RTABMAP_OUTPUT_CONTRACT=platform_map_version_geometry_asset
NUWAX_RTABMAP_DATABASE_ASSET_NAME=external_slam_nav2_state.db
NUWAX_RTABMAP_PCD_ASSET_NAME=cloud_map.pcd
NUWAX_RTABMAP_OCCUPANCY_LAYER=occupancy_grid
NUWAX_RTABMAP_COSTMAP_LAYER=nav2_global_costmap
NUWAX_RTABMAP_TRAVERSABILITY_LAYER=traversability
NUWAX_RTABMAP_LOCALIZATION_STATUS=rtabmap_localization
NUWAX_RTABMAP_RELOCALIZATION_DIAGNOSTICS=rtabmap_icp

# ---------------------------------------------------------------------------
# Nav2（G1 端本期不开 Nav2；按 R8/R6 风险留待 F1）
# ---------------------------------------------------------------------------
NUWAX_NAV2_AUTOSTART=false
NUWAX_NAV2_USE_SIM_TIME=false
NUWAX_NAV2_ACTION_NAME=/navigate_to_pose
NUWAX_NAV2_LAUNCH_PACKAGE=nav2_bringup
NUWAX_NAV2_LAUNCH_FILE=nav2.launch.py
NUWAX_NAV2_PARAMS_FILE=
NUWAX_NAV2_MAP_YAML=
NUWAX_NAV2_COSTMAP_SOURCE=nav2_global
NUWAX_NAV2_GLOBAL_COSTMAP_TOPIC=/global_costmap/costmap
NUWAX_NAV2_LOCAL_COSTMAP_TOPIC=/local_costmap/costmap