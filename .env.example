# =========================
# nuwax_robot_bridge 主配置文件
# 说明：
# 1. 这里是用户直接编辑的统一配置入口。
# 2. 格式统一为 KEY=VALUE。
# 3. 以 # 开头的是注释。
# 4. 同名环境变量优先级高于这里的值。
# 5. 本模板覆盖常用配置项；settings.py 中仍有未在此列出的高级/默认项，
#    需要时参考 settings.py 与 docs 文档补充，不要假定此文件为全集。
# =========================

# -------------------------
# 当前激活机器人入口
# 说明：
# 1. 该值必须与 drivers/<robot_name> 文件夹同名。
# 2. 统一入口会按这个名字装配对应机器人实现。
# -------------------------
NUWAX_ACTIVE_ROBOT=go2

# -------------------------
# 平台几何引擎配置
# 说明：
# 1. 默认使用 external_slam_nav2，由 go2slam 启动脚本提供 /map、TF 和 Nav2。
# 2. 这一组配置供平台 geometry 侧车使用。
# 3. geometry ROS2 工作空间路径对应 services/geometry/ros2_ws。
# -------------------------
NUWAX_GEOMETRY_ENABLED=true
NUWAX_GEOMETRY_STACK=external_slam_nav2
NUWAX_GEOMETRY_REQUIRE_ROS2=true
# NUWAX_ROS_SETUP_SCRIPT 由 build_ros2_workspace.sh / bootstrap.py 消费（ROS2 环境 setup）
NUWAX_ROS_SETUP_SCRIPT=
NUWAX_GEOMETRY_SETUP_SCRIPT=/home/unitree/nuwax-robot-bridge/services/geometry/ros2_ws/install/setup.bash
NUWAX_GEOMETRY_CYCLONEDDS_LIB_DIR=
NUWAX_GEOMETRY_DDS_IFACE=eth0
# odom 话题：实机由 Unitree 驱动发布 /utlidar/robot_odom（/odom 在实机零消费）。
# 与 settings.py 默认 (/utlidar/robot_odom) 对齐，勿改回 /odom 否则建图链路接到无人发布话题。
NUWAX_GEOMETRY_ODOM_TOPIC=/utlidar/robot_odom
NUWAX_GEOMETRY_SECONDARY_ODOM_TOPICS=/uslam/localization/odom,/lio_sam_ros2/mapping/odometry,/odom_lio
NUWAX_GEOMETRY_IMU_TOPIC=/utlidar/imu
NUWAX_GEOMETRY_POINT_CLOUD_TOPIC=/utlidar/cloud_deskewed
NUWAX_GEOMETRY_TF_TOPIC=/tf
NUWAX_GEOMETRY_TF_STATIC_TOPIC=/tf_static
NUWAX_GEOMETRY_OCCUPANCY_TOPIC=/map
NUWAX_GEOMETRY_COST_MAP_TOPIC=/global_costmap/costmap
NUWAX_GEOMETRY_MAP_FRAME=map
NUWAX_GEOMETRY_ODOM_FRAME=odom
NUWAX_GEOMETRY_BASE_FRAME=base_footprint
NUWAX_GEOMETRY_LIDAR_FRAME=utlidar_lidar
# -------------------------
# 后端建图栈（RTAB-Map）首选名：统一使用 NUWAX_BACKEND_*。
# 说明：旧 NUWAX_RTABMAP_* 仍被兼容，但启动会触发弃用告警，下一轮治理删除。
#       这里给出 17 个首选键；与 settings.py:902-952 的默认值对齐。
# -------------------------
NUWAX_BACKEND_PROFILE_NAME=external_slam_nav2
NUWAX_BACKEND_PROFILE_ENABLED=true
NUWAX_BACKEND_DEFAULT_PROFILE=true
NUWAX_BACKEND_DATABASE_ROOT=/home/unitree/nuwax-robot-bridge/runtime_data/geometry/rtabmap
NUWAX_BACKEND_PCD_ROOT=/home/unitree/nuwax-robot-bridge/runtime_data/geometry/pcd
NUWAX_BACKEND_LAUNCH_PACKAGE=rtabmap_launch
NUWAX_BACKEND_LAUNCH_FILE=rtabmap.launch.py
NUWAX_BACKEND_OCCUPANCY_PROJECTION=projected_occupancy
NUWAX_BACKEND_INPUT_CONTRACT=platform_geometry_inputs
NUWAX_BACKEND_OUTPUT_CONTRACT=platform_map_version_geometry_asset
NUWAX_BACKEND_DATABASE_ASSET_NAME=external_slam_nav2_state.db
NUWAX_BACKEND_PCD_ASSET_NAME=cloud_map.pcd
NUWAX_BACKEND_OCCUPANCY_LAYER=occupancy_grid
NUWAX_BACKEND_COSTMAP_LAYER=nav2_global_costmap
NUWAX_BACKEND_TRAVERSABILITY_LAYER=traversability
NUWAX_BACKEND_LOCALIZATION_STATUS=rtabmap_localization
NUWAX_BACKEND_RELOCALIZATION_DIAGNOSTICS=rtabmap_icp
# -------------------------
# 几何质量 / 点云预处理 / 可通行性 / 外部栈能力声明 / 平台桥
# 说明：默认值与 settings.py:887-983 对齐；多为高级调参项，按需覆盖。
# -------------------------
# cloud_map 首选名（legacy NUWAX_CLOUD_MAP_TOPIC 已弃用，建图 PCD 导出链消费）
NUWAX_GEOMETRY_CLOUD_MAP_TOPIC=/cloud_map
NUWAX_GEOMETRY_IMU_FRAME=utlidar_imu
# 时间戳质量
NUWAX_GEOMETRY_TIMESTAMP_SOURCE=sensor_header
NUWAX_GEOMETRY_TIMESTAMP_REQUIRE_MONOTONIC=true
NUWAX_GEOMETRY_POINT_CLOUD_MAX_AGE_SEC=0.5
NUWAX_GEOMETRY_ODOM_MAX_AGE_SEC=0.5
NUWAX_GEOMETRY_TF_MAX_AGE_SEC=0.5
NUWAX_GEOMETRY_MAX_SENSOR_SKEW_SEC=0.2
# 点云预处理
NUWAX_GEOMETRY_POINT_CLOUD_PREPROCESS_ENABLED=true
NUWAX_GEOMETRY_POINT_CLOUD_VOXEL_SIZE_M=0.05
NUWAX_GEOMETRY_POINT_CLOUD_MIN_RANGE_M=0.15
NUWAX_GEOMETRY_POINT_CLOUD_MAX_RANGE_M=8.0
NUWAX_GEOMETRY_POINT_CLOUD_MAX_POINTS=1200
NUWAX_GEOMETRY_POINT_CLOUD_CROP_MIN_Z_M=-0.6
NUWAX_GEOMETRY_POINT_CLOUD_CROP_MAX_Z_M=1.6
NUWAX_GEOMETRY_POINT_CLOUD_CROP_FORWARD_MIN_M=-0.5
NUWAX_GEOMETRY_POINT_CLOUD_CROP_FORWARD_MAX_M=6.0
NUWAX_GEOMETRY_POINT_CLOUD_CROP_LATERAL_M=3.0
# 里程计质量
NUWAX_GEOMETRY_ODOM_QUALITY_SOURCE=topic_covariance
NUWAX_GEOMETRY_ODOM_REQUIRE_COVARIANCE=false
NUWAX_GEOMETRY_ODOM_MAX_LINEAR_COVARIANCE=1.0
NUWAX_GEOMETRY_ODOM_MAX_ANGULAR_COVARIANCE=1.0
# 可通行性
NUWAX_GEOMETRY_TRAVERSABILITY_FILTER_ENABLED=true
NUWAX_GEOMETRY_TRAVERSABILITY_MAX_SLOPE_DEG=18.0
NUWAX_GEOMETRY_TRAVERSABILITY_MAX_STEP_HEIGHT_M=0.15
NUWAX_GEOMETRY_MIN_TRAVERSABILITY_SCORE=0.5
NUWAX_GEOMETRY_TRAVERSABILITY_OUTPUT_LAYER=traversability
# 外部 SLAM/Nav2 栈能力声明
NUWAX_GEOMETRY_EXTERNAL_ENABLED=true
NUWAX_GEOMETRY_EXTERNAL_PROVIDES_MAP=true
NUWAX_GEOMETRY_EXTERNAL_PROVIDES_NAV2=true
NUWAX_GEOMETRY_EXTERNAL_PROVIDES_TF=true
# 平台桥（外部栈未自带输入时由平台补桥，默认关闭）
NUWAX_GEOMETRY_PLATFORM_ODOM_TF_BRIDGE_ENABLED=false
NUWAX_GEOMETRY_PLATFORM_CMD_VEL_BRIDGE_ENABLED=false
NUWAX_NAV2_MODE=external
NUWAX_NAV2_ACTION_NAME=/navigate_to_pose
NUWAX_NAV2_LAUNCH_PACKAGE=nav2_bringup
NUWAX_NAV2_LAUNCH_FILE=navigation_launch.py
NUWAX_NAV2_GLOBAL_COSTMAP_TOPIC=/global_costmap/costmap
NUWAX_NAV2_LOCAL_COSTMAP_TOPIC=/local_costmap/costmap
NUWAX_NAV2_COSTMAP_SOURCE=nav2_global
NUWAX_NAV2_AUTOSTART=true
NUWAX_NAV2_USE_SIM_TIME=false
NUWAX_NAV2_MAP_YAML=
NUWAX_NAV2_PARAMS_FILE=
NUWAX_GEOMETRY_EXTERNAL_SCRIPT=/home/unitree/nuwax-robot-bridge/services/geometry/start_rtabmap_sidecar.sh
NUWAX_GEOMETRY_EXTERNAL_ARGS=
# launch_rtabmap.sh --localization (default db-only, same as mapping->localization manual test):
# GO2_NAV_RTABMAP_PROTECT_SOURCE_DB=true
# GO2_NAV_AUTO_MAP_YAML=true                 optional static nav2/map.yaml (off by default)
# GO2_NAV_NAV2_START_DELAY_SEC=8             wait for map->odom before Nav2
# GO2_NAV_LOCALIZATION_FROZEN_GRID=true      default: latch /map from db (no live grid growth)
NUWAX_GEOMETRY_EXTERNAL_PROCESS_NAME=rtabmap_nav2
NUWAX_GEOMETRY_EXTERNAL_LOG_NAME=rtabmap_nav2.log
NUWAX_GEOMETRY_EXTERNAL_INPUT_BRIDGE_ENABLED=false
NUWAX_GEOMETRY_EXTERNAL_POINT_CLOUD_BRIDGE_ENABLED=false

# external_slam_nav2 默认外部 SLAM/Nav2 栈说明：
# start_rtabmap_sidecar.sh 启动 RTAB-Map + Nav2，使用平台 Go2 驱动提供的点云和里程计。
# 不要在网关 .env 全局设置 RMW_IMPLEMENTATION，避免影响 Unitree SDK ChannelFactory 初始化。
# 如果机器上没有独立 Unitree ROS2 驱动发布外部栈输入话题，可开启平台输入桥：
# NUWAX_GEOMETRY_EXTERNAL_INPUT_BRIDGE_ENABLED=true
# NUWAX_GEOMETRY_EXTERNAL_POINT_CLOUD_BRIDGE_ENABLED=true

# -------------------------
# 日志配置
# 说明：
# 1. 部署时直接配置 NUWAX_LOG_*。
# 2. 日志目录和日志文件建议与 systemd 或手工启动时的落盘路径保持一致。
# -------------------------
NUWAX_LOG_DIR=/home/unitree/nuwax-robot-bridge
NUWAX_LOG_FILE=/home/unitree/nuwax-robot-bridge/nuwax_robot_bridge.log
NUWAX_LOG_LEVEL=INFO
NUWAX_LOG_MAX_LINES=100000
NUWAX_LOG_TRIM_CHECK_INTERVAL=200
# 日志格式：留空=文本；json=结构化单行 JSON（settings.py:1298）
NUWAX_LOG_FORMAT=
# 子系统日志级别（留空=继承 NUWAX_LOG_LEVEL；settings.py:1270-1287）
# 取值 DEBUG/INFO/WARNING/ERROR。注意：直接 uvicorn 启动时这些键需进程环境已导出才生效。
NUWAX_LOG_LEVEL_GEOMETRY=
NUWAX_LOG_LEVEL_NAVIGATION=
NUWAX_LOG_LEVEL_PERCEPTION=
NUWAX_LOG_LEVEL_TTS=
NUWAX_LOG_LEVEL_GATEWAY=
NUWAX_LOG_LEVEL_RUNTIME=
NUWAX_LOG_LEVEL_ROS2=
NUWAX_LOG_LEVEL_DRIVER=

# -------------------------
# 宿主机网关配置
# 说明：
# 1. 这是给容器内 nuwaclaw / relay 调用的正式入口。
# 2. token 请与容器内配置保持一致。
# 3. 这里把常见 Docker 网段放宽到 172.16.0.0/12，避免 bridge 网络切换后再次 403。
# -------------------------
# NUWAX_PYTHON_BIN 由 start_gateway.sh / bootstrap.py 消费（选择 Python 解释器）
NUWAX_PYTHON_BIN=python3
NUWAX_GATEWAY_HOST=0.0.0.0
NUWAX_GATEWAY_PORT=8766
NUWAX_GATEWAY_PUBLIC_BASE_URL=http://host.docker.internal:8766
NUWAX_GATEWAY_ARTIFACT_DIR=/home/unitree/nuwax-robot-bridge/artifacts
NUWAX_GATEWAY_AGENT_TOKENS=agent-robot-bridge-token
NUWAX_GATEWAY_ADMIN_TOKENS=admin-robot-bridge-token
NUWAX_GATEWAY_AGENT_HIGH_RISK_ALLOWLIST=
NUWAX_GATEWAY_ALLOWED_SOURCE_CIDRS=0.0.0.0/0
NUWAX_GATEWAY_ALLOW_UNKNOWN_CLIENT_HOSTS=false
NUWAX_GATEWAY_SSE_KEEPALIVE_SEC=10.0
NUWAX_GATEWAY_WS_PING_INTERVAL_SEC=15.0

# -------------------------
# 容器内 relay 配置
# 说明：
# 1. 默认关闭，只有在容器内额外跑 relay 时才启用。
# 2. upstream token 一般直接复用 agent token。
# -------------------------
NUWAX_RELAY_ENABLED=false
NUWAX_RELAY_HOST=127.0.0.1
NUWAX_RELAY_PORT=9766
NUWAX_RELAY_UPSTREAM_BASE_URL=http://host.docker.internal:8766
NUWAX_RELAY_INCOMING_TOKENS=agent-robot-bridge-token
NUWAX_RELAY_UPSTREAM_TOKEN=agent-robot-bridge-token

# -------------------------
# 运行时数据与制品保留策略
# -------------------------
NUWAX_STATE_HISTORY_LIMIT=200
NUWAX_DIAGNOSTIC_HISTORY_LIMIT=200
NUWAX_OBSERVATION_HISTORY_LIMIT=100
NUWAX_PERCEPTION_HISTORY_LIMIT=100
NUWAX_LOCALIZATION_HISTORY_LIMIT=100
NUWAX_MAP_HISTORY_LIMIT=100
NUWAX_MAP_CATALOG_ROOT=/home/unitree/nuwax-robot-bridge/runtime_data/maps
NUWAX_MAP_AUTO_CREATE_LIBRARY=true
# 启动网关时不自动恢复/加载地图；由 Agent 通过 MCP 显式 activate_map / load_map_version
NUWAX_ACTIVE_MAP_RESTORE_ON_START=false
NUWAX_MAP_DELETE_ALSO_DELETE_LIBRARY=false
NUWAX_NAVIGATION_HISTORY_LIMIT=100
NUWAX_MEMORY_HISTORY_LIMIT=200
NUWAX_MEMORY_DB_PATH=/home/unitree/nuwax-robot-bridge/runtime_data/memory/vector_memory.db
NUWAX_MEMORY_TEXT_EMBEDDING_MODEL=tongyi-embedding-vision-flash-2026-03-06
NUWAX_MEMORY_TEXT_EMBEDDING_DIM=768
NUWAX_MEMORY_IMAGE_EMBEDDING_MODEL=tongyi-embedding-vision-flash-2026-03-06
NUWAX_MEMORY_IMAGE_EMBEDDING_DIM=768
NUWAX_MEMORY_EMBEDDING_API_KEY=
NUWAX_MEMORY_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
NUWAX_MEMORY_EMBEDDING_TIMEOUT_SEC=20.0
# 默认：
# 1. 记忆库在上层显式启用后才会初始化向量模型。
# 2. 文本与图像向量默认使用 tongyi-embedding-vision-flash-2026-03-06。
# 3. 需要在线向量时，请配置 NUWAX_MEMORY_EMBEDDING_API_KEY 或 DASHSCOPE_API_KEY。
# 4. 如果 API Key 留空，运行时会使用 hashing 文本向量并关闭图像向量链路，同时在日志中给出提示。
# 5. 如果使用本地模型目录，可把 TEXT/IMAGE 模型名改成项目内路径，例如 runtime_data/models/BAAI__bge-m3 与 runtime_data/models/openai__clip-vit-base-patch32。
# 6. 如需提前准备本地模型，请运行 scripts/prepare_memory_models.py。
NUWAX_ARTIFACT_RETENTION_DAYS=7
NUWAX_ARTIFACT_MAX_COUNT=1000
NUWAX_ARTIFACT_MAX_TOTAL_BYTES=1073741824
NUWAX_ARTIFACT_CLEANUP_BATCH_SIZE=200

# -------------------------
# 感知与视觉识别配置
# 说明：
# 1. 仓库不内置 YOLO-World 权重，请先按部署文档准备到 runtime_data/models/。
# 2. 本地检测默认优先使用 YOLO-World + ByteTrack，负责开放词汇检测与跨帧跟踪。
# 3. 如需切换别的本地检测器，继续通过 DetectorBackend 扩展即可。
# 4. 云端语义识别统一走 OpenAI SDK 接口风格，适合对接 OpenAI 及同类服务。
# 5. 默认主线不是“每帧重检测”，而是“关键帧驱动 + 到点 burst 复核”。
# -------------------------
NUWAX_PERCEPTION_DEFAULT_DETECTOR_BACKEND=yolo_world
NUWAX_PERCEPTION_DEFAULT_SCENE_BACKEND=hybrid_scene

NUWAX_PERCEPTION_YOLO_WORLD_ENABLED=true
NUWAX_PERCEPTION_YOLO_WORLD_BACKEND_NAME=yolo_world
# 模型文件后缀即推理链路：.pt → PyTorch(YOLOWorld 开放词汇)；.engine → TensorRT(YOLO，类别固化)
NUWAX_PERCEPTION_YOLO_WORLD_MODEL=/home/unitree/nuwax-robot-bridge/runtime_data/models/yolov8s-worldv2.pt
NUWAX_PERCEPTION_YOLO_WORLD_DEVICE=0
NUWAX_PERCEPTION_YOLO_WORLD_IMAGE_SIZE=640
NUWAX_PERCEPTION_YOLO_WORLD_CONFIDENCE=0.25
NUWAX_PERCEPTION_YOLO_WORLD_IOU=0.45
NUWAX_PERCEPTION_YOLO_WORLD_MAX_DETECTIONS=100
NUWAX_PERCEPTION_YOLO_WORLD_CLASSES=person,door,chair,table,shelf,cabinet,box,bag,backpack,bottle,cup,bench,stairs,charger,dock,traffic cone,fire hydrant
NUWAX_PERCEPTION_YOLO_WORLD_DYNAMIC_CLASS_KEYS=target_classes,open_vocabulary_classes
NUWAX_PERCEPTION_TRACKER_BACKEND=bytetrack
# YOLO-World 动态类别别名（CSV，默认空；settings.py:779）
NUWAX_PERCEPTION_YOLO_WORLD_ALIASES=

# ByteTrack 跟踪器参数（settings.py:784-789）
NUWAX_PERCEPTION_BYTETRACK_NAME=go2_bytetrack_tracker
NUWAX_PERCEPTION_BYTETRACK_HIGH_THRESHOLD=0.5
NUWAX_PERCEPTION_BYTETRACK_LOW_THRESHOLD=0.1
NUWAX_PERCEPTION_BYTETRACK_IOU=0.3
NUWAX_PERCEPTION_BYTETRACK_LOST_TTL_FRAMES=30
NUWAX_PERCEPTION_BYTETRACK_TRAJECTORY_LIMIT=12

# 实例分割（默认整体关闭；settings.py:753-847）
NUWAX_PERCEPTION_DEFAULT_SEGMENTATION_BACKEND=segmentation_disabled
NUWAX_PERCEPTION_SEGMENTATION_ENABLED=false
NUWAX_PERCEPTION_SEGMENTATION_BACKEND_NAME=
NUWAX_PERCEPTION_SEGMENTATION_BACKEND_KIND=disabled_segmentation
NUWAX_PERCEPTION_SEGMENTATION_ROUTE=primary
NUWAX_PERCEPTION_SEGMENTATION_PRIMARY_BACKEND_NAME=groundingdino_sam2
NUWAX_PERCEPTION_SEGMENTATION_LOW_LATENCY_BACKEND_NAME=yolo_world_sam2
NUWAX_PERCEPTION_SEGMENTATION_ALLOW_BBOX_ONLY_FALLBACK=true
NUWAX_PERCEPTION_SEGMENTATION_SCORE_THRESHOLD=0.5
NUWAX_PERCEPTION_SEGMENTATION_PREDICTED_IOU_THRESHOLD=0.5
NUWAX_PERCEPTION_SEGMENTATION_STABILITY_SCORE_THRESHOLD=0.5
NUWAX_PERCEPTION_SEGMENTATION_DEPTH_COVERAGE_THRESHOLD=0.2
NUWAX_PERCEPTION_SEGMENTATION_MAP_PROJECTION_COVERAGE_THRESHOLD=0.2
NUWAX_PERCEPTION_SEGMENTATION_REPROJECTION_ERROR_THRESHOLD_PX=8.0
NUWAX_PERCEPTION_SEGMENTATION_EMIT_RAW_MASK=false
NUWAX_PERCEPTION_SEGMENTATION_EMIT_POLYGON=true
NUWAX_PERCEPTION_SEGMENTATION_EMIT_QUALITY_DETAILS=true
NUWAX_PERCEPTION_SEGMENTATION_EMIT_RUNTIME_SUMMARY=true
NUWAX_PERCEPTION_SEGMENTATION_POLYGON_SIMPLIFICATION_EPSILON_PX=2.0

NUWAX_PERCEPTION_OPENAI_ENABLED=false
NUWAX_PERCEPTION_OPENAI_BACKEND_NAME=openai_vision
NUWAX_PERCEPTION_OPENAI_BASE_URL=https://api.openai.com/v1
NUWAX_PERCEPTION_OPENAI_API_KEY=
NUWAX_PERCEPTION_OPENAI_MODEL=
NUWAX_PERCEPTION_OPENAI_API_STYLE=auto
NUWAX_PERCEPTION_OPENAI_TIMEOUT_SEC=20.0
NUWAX_PERCEPTION_OPENAI_MAX_TOKENS=1400
NUWAX_PERCEPTION_OPENAI_TEMPERATURE=0.0

# 持续视频感知运行时
NUWAX_PERCEPTION_STREAM_ENABLED=true
NUWAX_PERCEPTION_STREAM_AUTO_START=false
NUWAX_PERCEPTION_STREAM_CAMERA_ID=front_camera
NUWAX_PERCEPTION_STREAM_INTERVAL_SEC=0.5
NUWAX_PERCEPTION_STREAM_DETECTOR_BACKEND=
NUWAX_PERCEPTION_STREAM_STORE_ARTIFACT=false
NUWAX_PERCEPTION_STREAM_FAILURE_BACKOFF_SEC=2.0

# Go2 端侧主动视频推流（由 scripts/start_gateway.sh 在 Go2 场景拉起）
# 说明：平台只开放 /streams/video.ingest 接收端侧推流，监控页 /streams/video.mjpeg 只转发已接收的视频帧。
GO2_VIDEO_STREAM_ENABLED=true
GO2_VIDEO_STREAM_GATEWAY_URL=ws://127.0.0.1:8766/streams/video.ingest
GO2_VIDEO_STREAM_ACCESS_TOKEN=agent-robot-bridge-token
GO2_VIDEO_STREAM_FPS=15
GO2_VIDEO_STREAM_CAMERA_ID=front_camera
GO2_VIDEO_STREAM_FRAME_ID=go2/front_camera
GO2_VIDEO_STREAM_WIDTH_PX=1280
GO2_VIDEO_STREAM_HEIGHT_PX=720
GO2_VIDEO_STREAM_RECONNECT_SEC=1.0

# 关键帧策略
NUWAX_PERCEPTION_KEYFRAME_MIN_INTERVAL_SEC=1.0
NUWAX_PERCEPTION_KEYFRAME_TRANSLATION_M=0.75
NUWAX_PERCEPTION_KEYFRAME_YAW_DEG=20.0
# 说明：
# 1. 当位姿、朝向和区域锚点几乎不变时，运行时会持续抑制关键帧，不会重复打云端 API
# 2. 一旦产生关键帧即立即写入记忆，不再有独立的记忆写入间隔限制
NUWAX_PERCEPTION_KEYFRAME_REMEMBER_ENABLED=true

# 到点 burst 复核
NUWAX_PERCEPTION_BURST_FRAME_COUNT=4
NUWAX_PERCEPTION_BURST_INTERVAL_SEC=0.08

# -------------------------
# 延迟投影（多观测聚合定位）
# 说明：YOLO-World 2D 检测瞬间 bbox 常无激光点覆盖 → 实时投影退化为机器人位姿(误差几米)。
# 延迟投影用多观测累积求更准坐标。单轴策略(消除无意义组合)：
#   disabled            ：仅现有实时点云链(默认，=现状，向后兼容)
#   triangulation       ：多视角射线三角化(L2 主推，不等点云，置信≤0.7)
#   delayed_pointcloud  ：延迟点云重投影(等累积点云稠密，锥内取点，置信0.85)
#   triangulation_first ：三角化即时 + 点云累积后 cross-validation(求更高精度)
# -------------------------
NUWAX_PERCEPTION_DEFERRED_STRATEGY=disabled
# 射线三角化参数
NUWAX_PERCEPTION_TRIANGULATION_MIN_RAYS=2
NUWAX_PERCEPTION_TRIANGULATION_MIN_PARALLAX_DEG=5.0
NUWAX_PERCEPTION_TRIANGULATION_MAX_RESIDUAL_M=0.5
# 延迟点云重投影参数
NUWAX_PERCEPTION_DELAYED_PC_MIN_POINTS=5
NUWAX_PERCEPTION_DELAYED_PC_MAX_RETRY=3
NUWAX_PERCEPTION_DELAYED_PC_MAX_RANGE_M=8.0
NUWAX_PERCEPTION_DELAYED_PC_REFINE_INTERVAL_SEC=6.0
NUWAX_PERCEPTION_DELAYED_PC_MAX_CONCURRENCY=2
# triangulation_first cross-validation 阈值(三角化与点云坐标分歧>此值则降置信)
NUWAX_PERCEPTION_DEFERRED_XVAL_THRESHOLD_M=0.3

# -------------------------
# DDS 与 SDK 配置
# 说明：
# 1. 平台层只保留通用 DDS 实现选择与 CycloneDDS URI。
# 2. Go2 端侧专属变量（GO2_DDS_IFACE / GO2_SDK_PATH / GO2_ROBOT_IP / GO2_LOW_LEVEL_*）
#    现统一在 drivers/go2/data_plane.env 维护，不在根 .env 暴露。
# 注：CYCLONEDDS_URI 已不再被 settings.py 解析为字段，由 scripts/start_gateway.sh
#    与 services/geometry 侧脚本直接读取并导出，保留此键仅供这些脚本消费。
# -------------------------
CYCLONEDDS_URI=<CycloneDDS><Domain><Compatibility><StandardsConformance>lax</StandardsConformance></Compatibility></Domain></CycloneDDS>

# 机器人地址别名
# 说明：
# 1. TTS 播放链路优先读取 TTS_PLAYER_ROBOT_IP。
# 2. 平台层只暴露通用 ROBOT_IP；Go2 专属 GO2_ROBOT_IP 在 drivers/go2/data_plane.env 维护。
ROBOT_IP=

# ===================================================================
# TTS / 豆包 / 日志转语音配置（实时语音已下线，仅余兼容/展示用途）
# 说明：实时语音（豆包 WebRTC TTS）与 Go2 机身扬声器 WebRTC 音频通道已随
#       tts/ 包一并删除，AudioService 现固定走 record_only 记录模式。
#       下方 DOUBAO_* / TTS_PLAYER_* / TTS_LOG_BRIDGE_* 三块的真实消费仅剩：
#         1) TTS_PLAYER_VOLUME → tts.initial_volume（AudioService 软件音量初值）；
#         2) TTS_LOG_BRIDGE_LOG_PATH → debug panel 展示日志路径；
#         3) DOUBAO_* 默认值在 core/settings.py 内部级联组装 log_tts 默认值。
#       其余字段保留形态以免破坏既有 .env 部署与配置级联，无运行时音频后端消费。
# ===================================================================

# -------------------------
# 豆包鉴权配置（仅级联为 log_tts 默认值，无实时 TTS 后端消费）
# -------------------------
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=
DOUBAO_RESOURCE_ID=seed-tts-1.0
DOUBAO_DEFAULT_SPEAKER=zh_female_sajiaonvyou_moon_bigtts
DOUBAO_DEFAULT_UID=nuwax_robot_bridge-tts
DOUBAO_DEFAULT_MODEL=
DOUBAO_DEFAULT_AUDIO_FORMAT=pcm
DOUBAO_DEFAULT_SAMPLE_RATE=24000
DOUBAO_REQUEST_USAGE_TOKENS=true
DOUBAO_SEND_APP_ID_HEADER=false
DOUBAO_SEND_APP_KEY_HEADER=true

# -------------------------
# TTS 播放器运行配置（仅 TTS_PLAYER_VOLUME 被音量服务消费）
# -------------------------
TTS_PLAYER_AUTO_START=true
TTS_PLAYER_PRINT_SUBTITLE=false
TTS_PLAYER_VOLUME=1.0

# 播放后端配置
# 注意：robot_webrtc 实时音频后端已随 tts/ 包下线，backend_mode 当前无任何
#       运行时消费方，默认置为 disabled。AudioService 固定走 record_only 记录
#       模式，不再实际播放音频。下方 ALSA / robot_webrtc 链路参数仅保留字段形态。
#   可选历史值（均已无后端实现，仅作兼容记录）：
#     - disabled      : 无音频后端（当前默认，与 record_only 实现一致）
#     - robot_webrtc  : 已下线的 Go2 机身扬声器链路
#     - alsa_local    : 已下线的 Jetson 本地 ALSA/Pulse 链路
TTS_PLAYER_BACKEND_MODE=disabled
TTS_PLAYER_FALLBACK_BACKEND_MODE=alsa_local

# Jetson 本地 ALSA/Pulse 链路配置
TTS_PLAYER_PREFERRED_BACKEND=aplay
TTS_PLAYER_AUDIO_DEVICE=
TTS_PLAYER_ENABLE_SPK_CTL=true
TTS_PLAYER_ENABLE_APE_ROUTE=true
TTS_PLAYER_APE_CARD=APE
TTS_PLAYER_APE_ADMAIF=1
TTS_PLAYER_APE_SPEAKER=DSPK1

# Go2 机身扬声器 WebRTC 链路配置（已下线，无运行时消费，仅保留字段形态）
TTS_PLAYER_ROBOT_IP=
TTS_PLAYER_ROBOT_MODE=ai
TTS_PLAYER_ROBOT_PYTHONPATH=
TTS_PLAYER_USE_MEGAPHONE=true
TTS_PLAYER_STREAMING_ENABLED=false
TTS_PLAYER_STREAMING_CHUNK_MS=200
TTS_PLAYER_ROBOT_CONNECT_TIMEOUT=15.0
TTS_PLAYER_ROBOT_REQUEST_TIMEOUT=20.0
TTS_PLAYER_UPLOAD_CHUNK_SIZE=61440
TTS_PLAYER_MEGAPHONE_CHUNK_SIZE=16384
TTS_PLAYER_SEGMENT_MIN_DURATION_SEC=3.0
TTS_PLAYER_AUTO_FALLBACK_TO_LOCAL=true

# -------------------------
# 日志监听转 TTS 配置（实时 TTS 已下线；当前仅 TTS_LOG_BRIDGE_LOG_PATH 被 debug panel 展示消费）
# 说明：
# 1. 历史用途：监听 nuwaxbot 主日志 agent_message_chunk 并调用 Doubao 实时 TTS。
# 2. 实时 TTS 后端已随 tts/ 包删除，本块除 LOG_PATH 外无运行时音频消费。
# 3. TTS_LOG_BRIDGE_LOG_PATH 仍被 debug panel 用于展示日志文件路径。
# 4. 如果日志文件位于 Docker volume，通常需要 root 或额外放宽权限。
# -------------------------
TTS_LOG_BRIDGE_ENABLED=false
TTS_LOG_BRIDGE_LOG_PATH=/var/lib/docker/volumes/nuwax_home/_data/.nuwaxbot/logs/main.log
TTS_LOG_BRIDGE_REQUIRE_ROOT=true
TTS_LOG_BRIDGE_SPEAKER=
TTS_LOG_BRIDGE_RESOURCE_ID=seed-tts-1.0
TTS_LOG_BRIDGE_UID=nuwax_robot_bridge-tts
TTS_LOG_BRIDGE_MODEL=
TTS_LOG_BRIDGE_AUDIO_FORMAT=pcm
TTS_LOG_BRIDGE_SAMPLE_RATE=24000
TTS_LOG_BRIDGE_SPEECH_RATE=0
TTS_LOG_BRIDGE_LOUDNESS_RATE=0
TTS_LOG_BRIDGE_EMOTION=
TTS_LOG_BRIDGE_EMOTION_SCALE=4
TTS_LOG_BRIDGE_ENABLE_SUBTITLE=false
TTS_LOG_BRIDGE_ENABLE_TIMESTAMP=false
TTS_LOG_BRIDGE_DISABLE_MARKDOWN_FILTER=true
TTS_LOG_BRIDGE_SILENCE_DURATION_MS=0
TTS_LOG_BRIDGE_INTERRUPT=true
TTS_LOG_BRIDGE_EXPLICIT_LANGUAGE=zh
TTS_LOG_BRIDGE_START_FROM_END=true
TTS_LOG_BRIDGE_POLL_INTERVAL_SEC=0.2
TTS_LOG_BRIDGE_QUIET_PERIOD_SEC=1.5
TTS_LOG_BRIDGE_FLUSH_INTERVAL_SEC=0.35
TTS_LOG_BRIDGE_STREAM_MIN_CHARS=8
TTS_LOG_BRIDGE_MIN_TEXT_LENGTH=2
TTS_LOG_BRIDGE_REQUEST_TIMEOUT_SEC=15.0
TTS_LOG_BRIDGE_START_RETRY_BACKOFF_SEC=2.0
TTS_LOG_BRIDGE_MAX_START_FAILURES_PER_TURN=3

# -------------------------
# 音量控制配置
# 说明：
# 1. Go2 端侧 VUI 与本地混音器变量（GO2_VOLUME_* / GO2_VUI_* / GO2_INIT_VOLUME_ON_START / GO2_AUDIO_COMMAND_TIMEOUT）
#    现统一在 drivers/go2/data_plane.env 维护，不在根 .env 暴露。
# -------------------------

# -------------------------
# geometry 子进程/侧车散读键（当前由 services/geometry 侧直接 os.environ 读取，
# settings.py 尚未收编——属 P1-4 待办；在此列出仅为文档化与新部署可配，
# 收编完成后将改由 settings 统一注入。默认值取自各读取点实测）
# 说明：split-brain 注意——cloud_map 首选名是上方 NUWAX_GEOMETRY_CLOUD_MAP_TOPIC；
#       PCD 导出链（cloud_map_fetcher.py:23）当前只读 legacy NUWAX_CLOUD_MAP_TOPIC。
# -------------------------
# 视频共享内存 / Unix socket 路径（gateways/ws/data_streams.py、ros_bridge_client.py:73-74）
NUWAX_VIDEO_SHM_PATH=/tmp/nuwax_video.shm
NUWAX_VIDEO_UDS_PATH=/tmp/nuwax_video.sock
# 外部几何栈 plan 话题（external_debug_observer.py:105,484）
NUWAX_GEOMETRY_PLAN_TOPIC=/plan
# PCD 导出参数（cloud_map_fetcher.py:23-48）
NUWAX_PCD_MIN_POINTS=500
NUWAX_CLOUD_MAP_FETCH_TIMEOUT_SEC=5.0
NUWAX_PCD_DB_EXPORT_TIMEOUT_SEC=45
NUWAX_PCD_EXPORT_FROM_DB=true
# Rust 桥环境脚本（ros_bridge_client.py:272；留空走默认推导）
NUWAX_ROS_BRIDGE_ENV_SCRIPT=
# 后端数据库绝对路径（runtime.py:565；留空则由 DATABASE_ROOT 推导）
NUWAX_BACKEND_DATABASE_PATH=
