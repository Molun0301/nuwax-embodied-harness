[Unit]
Description=NuwaX motion safety guard (sole unitree_sdk2py motion owner)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=nuwax-motion-guard
Group=nuwax-motion-guard
SupplementaryGroups=nuwax-motion-clients
WorkingDirectory=/home/unitree/nuwax-robot-bridge
RuntimeDirectory=nuwax
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
StateDirectory=nuwax/motion-guard
StateDirectoryMode=0700
UMask=0007
EnvironmentFile=-/home/unitree/nuwax-robot-bridge/.env
EnvironmentFile=-/home/unitree/nuwax-robot-bridge/drivers/go2/data_plane.env
Environment=PYTHONPATH=/home/unitree/nuwax-robot-bridge
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONNOUSERSITE=1
Environment=GO2_SDK_PATH=/home/unitree/unitree_sdk2_python
Environment=NUWAX_MOTION_GUARD_BACKEND=unitree_sdk2py
Environment=NUWAX_MOTION_GUARD_SOCKET=/run/nuwax/motion-guard.sock
Environment=NUWAX_MOTION_GUARD_LOCK=/run/nuwax/motion-guard.lock
Environment=NUWAX_MOTION_GUARD_EPOCH=/var/lib/nuwax/motion-guard/epoch.json
Environment=NUWAX_MOTION_GUARD_PROVISIONED=/var/lib/nuwax/motion-guard/provisioned.json
Environment=NUWAX_ACTUATOR_SYMBOLS_FILE=/usr/share/nuwax/actuator-symbols.json
Environment=NUWAX_MOTION_GUARD_START_TIMEOUT_SEC=15
ExecStartPre=/usr/bin/chgrp nuwax-motion-clients /run/nuwax
ExecStartPre=/usr/bin/chmod 0750 /run/nuwax
ExecStartPre=/bin/bash /home/unitree/nuwax-robot-bridge/scripts/systemd/check_motion_guard_python.sh
ExecStartPre=/usr/bin/test -r /var/lib/nuwax/motion-guard/provisioned.json
ExecStartPre=/usr/bin/test -r /var/lib/nuwax/motion-guard/epoch.json
ExecStartPre=/usr/bin/rm -f /run/nuwax/motion-guard.sock
ExecStart=/usr/bin/python3 -m services.navigation.motion_safety_guard
ExecStartPost=/bin/bash /home/unitree/nuwax-robot-bridge/scripts/systemd/wait_for_motion_guard_socket.sh wait
ExecStopPost=/usr/bin/rm -f /run/nuwax/motion-guard.sock
Restart=on-failure
RestartSec=1
TimeoutStartSec=30
TimeoutStopSec=5
KillMode=mixed
SuccessExitStatus=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/nuwax /var/lib/nuwax/motion-guard

[Install]
WantedBy=multi-user.target
