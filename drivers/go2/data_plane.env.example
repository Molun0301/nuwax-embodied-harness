# =========================
# Go2 设备侧数据面配置示例
# 说明：
# 1. 这部分配置专属于 Go2 设备侧输入流、运动执行和避障控制。
# 2. 配置解析逻辑位于 drivers/go2/settings.py。
# 3. 推荐实际部署时复制为 drivers/go2/data_plane.env。
# 4. 环境变量优先级最高，其次是 drivers/go2/data_plane.env。
# 5. 平台 geometry 主配置位于项目根目录 .env 的 NUWAX_* 配置域。
# =========================

# 是否启用 Go2 设备侧数据面
GO2_DATA_PLANE_ENABLED=false
GO2_CYCLONEDDS_LIB_DIR=
GO2_SDK_PATH=
GO2_DATA_PLANE_DDS_IFACE=eth0

# -------------------------
# Go2 官方 DDS 直连
# 说明：
# 1. 位姿和激光雷达点云直接从宇树官方 DDS 读取。
# 2. 本链路只作为设备原始输入，不在 Go2 端合成地图或执行定位导航。
# 3. 前置视频源端侧采用 unitree VideoClient（service name="videohub"）拉取 JPEG，
#    再由 Go2 driver 在端侧打包成持续推流；平台层只通过 StreamingImageProvider 协议消费推流。
# -------------------------
GO2_DIRECT_DDS_ENABLED=true
GO2_DIRECT_DDS_POSE_TOPIC=rt/sportmodestate
GO2_DIRECT_DDS_LOW_STATE_TOPIC=rt/lowstate
GO2_DIRECT_DDS_POINT_CLOUD_TOPIC=rt/utlidar/cloud
GO2_DIRECT_DDS_READ_TIMEOUT_SEC=0.5
GO2_DIRECT_DDS_MAX_POINTS_PER_SCAN=1200
GO2_VIDEO_PULL_INTERVAL_SEC=0.033

# -------------------------
# Go2 官方运动控制与避障
# 说明：
# 1. Go2 侧只保留 sport / obstacles_avoid 运动执行链。
# 2. 地图、定位、导航和探索主链统一由平台侧 services 运行时承载。
# -------------------------
GO2_OFFICIAL_BACKEND_ENABLED=true
GO2_OFFICIAL_SERVICES_AUTO_START=false
GO2_OFFICIAL_SERVICE_NAMES=obstacles_avoid
GO2_OFFICIAL_CLIENT_TIMEOUT_SEC=3.0
GO2_OFFICIAL_MAX_LINEAR_VELOCITY_MPS=0.35
GO2_OFFICIAL_MAX_YAW_RATE_RPS=0.8
GO2_OFFICIAL_OBSTACLE_AVOIDANCE_DEFAULT_ENABLED=false

# -------------------------
# Go2 机身音量与本地混音器
# 说明：
# 1. 这组配置专属 Go2 端侧 VUI 与 Jetson 本地 ALSA 混音器，仅 Go2 数据面消费。
# 2. 由 settings.py:625-632 与 tts/robot_webrtc_audio.py 读取。
# 3. 平台层 .env 不再暴露这组变量，统一在此维护。
# -------------------------
GO2_VOLUME_PREFER_VUI=true
GO2_VOLUME_AUTO_ENABLE_VUI_SWITCH=true
GO2_VUI_MIN_LEVEL=0
GO2_VUI_MAX_LEVEL=10
GO2_INIT_VOLUME_ON_START=false
GO2_VOLUME_MIXER_DEVICE=default
GO2_VOLUME_MIXER_CONTROL=
GO2_AUDIO_COMMAND_TIMEOUT=1.0
