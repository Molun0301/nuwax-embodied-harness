[Unit]
Description=NuwaX on-demand runtime component activation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ProtectHome=read-only
WorkingDirectory=@NUWAX_REPO_ROOT@
Environment=NUWAX_RUNTIME_ACTIVATION_REQUEST=/run/nuwax/gateway/geometry.request
Environment=NUWAX_RUNTIME_ACTIVATION_RESULT=/run/nuwax/gateway/geometry.result.json
Environment=NUWAX_MOTION_GUARD_SOCKET=/run/nuwax/motion-guard.sock
Environment=NUWAX_NAV_STACK_READY_FILE=/run/nuwax/navigation/nuwax_nav_stack.ready
Environment=NUWAX_GEOMETRY_RUNTIME_READY_FILE=/run/nuwax/geometry/nuwax_geometry_runtime.ready
Environment=NUWAX_GEOMETRY_RUNTIME_BINARY=@NUWAX_REPO_ROOT@/services/geometry/nuwax_geometry_runtime/target/release/nuwax-geometry-runtime
Environment=NUWAX_GEOMETRY_RUNTIME_PORT=50051
Environment=NUWAX_PERSON_FOLLOW_READY_FILE=/run/nuwax/person-follow/nuwax_person_follow.ready
ExecStart=/usr/bin/env NUWAX_REPO_ROOT=@NUWAX_REPO_ROOT@ NUWAX_GEOMETRY_RUNTIME_BINARY=@NUWAX_REPO_ROOT@/services/geometry/nuwax_geometry_runtime/target/release/nuwax-geometry-runtime /bin/bash @NUWAX_REPO_ROOT@/scripts/systemd/activate_geometry_runtime.sh
TimeoutStartSec=90
