# Nuwax 机器人平台设置示例。复制后仅修改需要覆盖的设置。
# 设置名称、键名、默认值与生效范围可在机器人控制台查看。
# 环境变量优先于文件；修改后重启对应服务。


# 机器人与运行入口
# 当前激活机器人
NUWAX_ACTIVE_ROBOT=customrobot

# 机器人外形：手填逐轴优先；留空使用模型或驱动默认。
# 机器人外形模型路径
NUWAX_ROBOT_MODEL_PATH=
# 模型机体基准连杆
NUWAX_ROBOT_MODEL_BASE_LINK=
# 模型静态参考关节位置
NUWAX_ROBOT_MODEL_JOINT_POSITIONS_JSON=
# 机器人外包长度（米）
NUWAX_ROBOT_LENGTH_M=
# 机器人外包宽度（米）
NUWAX_ROBOT_WIDTH_M=
# 机器人外包高度（米）
NUWAX_ROBOT_HEIGHT_M=
# 外包中心X偏移（米）
NUWAX_ROBOT_CENTER_X_M=
# 外包中心Y偏移（米）
NUWAX_ROBOT_CENTER_Y_M=
# 外包中心Z偏移（米）
NUWAX_ROBOT_CENTER_Z_M=
# 低级控制周期（秒）
GO2_LOW_LEVEL_INTERVAL_SEC=0.002
# 低级控制 KD 增益
GO2_LOW_LEVEL_KD=5.0
# 低级控制 KP 增益
GO2_LOW_LEVEL_KP=60.0
# 低级控制最大扭矩
GO2_LOW_LEVEL_MAX_TORQUE=10.0
# 低级控制最大速度
GO2_LOW_LEVEL_MAX_VELOCITY=2.0
# Go2 SDK 路径
GO2_SDK_PATH=/home/unitree/unitree_sdk2_python
# 自动开启 Go2 VUI 音量开关
GO2_VOLUME_AUTO_ENABLE_VUI_SWITCH=true
# Go2 VUI 最大音量级别
GO2_VUI_MAX_LEVEL=10
# Go2 VUI 最小音量级别
GO2_VUI_MIN_LEVEL=0
# 标准运动提供者工厂
NUWAX_MOTION_CONTROL_FACTORY=
# 运动控制后端
NUWAX_MOTION_GUARD_BACKEND=
# 运动控制通信套接字
NUWAX_MOTION_GUARD_SOCKET=/run/nuwax/motion-guard.sock
# 运动控制启动等待时间（秒）
NUWAX_MOTION_GUARD_START_TIMEOUT_SEC=15

# 网关与服务
# 网关监听地址
NUWAX_GATEWAY_HOST=0.0.0.0
# 3D 点云基础颜色
NUWAX_GATEWAY_POINTCLOUD3D_COLOR="#cbd5e1"
# 3D 点云点大小
NUWAX_GATEWAY_POINTCLOUD3D_SIZE=1.35
# 3D 点云显示间隔（米）
NUWAX_GATEWAY_POINTCLOUD3D_SPACING_M=0.1
# 网关端口
NUWAX_GATEWAY_PORT=8766
# 网关制品目录
NUWAX_GATEWAY_ARTIFACT_DIR=artifacts
# 网关退出补充等待时间（秒）
NUWAX_GATEWAY_KILL_TIMEOUT_SEC=5
# 3D 点云地面颜色
NUWAX_GATEWAY_POINTCLOUD3D_GROUND_COLOR="#38bdf8"
# 3D 点云高度渐变颜色
NUWAX_GATEWAY_POINTCLOUD3D_HEIGHT_COLORS="#38bdf8,#22d3ee,#4ade80,#facc15,#fb7185"
# 3D 点云物体颜色
NUWAX_GATEWAY_POINTCLOUD3D_OBJECT_COLOR="#fbbf24"
# 3D 点云结构颜色
NUWAX_GATEWAY_POINTCLOUD3D_STRUCTURE_COLOR="#f8fafc"
# 网关公开访问地址
NUWAX_GATEWAY_PUBLIC_BASE_URL=http://host.docker.internal:8766
# 网关自动重启策略
NUWAX_GATEWAY_RESTART=on-failure
# 网关重启次数上限（零为不限）
NUWAX_GATEWAY_RESTART_MAX_ATTEMPTS=0
# 网关重启间隔（秒）
NUWAX_GATEWAY_RESTART_SEC=3
# 网关 SSE 保活间隔（秒）
NUWAX_GATEWAY_SSE_KEEPALIVE_SEC=10.0
# 网关正常退出等待时间（秒）
NUWAX_GATEWAY_STOP_TIMEOUT_SEC=20
# 网关 WebSocket 心跳间隔（秒）
NUWAX_GATEWAY_WS_PING_INTERVAL_SEC=15.0
# 运行时激活确认等待时间（秒）
NUWAX_RUNTIME_ACTIVATION_ACK_TIMEOUT_SEC=10
# 运行时激活提交等待时间（秒）
NUWAX_RUNTIME_ACTIVATION_COMMIT_TIMEOUT_SEC=10
# 运行时激活等待时间（秒）
NUWAX_RUNTIME_ACTIVATION_TIMEOUT_SEC=95.0

# 性能监控（遥测）
# 启用性能监控
NUWAX_GATEWAY_TELEMETRY_ENABLED=false
# 性能监控采集间隔（秒）
NUWAX_GATEWAY_TELEMETRY_INTERVAL_SEC=2.0
# 纳入网关进程树
NUWAX_GATEWAY_TELEMETRY_INCLUDE_PROCESS_TREE=true
# 遥测进程匹配关键词
NUWAX_GATEWAY_TELEMETRY_PROCESS_KEYWORDS=gateway,nuwax-geometry-runtime,nuwax-nav-stack,nuwax-lcm-runtime,nuwax-go2-video-streamer

# 日志
# 日志级别
NUWAX_LOG_LEVEL=INFO
# 保留的历史日志文件数
NUWAX_LOG_BACKUP_COUNT=5
# 所有组件共用日志目录；开发默认放在项目 runtime_data/logs
NUWAX_LOG_DIR=runtime_data/logs
# 项目日志文件
NUWAX_LOG_FILE=runtime_data/logs/nuwax_robot_bridge.log
# 终端日志格式
NUWAX_LOG_FORMAT=text
# 配置读写日志级别（空为继承）
NUWAX_LOG_LEVEL_CONFIG=
# 机器人驱动日志级别（空为继承）
NUWAX_LOG_LEVEL_DRIVER=
# 网关日志级别（空为继承）
NUWAX_LOG_LEVEL_GATEWAY=
# 几何日志级别（空为继承）
NUWAX_LOG_LEVEL_GEOMETRY=
# 导航日志级别（空为继承）
NUWAX_LOG_LEVEL_NAVIGATION=
# 感知日志级别（空为继承）
NUWAX_LOG_LEVEL_PERCEPTION=
# 运行时日志级别（空为继承）
NUWAX_LOG_LEVEL_RUNTIME=
# 配置解析日志级别（空为继承）
NUWAX_LOG_LEVEL_SETTINGS=
# 技能日志级别（空为继承）
NUWAX_LOG_LEVEL_SKILLS=
# 单个日志文件容量（字节）
NUWAX_LOG_MAX_BYTES=20971520
# Rust（系统编程语言）运行时日志过滤
RUST_LOG=info

# 几何引擎·运行时与通信
# 探索状态查询间隔（秒）
NUWAX_GEOMETRY_EXPLORATION_POLL_SEC=0.5
# 大地图查询超时（秒）
NUWAX_GEOMETRY_GRPC_HEAVY_DEADLINE_SEC=10.0
# 几何通信最大消息（字节）
NUWAX_GEOMETRY_GRPC_MAX_MESSAGE_BYTES=134217728
# 位姿查询超时（秒）
NUWAX_GEOMETRY_GRPC_POSE_DEADLINE_SEC=5.0
# 几何查询超时（秒）
NUWAX_GEOMETRY_GRPC_READ_DEADLINE_SEC=2.0
# 几何数据流最大重连间隔（秒）
NUWAX_GEOMETRY_GRPC_STREAM_RETRY_MAX_SEC=8.0
# 几何数据流重连间隔（秒）
NUWAX_GEOMETRY_GRPC_STREAM_RETRY_SEC=1.0
# 惯性传感器到机体外参
NUWAX_GEOMETRY_LIO_BODY_FROM_IMU=
# 激光雷达到机体外参
NUWAX_GEOMETRY_LIO_BODY_FROM_SENSOR=
# 原生定位后端程序
NUWAX_GEOMETRY_NATIVE_LIO_EXECUTABLE=
# 原生定位首对数据等待时间（毫秒）
NUWAX_GEOMETRY_NATIVE_LIO_FIRST_PAIR_TIMEOUT_MS=10000
# 原生定位点云与惯性最大时间差（毫秒）
NUWAX_GEOMETRY_NATIVE_LIO_PAIR_MAX_SKEW_MS=100
# 原生定位扫描下采样体素边长（米）；留空保留后端默认，重启几何及原生定位进程生效
NUWAX_GEOMETRY_LIO_SCAN_VOXEL_SIZE_M=
# 原生定位地图插入筛选体素边长（米）；不是Point索引格或平台地图体素，留空保留默认
NUWAX_GEOMETRY_LIO_MAP_VOXEL_SIZE_M=
# 初图最少有效扫描数（帧）；留空保留原生默认，Point多帧积累要求静止初始化
# 停止建图不会重新初始化；修改后须重启几何运行时及其原生定位进程
NUWAX_GEOMETRY_LIO_INITIAL_MAP_FRAMES=
# 可选几何发布清单
NUWAX_GEOMETRY_RELEASE_MANIFEST=
# 原生位姿图优化程序
NUWAX_GEOMETRY_RELEASE_NATIVE_PGO_EXECUTABLE=
# 连接运行时健康检查超时（秒）
NUWAX_GEOMETRY_RUNTIME_ATTACH_HEALTH_TIMEOUT_SEC=2.0
# nuwax-geometry-runtime 二进制路径
NUWAX_GEOMETRY_RUNTIME_BINARY=services/geometry/nuwax_geometry_runtime/target/release/nuwax-geometry-runtime
# nuwax-geometry-runtime 健康超时（秒）
NUWAX_GEOMETRY_RUNTIME_HEALTH_TIMEOUT=30
# nuwax-geometry-runtime 日志名
NUWAX_GEOMETRY_RUNTIME_LOG_NAME=nuwax_geometry_runtime.log
# nuwax-geometry-runtime gRPC 端口
NUWAX_GEOMETRY_RUNTIME_PORT=50051
# nuwax-geometry-runtime 进程名
NUWAX_GEOMETRY_RUNTIME_PROCESS_NAME=nuwax-geometry-runtime
# nuwax-geometry-runtime ready 文件
NUWAX_GEOMETRY_RUNTIME_READY_FILE=runtime_data/geometry/nuwax_geometry_runtime.ready

# 几何引擎·话题与坐标系
# 位姿校正后端
NUWAX_GEOMETRY_CORRECTION_BACKEND=none
# 启用几何引擎
NUWAX_GEOMETRY_ENABLED=true
# 启用 nuwax-geometry-runtime
NUWAX_GEOMETRY_EXTERNAL_ENABLED=true
# LIO（激光雷达惯性里程计）后端
# 执行链：lio_3d为三维激光惯性链，slam_2d为二维完整图链，修改后重启。
NUWAX_GEOMETRY_PIPELINE=lio_3d
# 二维配置必须提供实际传感器、平面外参、时钟及里程计来源；单调时钟可用local_boot捕获本次启动身份。
NUWAX_GEOMETRY_SLAM2D_CONFIG=
NUWAX_GEOMETRY_SLAM2D_DEVICE=
NUWAX_GEOMETRY_SLAM2D_BINARY=
NUWAX_GEOMETRY_LIO_BACKEND=device
# 建图后端
NUWAX_GEOMETRY_MAPPING_BACKEND=voxel
# 机器人基座坐标系
NUWAX_BASE_FRAME=base_link
# 点云地图话题
NUWAX_GEOMETRY_CLOUD_MAP_TOPIC=/cloud_map
# 代价地图话题
NUWAX_GEOMETRY_COST_MAP_TOPIC=/nav/costmap
# IMU 坐标系
NUWAX_GEOMETRY_IMU_FRAME=utlidar_imu
# IMU 话题
NUWAX_GEOMETRY_IMU_TOPIC=/utlidar/imu
# 激光雷达坐标系
NUWAX_GEOMETRY_LIDAR_FRAME=utlidar_lidar
# 可通行性最低评分
NUWAX_GEOMETRY_MIN_TRAVERSABILITY_SCORE=0.5
# 占据栅格话题
NUWAX_GEOMETRY_OCCUPANCY_TOPIC=/map_obstacles
# 里程计坐标系
NUWAX_GEOMETRY_ODOM_FRAME=odom
# 里程计最大允许延迟（秒）
NUWAX_GEOMETRY_ODOM_MAX_AGE_SEC=0.5
# 里程计最大角度协方差
NUWAX_GEOMETRY_ODOM_MAX_ANGULAR_COVARIANCE=1.0
# 里程计最大线性协方差
NUWAX_GEOMETRY_ODOM_MAX_LINEAR_COVARIANCE=1.0
# 里程计质量来源
NUWAX_GEOMETRY_ODOM_QUALITY_SOURCE=topic_covariance
# 要求里程计协方差
NUWAX_GEOMETRY_ODOM_REQUIRE_COVARIANCE=false
# 里程计话题
NUWAX_GEOMETRY_ODOM_TOPIC=/utlidar/robot_odom
# 点云前向裁剪最大距离（米）
NUWAX_GEOMETRY_POINT_CLOUD_CROP_FORWARD_MAX_M=6.0
# 点云前向裁剪最小距离（米）
NUWAX_GEOMETRY_POINT_CLOUD_CROP_FORWARD_MIN_M=-0.5
# 点云横向裁剪半宽（米）
NUWAX_GEOMETRY_POINT_CLOUD_CROP_LATERAL_M=3.0
# 点云高度裁剪上限（米）
NUWAX_GEOMETRY_POINT_CLOUD_CROP_MAX_Z_M=1.6
# 点云高度裁剪下限（米）
NUWAX_GEOMETRY_POINT_CLOUD_CROP_MIN_Z_M=-0.6
# 点云最大允许延迟（秒）
NUWAX_GEOMETRY_POINT_CLOUD_MAX_AGE_SEC=0.5
# 点云单帧最大点数
NUWAX_GEOMETRY_POINT_CLOUD_MAX_POINTS=1200
# 点云最大距离（米）
NUWAX_GEOMETRY_POINT_CLOUD_MAX_RANGE_M=8.0
# 点云最小距离（米）
NUWAX_GEOMETRY_POINT_CLOUD_MIN_RANGE_M=0.15
# 启用点云预处理
NUWAX_GEOMETRY_POINT_CLOUD_PREPROCESS_ENABLED=true
# 点云话题
NUWAX_GEOMETRY_POINT_CLOUD_TOPIC=/utlidar/cloud_deskewed
# 点云体素大小（米）
NUWAX_GEOMETRY_POINT_CLOUD_VOXEL_SIZE_M=0.05
# 几何位姿话题
NUWAX_GEOMETRY_POSE_TOPIC=/go2/pose_map
# 备用里程计话题
NUWAX_GEOMETRY_SECONDARY_ODOM_TOPICS=
# TF 最大允许延迟（秒）
NUWAX_GEOMETRY_TF_MAX_AGE_SEC=0.5
# 静态 TF 话题
NUWAX_GEOMETRY_TF_STATIC_TOPIC=/tf_static
# TF 话题
NUWAX_GEOMETRY_TF_TOPIC=/tf
# 地图坐标系
NUWAX_MAP_FRAME=map

# 几何引擎·点云与质量
# 最大传感器时间偏差（秒）
NUWAX_GEOMETRY_MAX_SENSOR_SKEW_SEC=0.2
# 要求时间戳单调递增
NUWAX_GEOMETRY_TIMESTAMP_REQUIRE_MONOTONIC=true
# 时间戳来源
NUWAX_GEOMETRY_TIMESTAMP_SOURCE=sensor_header
# 启用可通行性过滤
NUWAX_GEOMETRY_TRAVERSABILITY_FILTER_ENABLED=true
# 可通行最大坡度（度）
NUWAX_GEOMETRY_TRAVERSABILITY_MAX_SLOPE_DEG=18.0
# 可通行最大台阶高度（米）
NUWAX_GEOMETRY_TRAVERSABILITY_MAX_STEP_HEIGHT_M=0.15
# 可通行性输出图层
NUWAX_GEOMETRY_TRAVERSABILITY_OUTPUT_LAYER=traversability

# 建图
# 启用 nuwax-mapping 建图
NUWAX_MAPPING_PROFILE_ENABLED=true
# nuwax-mapping 配置名称
NUWAX_MAPPING_PROFILE_NAME=nuwax_geometry_runtime
# Google Maps API 密钥
NUWAX_GOOGLE_MAPS_API_KEY=
# 谷歌地图服务地址
NUWAX_GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api
# nuwax-mapping 代价地图图层
NUWAX_MAPPING_COSTMAP_LAYER=nuwax_global_costmap
# nuwax-mapping crate 名
NUWAX_MAPPING_CRATE=nuwax-mapping
# nuwax-mapping 数据库制品名称
NUWAX_MAPPING_DATABASE_ASSET_NAME=nuwax_mapping_state.db
# nuwax-mapping 数据库目录
NUWAX_MAPPING_DATABASE_ROOT=runtime_data/geometry/mapping
# 使用默认 nuwax-mapping 配置
NUWAX_MAPPING_DEFAULT_PROFILE=true
# 栅格高度（格）
NUWAX_MAPPING_HEIGHT_CELLS=200
# 初始安全半径（米）
NUWAX_MAPPING_INITIAL_SAFE_RADIUS_METERS=0.0
# nuwax-mapping 输入契约
NUWAX_MAPPING_INPUT_CONTRACT=platform_geometry_inputs
# nuwax-mapping 定位状态字段名
NUWAX_MAPPING_LOCALIZATION_STATUS=mapping_localization
# 占据栅格算法
NUWAX_MAPPING_OCCUPANCY_ALGO=height_cost
# nuwax-mapping 占据栅格图层
NUWAX_MAPPING_OCCUPANCY_LAYER=occupancy_grid
# nuwax-mapping 占据投影名称
NUWAX_MAPPING_OCCUPANCY_PROJECTION=projected_occupancy
# 栅格原点 X（米）
NUWAX_MAPPING_ORIGIN_X=-5.0
# 栅格原点 Y（米）
NUWAX_MAPPING_ORIGIN_Y=-5.0
# nuwax-mapping 输出契约
NUWAX_MAPPING_OUTPUT_CONTRACT=map_asset_bundle_geometry_asset
# nuwax-mapping 点云地图制品名称
NUWAX_MAPPING_PCD_ASSET_NAME=cloud_map.pcd
# nuwax-mapping 点云地图目录
NUWAX_MAPPING_PCD_ROOT=runtime_data/geometry/pcd
# 射线建图深度容差（米）
NUWAX_MAPPING_RAYTRACING_GRACE_DEPTH=0.2
# 射线建图掠射角余弦阈值
NUWAX_MAPPING_RAYTRACING_GRAZE_COS=0.7
# 射线建图最高占据证据
NUWAX_MAPPING_RAYTRACING_MAX_HEALTH=1
# 射线建图最大射线距离（米）
NUWAX_MAPPING_RAYTRACING_MAX_RANGE=50.0
# 射线建图最低占据证据
NUWAX_MAPPING_RAYTRACING_MIN_HEALTH=-2
# 射线建图射线采样步长
NUWAX_MAPPING_RAYTRACING_RAY_SUBSAMPLE=1
# 射线建图近期观测窗口（帧）
NUWAX_MAPPING_RAYTRACING_RECENCY_WINDOW=15
# 射线建图遮挡深度（米）
NUWAX_MAPPING_RAYTRACING_SHADOW_DEPTH=0.2
# 射线建图体素大小（米）
NUWAX_MAPPING_RAYTRACING_VOXEL_SIZE=0.1
# nuwax-mapping 重定位诊断字段名
NUWAX_MAPPING_RELOCALIZATION_DIAGNOSTICS=mapping_icp
# 栅格分辨率（米）
NUWAX_MAPPING_RESOLUTION=0.05
# nuwax-mapping 可通行性图层
NUWAX_MAPPING_TRAVERSABILITY_LAYER=traversability
# 建图体素大小（米）
NUWAX_MAPPING_VOXEL_SIZE=0.05
# 栅格宽度（格）
NUWAX_MAPPING_WIDTH_CELLS=200
# Nominatim 检索地址
NUWAX_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# OpenStreetMap 瓦片地址模板
NUWAX_OSM_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# OpenStreetMap 请求 User-Agent
NUWAX_OSM_USER_AGENT=nuwax-mapping-cloud/0.1
# 保存点云地图的最少点数
NUWAX_PCD_MIN_POINTS=500

# 导航与探索
# 探索任务选择策略
NUWAX_EXPLORE_ARBITRATION=prefer_wavefront
# 探索结束保存等待时间（秒）
NUWAX_EXPLORE_FINALIZE_DELAY_SEC=8.0
# 探索位姿有效时间（毫秒）
NUWAX_EXPLORE_POSE_TTL_MS=1000
# 探索调度间隔（毫秒）
NUWAX_EXPLORE_SCHEDULER_PERIOD_MS=200
# 禁行区文件读取间隔（毫秒）
NUWAX_FORBIDDEN_ZONES_POLL_INTERVAL_MS=250
# 三维表面规划超时（毫秒）
NUWAX_MLS_PLANNING_TIMEOUT_MS=5000
# 导航动作命名空间
NUWAX_NAV_ACTION_NAMESPACE=/navigate_to_pose
# 自动启动导航后端
NUWAX_NAV_AUTOSTART=true
# 导航适配器取消通道
NUWAX_NAV_CANCEL_CHANNEL=/nav/cancel
# 导航取消等待时间（毫秒）
NUWAX_NAV_CANCEL_TIMEOUT_MS=5000
# 导航适配器代价地图通道
NUWAX_NAV_COSTMAP_CHANNEL=/nav/costmap
# 导航代价地图来源
NUWAX_NAV_COSTMAP_SOURCE=nuwax_global_costmap
# 启用建图数据库闭环回退
NUWAX_NAV_DB_SQLITE_FALLBACK_ENABLED=true
# 导航适配器目标通道
NUWAX_NAV_GOAL_CHANNEL=/nav/goal
# 闭环判据轮询间隔（秒）
NUWAX_NAV_LOOP_CLOSURE_POLL_INTERVAL_SEC=5.0
# 闭环判据计数阈值
NUWAX_NAV_LOOP_CLOSURE_THRESHOLD=3
# 运动执行端有效时间（毫秒）
NUWAX_NAV_MOTION_SINK_TTL_MS=1000
# 规划输入有效时间（毫秒）
NUWAX_NAV_PLANNER_INPUT_TTL_MS=2000
# 导航规划方案
NUWAX_NAV_PROFILE=simple-2d
# 导航后端程序
NUWAX_NAV_STACK_BINARY=
# 导航栈 ready 文件
NUWAX_NAV_STACK_READY_FILE=runtime_data/navigation/nuwax_nav_stack.ready
# 导航栈启动超时（秒）
NUWAX_NAV_STACK_START_TIMEOUT_SEC=15
# 导航状态有效时间（毫秒）
NUWAX_NAV_STACK_STATE_TTL_MS=2000
# 导航订阅准备检查次数
NUWAX_NAV_STACK_WARMUP_STEPS=150
# 导航适配器状态通道
NUWAX_NAV_STATE_CHANNEL=/nav/state
# 导航坐标变换有效时间（毫秒）
NUWAX_NAV_TF_TTL_MS=2000
# 自动启动 person-follow
NUWAX_PERSON_FOLLOW_AUTOSTART=true
# 人物跟随后端程序
NUWAX_PERSON_FOLLOW_BINARY=
# 人物跟随速度请求通道
NUWAX_PERSON_FOLLOW_COMMAND_CHANNEL=/gateway/person_follow_cmd_vel
# 人物跟随健康检查间隔（秒）
NUWAX_PERSON_FOLLOW_MONITOR_INTERVAL_SEC=0.5
# 人物跟随点云通道
NUWAX_PERSON_FOLLOW_POINTCLOUD_CHANNEL=/global_map
# person-follow ready 文件
NUWAX_PERSON_FOLLOW_READY_FILE=runtime_data/person-follow/nuwax_person_follow.ready
# person-follow 启动超时（秒）
NUWAX_PERSON_FOLLOW_START_TIMEOUT_SEC=15
# 人物跟随目标通道
NUWAX_PERSON_FOLLOW_TARGET_CHANNEL=/person_follow_target
# 人物跟随坐标变换通道
NUWAX_PERSON_FOLLOW_TF_CHANNEL=/tf
# 人物跟随订阅准备检查次数
NUWAX_PERSON_FOLLOW_WARMUP_STEPS=150
# 波前探索单目标超时（毫秒）
NUWAX_WAVEFRONT_GOAL_TIMEOUT_MS=15000

# 通信通道与工作区
# LCM backend（唯一支持 real-lcm）
NUWAX_LCM_BACKEND=real-lcm
# 点云地图通道
NUWAX_LCM_CHANNEL_CLOUD_MAP="/cloud_map#sensor_msgs.PointCloud2"
# 运动速度指令通道
NUWAX_LCM_CHANNEL_CMD_VEL="/cmd_vel#geometry_msgs.Twist"
# 探索边界通道
NUWAX_LCM_CHANNEL_FRONTIER="/explore/frontiers#nuwax_msgs.FrontierList"
# 导航目标通道
NUWAX_LCM_CHANNEL_GOAL_POSE="/nav/goal#nuwax_msgs.GoalEnvelope"
# 惯性测量数据通道
NUWAX_LCM_CHANNEL_IMU="/imu/data#sensor_msgs.Imu"
# 激光惯性定位点云通道
NUWAX_LCM_CHANNEL_LIO_CLOUD="/geometry/lio/cloud#nuwax_msgs.LioCloudEnvelope"
# 激光惯性里程计通道
NUWAX_LCM_CHANNEL_LIO_ODOMETRY="/geometry/lio/odometry#nuwax_msgs.LioOdometryEnvelope"
# 激光惯性定位状态通道
NUWAX_LCM_CHANNEL_LIO_STATUS="/geometry/lio/status#nuwax_msgs.LioStatus"
# 导航取消通道
NUWAX_LCM_CHANNEL_NAV_CANCEL="/nav/cancel#nuwax_msgs.CancelNavigation"
# 导航路线通道
NUWAX_LCM_CHANNEL_NAV_PATH="/nav/path#nuwax_msgs.PathEnvelope"
# 导航状态通道
NUWAX_LCM_CHANNEL_NAV_STATE="/nav/state#nuwax_msgs.NavigationState"
# 占据栅格通道
NUWAX_LCM_CHANNEL_OCCUPANCY="/map/occupancy#nav_msgs.OccupancyGrid"
# 里程计通道
NUWAX_LCM_CHANNEL_ODOM="/odom#nav_msgs.Odometry"
# 原始点云通道
NUWAX_LCM_CHANNEL_POINTCLOUD="/go2/lidar/points#sensor_msgs.PointCloud2"
# 定位位姿通道
NUWAX_LCM_CHANNEL_POSE_STAMPED="/pose_stamped#geometry_msgs.PoseStamped"
# 坐标变换通道
NUWAX_LCM_CHANNEL_TF="/tf#tf2_msgs.TFMessage"
# 机器人通信组播地址
NUWAX_LCM_URL="udpm://239.255.76.67:7667?ttl=1"
# 原生功能库工作区目录
NUWAX_NUWAX_WORKSPACE_DIR=services/nuwax-workspace
# 通信不可用时停止启动
NUWAX_REAL_LCM_REQUIRED=false

# 外部几何栈与桥接
# runtime 提供地图
NUWAX_GEOMETRY_EXTERNAL_PROVIDES_MAP=true
# 由几何运行时提供导航
NUWAX_GEOMETRY_EXTERNAL_PROVIDES_NAV=true
# runtime 提供 TF（odom→base_link 等坐标变换）
NUWAX_GEOMETRY_EXTERNAL_PROVIDES_TF=true

# 感知·检测与跟踪
# YOLO-World 置信度阈值
NUWAX_PERCEPTION_YOLO_WORLD_CONFIDENCE=0.25
# 启用 YOLO-World 检测
NUWAX_PERCEPTION_YOLO_WORLD_ENABLED=true
# ByteTrack 高置信阈值
NUWAX_PERCEPTION_BYTETRACK_HIGH_THRESHOLD=0.5
# ByteTrack 匹配 IOU 阈值
NUWAX_PERCEPTION_BYTETRACK_IOU=0.3
# ByteTrack 丢失保留帧数
NUWAX_PERCEPTION_BYTETRACK_LOST_TTL_FRAMES=30
# ByteTrack 低置信阈值
NUWAX_PERCEPTION_BYTETRACK_LOW_THRESHOLD=0.1
# ByteTrack 跟踪器名称
NUWAX_PERCEPTION_BYTETRACK_NAME=go2_bytetrack_tracker
# ByteTrack 轨迹保留数量
NUWAX_PERCEPTION_BYTETRACK_TRAJECTORY_LIMIT=12
# 感知跟踪后端
NUWAX_PERCEPTION_TRACKER_BACKEND=bytetrack
# YOLO-World 类别别名
NUWAX_PERCEPTION_YOLO_WORLD_ALIASES=
# YOLO-World 后端名称
NUWAX_PERCEPTION_YOLO_WORLD_BACKEND_NAME=yolo_world
# YOLO-World 检测类别
NUWAX_PERCEPTION_YOLO_WORLD_CLASSES="person,door,chair,table,shelf,cabinet,box,bag,backpack,bottle,cup,bench,stairs,charger,dock,traffic cone,fire hydrant"
# YOLO-World 推理设备
NUWAX_PERCEPTION_YOLO_WORLD_DEVICE=
# YOLO-World 动态类别元数据键
NUWAX_PERCEPTION_YOLO_WORLD_DYNAMIC_CLASS_KEYS=
# YOLO-World 输入图像尺寸
NUWAX_PERCEPTION_YOLO_WORLD_IMAGE_SIZE=640
# YOLO-World IOU 阈值
NUWAX_PERCEPTION_YOLO_WORLD_IOU=0.45
# YOLO-World 最大检测数量
NUWAX_PERCEPTION_YOLO_WORLD_MAX_DETECTIONS=100
# YOLO-World 模型路径
NUWAX_PERCEPTION_YOLO_WORLD_MODEL=runtime_data/models/yolov8s-worldv2.pt
# YOLO-World 使用独立 Worker 进程
NUWAX_PERCEPTION_YOLO_WORLD_USE_WORKER=true

# 感知·分割/云端视觉/延迟投影
# 启用 OpenAI 视觉分析
NUWAX_PERCEPTION_OPENAI_ENABLED=false
# 启用实例分割
NUWAX_PERCEPTION_SEGMENTATION_ENABLED=false
# ARK API 密钥
ARK_API_KEY=
# 延迟投影策略
NUWAX_PERCEPTION_DEFERRED_STRATEGY=disabled
# 延迟投影交叉校验阈值（米）
NUWAX_PERCEPTION_DEFERRED_XVAL_THRESHOLD_M=0.3
# OpenAI API 密钥
NUWAX_PERCEPTION_OPENAI_API_KEY=
# OpenAI API 类型
NUWAX_PERCEPTION_OPENAI_API_STYLE=auto
# OpenAI 视觉后端名称
NUWAX_PERCEPTION_OPENAI_BACKEND_NAME=openai_vision
# OpenAI API 基础地址
NUWAX_PERCEPTION_OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI 最大输出令牌数
NUWAX_PERCEPTION_OPENAI_MAX_TOKENS=
# OpenAI 视觉模型
NUWAX_PERCEPTION_OPENAI_MODEL=
# OpenAI 温度
NUWAX_PERCEPTION_OPENAI_TEMPERATURE=0.0
# OpenAI 请求超时（秒）
NUWAX_PERCEPTION_OPENAI_TIMEOUT_SEC=20.0
# 允许仅使用检测框兜底
NUWAX_PERCEPTION_SEGMENTATION_ALLOW_BBOX_ONLY_FALLBACK=true
# 分割后端类型
NUWAX_PERCEPTION_SEGMENTATION_BACKEND_KIND=disabled_segmentation
# 分割后端名称
NUWAX_PERCEPTION_SEGMENTATION_BACKEND_NAME=
# 分割深度覆盖率阈值
NUWAX_PERCEPTION_SEGMENTATION_DEPTH_COVERAGE_THRESHOLD=0.2
# 输出分割多边形
NUWAX_PERCEPTION_SEGMENTATION_EMIT_POLYGON=true
# 输出分割质量详情
NUWAX_PERCEPTION_SEGMENTATION_EMIT_QUALITY_DETAILS=true
# 输出原始分割掩码
NUWAX_PERCEPTION_SEGMENTATION_EMIT_RAW_MASK=false
# 输出分割运行摘要
NUWAX_PERCEPTION_SEGMENTATION_EMIT_RUNTIME_SUMMARY=true
# 分割低延迟后端名称
NUWAX_PERCEPTION_SEGMENTATION_LOW_LATENCY_BACKEND_NAME=yolo_world_sam2
# 分割地图投影覆盖率阈值
NUWAX_PERCEPTION_SEGMENTATION_MAP_PROJECTION_COVERAGE_THRESHOLD=0.2
# 分割多边形简化容差（像素）
NUWAX_PERCEPTION_SEGMENTATION_POLYGON_SIMPLIFICATION_EPSILON_PX=2.0
# 分割预测 IOU 阈值
NUWAX_PERCEPTION_SEGMENTATION_PREDICTED_IOU_THRESHOLD=0.5
# 分割主后端名称
NUWAX_PERCEPTION_SEGMENTATION_PRIMARY_BACKEND_NAME=groundingdino_sam2
# 分割重投影误差阈值（像素）
NUWAX_PERCEPTION_SEGMENTATION_REPROJECTION_ERROR_THRESHOLD_PX=8.0
# 分割路由策略
NUWAX_PERCEPTION_SEGMENTATION_ROUTE=primary
# 分割分数阈值
NUWAX_PERCEPTION_SEGMENTATION_SCORE_THRESHOLD=0.5
# 分割稳定性阈值
NUWAX_PERCEPTION_SEGMENTATION_STABILITY_SCORE_THRESHOLD=0.5
# 通用 OpenAI API 密钥
OPENAI_API_KEY=

# 感知·关键帧与流
# 启动时自动开启视频感知
NUWAX_PERCEPTION_STREAM_AUTO_START=false
# 启用持续视频感知
NUWAX_PERCEPTION_STREAM_ENABLED=true
# 视频感知间隔（秒）
NUWAX_PERCEPTION_STREAM_INTERVAL_SEC=0.5
# 到点复核帧数
NUWAX_PERCEPTION_BURST_FRAME_COUNT=4
# 到点复核帧间隔（秒）
NUWAX_PERCEPTION_BURST_INTERVAL_SEC=0.08
