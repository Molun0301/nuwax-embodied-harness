[Unit]
Description=nuwax person-follow typed LCM owner
Requires=nuwax-motion-safety-guard.service nuwax-nav-stack.service nuwax-geometry-runtime.service
After=network-online.target nuwax-motion-safety-guard.service nuwax-nav-stack.service nuwax-geometry-runtime.service
Wants=network-online.target

[Service]
Type=exec
User=nuwax-navigation
Group=nuwax-navigation
WorkingDirectory=/home/unitree/nuwax-robot-bridge
UMask=0027
EnvironmentFile=-/home/unitree/nuwax-robot-bridge/.env
Environment=NUWAX_LCM_BACKEND=real-lcm
Environment=NUWAX_REAL_LCM_REQUIRED=true
Environment=NUWAX_LCM_URL=udpm://239.255.76.67:7667?ttl=1
# Channels stay unsuffixed here; nuwax-transport appends the declared LCM type.
Environment=NUWAX_PERSON_FOLLOW_TARGET_CHANNEL=/person_follow_target
Environment=NUWAX_PERSON_FOLLOW_POINTCLOUD_CHANNEL=/global_map
Environment=NUWAX_PERSON_FOLLOW_TF_CHANNEL=/tf
Environment=NUWAX_PERSON_FOLLOW_COMMAND_CHANNEL=/gateway/person_follow_cmd_vel
ExecStartPre=/bin/bash /home/unitree/nuwax-robot-bridge/scripts/systemd/wait_for_motion_guard_socket.sh check
ExecStartPre=/bin/bash /home/unitree/nuwax-robot-bridge/scripts/systemd/wait_for_nav_stack_ready.sh wait
ExecStartPre=/usr/bin/test -f /run/nuwax/geometry/nuwax_geometry_runtime.ready
ExecStart=/home/unitree/nuwax-robot-bridge/services/nuwax-workspace/target/release/nuwax-person-follow
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
FinalKillSignal=SIGKILL
TimeoutStopSec=20
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
