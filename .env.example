# ==================================================
# 【附录】以下配置键经 os.environ 直读，不经 settings.py，故不在上方受管列表。
# 需要时在对应源码语境设置（环境变量或部署脚本）；此处仅登记，便于排查。
# ==================================================
# NUWAX_CLOUD_MAP_FETCH_TIMEOUT_SEC  <- services/geometry/cloud_map_fetcher.py
# NUWAX_CLOUD_MAP_TOPIC  <- services/geometry/cloud_map_fetcher.py
# NUWAX_EXPLORE_FINALIZE_DELAY_SEC  <- gateways/runtime.py
# NUWAX_LOG_FORMAT  <- core/settings.py
# NUWAX_PCD_DB_EXPORT_TIMEOUT_SEC  <- services/geometry/cloud_map_fetcher.py
# NUWAX_PCD_EXPORT_FROM_DB  <- services/geometry/cloud_map_fetcher.py
# NUWAX_PCD_MIN_POINTS  <- services/geometry/cloud_map_fetcher.py
# NUWAX_SAVED_KEY  [敏感]  <- scripts/bootstrap.py

# ==================================================
# 【共享内存 / Unix socket（platform 旁路）】
# ==================================================
# 点云地图·共享内存路径（lcm_runtime.rs ↔ server.rs）
NUWAX_CLOUDMAP_SHM_PATH=/tmp/nuwax_cloudmap.mmap
# 占据栅格·共享内存路径（lcm_runtime.rs ↔ server.rs）
NUWAX_OCCUPANCY_SHM_PATH=/tmp/nuwax_occupancy.mmap
# 视频·共享内存路径（main.rs）
NUWAX_VIDEO_SHM_PATH=/tmp/nuwax_video.shm
# 视频·Unix socket 路径（main.rs）
NUWAX_VIDEO_UDS_PATH=/tmp/nuwax_video.sock

# ==================================================
# 【外部服务密钥】
# ==================================================
