+    const auto canonical = [](kt_double angle) {
+      kt_double value = std::fmod(angle + M_PI, 2 * M_PI);
+      return value < 0 ? value + 2 * M_PI : value;
+    };
+    std::stable_sort(m_AngularOrder.begin(), m_AngularOrder.end(), [&](kt_int32u a, kt_int32u b) {
