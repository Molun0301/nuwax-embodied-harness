{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuwax.dev/schemas/source-artifacts-v1.json",
  "title": "Nuwax source-built Python artifacts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "distribution",
        "version",
        "import_modules",
        "status",
        "fail_closed",
        "source",
        "integrity",
        "build"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "distribution": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "import_modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": ["unresolved", "ready"]
        },
        "fail_closed": {
          "const": true
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "repository", "commit"],
          "properties": {
            "type": {
              "const": "git"
            },
            "repository": {
              "type": ["string", "null"],
              "format": "uri"
            },
            "commit": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_sha256", "wheel_sha256"],
          "properties": {
            "source_sha256": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-f]{64}$"
            },
            "wheel_sha256": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": ["python", "architecture", "output"],
          "properties": {
            "python": {
              "const": "3.8"
            },
            "architecture": {
              "const": "aarch64"
            },
            "output": {
              "const": "wheel"
            }
          }
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "format": "uri"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "installed_version": {
              "type": "string",
              "minLength": 1
            },
            "working_tree_clean": {
              "type": "boolean"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ready"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "source": {
                "properties": {
                  "repository": {
                    "type": "string",
                    "format": "uri"
                  },
                  "commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              },
              "integrity": {
                "properties": {
                  "source_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "wheel_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
