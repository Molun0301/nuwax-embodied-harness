# G1 物理量覆盖模板（只读展示）
#
# 触发条件：scripts/start_gateway.sh 在 NUWAX_ACTIVE_ROBOT=g1 时 source 此文件
#          覆盖已 source 的 .env 物理量键。
# 与 .env.example 完全独立；本文件只放 G1 覆盖键，不重复 GO2 默认键。
# 实机命令：cp .env.G1_example .env   （或人工 source 此文件）
#
# 注意：以下键名与 .env.example 完全一致，按 mode 分发的差异靠 .env 覆盖；
#       本文件不新增任何键。

# ---------------------------------------------------------------------------
# G1 物理量键（覆盖 .env.example GO2 默认值）
# ---------------------------------------------------------------------------

# lidar topic — Livox Mid-360 原始点云（sensor_msgs/PointCloud2，livox_ros_driver2 命名）
NUWAX_GEOMETRY_POINT_CLOUD_TOPIC=/utlidar/cloud_livox_mid360

# lidar frame — livox_ros_driver2 默认；M0.1 实机探测后确认
# （候选：livox_mid360_link / livox_frame / mid360_link）
NUWAX_GEOMETRY_LIDAR_FRAME=livox_mid360_link

# imu topic — Livox Mid-360 内置 IMU；用作 gravity 约束（v4 D4 subscribe_imu=true）
NUWAX_GEOMETRY_IMU_TOPIC=/utlidar/imu_livox_mid360

# base frame — G1 URDF 双足标准 base（pelvis 链接）
NUWAX_GEOMETRY_BASE_FRAME=pelvis

# odom topic — mapping 模式主输入；Unitree SLAM mapping 路径输出
# （localization 模式可改为 /unitree/slam_relocation/odom，按 mode 分发靠 .env 切换）
NUWAX_GEOMETRY_ODOM_TOPIC=/unitree/slam_mapping/odom

# localization 模式覆盖（取消下行注释即生效；mapping 模式请注释）：
# NUWAX_GEOMETRY_ODOM_TOPIC=/unitree/slam_relocation/odom

# 物理尺寸 — 圆模型；G1 躯干 36x26cm + 4cm 安全边 ≈ 0.20m（URDF 估算）
NUWAX_GEOMETRY_ROBOT_RADIUS=0.20
NUWAX_GEOMETRY_INFLATION_RADIUS=0.65

# ---------------------------------------------------------------------------
# 备用（本期不用；R6 风险触发时才用）
# ---------------------------------------------------------------------------

# 底盘前端 odom（双足站立不稳时切换）：
# NUWAX_GEOMETRY_ODOM_TOPIC=/dog_odom