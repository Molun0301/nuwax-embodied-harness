+// 速度超过此值且惯性量测保持静止，才开始累计告警时长。
+constexpr double kDriftSpeedMps = 0.3;
+// 静止时角速度模长和加速度模长的偏差上限。
+constexpr double kStationaryAngularSpeedRadPerSec = 0.02;
+constexpr double kStationaryAccelerationErrorMps2 = 0.1;
+// 连续一秒以设备源时间计。
+constexpr SourceTimeNs kDriftDurationNs = nuwax_lio::kNanosecondsPerSecond;
+
+static bool imu_is_stationary(const custom_messages::Imu& imu) {
+    const auto& angular = imu.angular_velocity;
+    const auto& linear = imu.linear_acceleration;
+    return V3D(angular.x, angular.y, angular.z).norm() < kStationaryAngularSpeedRadPerSec
+        && std::abs(V3D(linear.x, linear.y, linear.z).norm() - 1.0) * G_m_s2
+            < kStationaryAccelerationErrorMps2;
+}
+
+static bool imu_stationary_through(SourceTimeNs end_ns) {
+    if (!imu_en) return false;
+    std::lock_guard<std::mutex> lock(mtx_buffer);
+    // 覆盖保留的惯性边界和本次扫描内的新样本，忽略扫描之后的右侧覆盖样本。
+    if (!imu_is_stationary(imu_last)) return false;
+    if (imu_time_ns(imu_next) > end_ns) return true;
+    if (!imu_is_stationary(imu_next)) return false;
+    for (const auto& imu : imu_deque) {
+        if (imu_time_ns(*imu) > end_ns) break;
+        if (!imu_is_stationary(*imu)) return false;
+    }
+    return true;
+}
+
+void LaserMapping::report_drift(bool imu_stationary, std::size_t passed_batches,
+                                std::size_t rejected_batches, const V3D& translation_information) {
+    const V3D& velocity = use_imu_as_input ? kf_input.x_.vel : kf_output.x_.vel;
+    const double speed = velocity.norm();
+    if (!(imu_stationary && speed > kDriftSpeedMps)) {
+        drift_begin_ns_.reset();
+        drift_reported_ = false;
+        return;
+    }
+    if (!drift_begin_ns_) drift_begin_ns_ = lidar_end_time_ns;
+    if (drift_reported_ || lidar_end_time_ns - *drift_begin_ns_ < kDriftDurationNs) return;
+
+    const double mean_residual = effct_feat_num > 0 ? total_residual / effct_feat_num : 0.0;
+    fprintf(stderr, "[pointlio] WARNING startup_drift source_ns=%lld speed_mps=%.9g "
+        "velocity_mps=[%.9g,%.9g,%.9g] lidar_passed=%zu lidar_rejected=%zu "
+        "mean_residual_m=%.9g lidar_translation_information_diag=[%.9g,%.9g,%.9g] "
+        "frames_since_imu_init=%zu\n",
+        static_cast<long long>(lidar_end_time_ns), speed, velocity.x(), velocity.y(), velocity.z(),
+        passed_batches, rejected_batches, mean_residual,
+        translation_information.x(), translation_information.y(), translation_information.z(),
+        frames_since_imu_init_);
+    drift_reported_ = true;
+}
