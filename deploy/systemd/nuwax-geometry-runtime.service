[Unit]
Requires=nuwax-lcm-network.service
After=nuwax-lcm-network.service
# Template: install with scripts/install_motion_guard_deployment.sh.
Description=nuwax-geometry-runtime（LCM-first geometry native runtime）
# Geometry 可独立承担建图/地图加载；仅导航与探索能力按需再启动 Guard + Nav。
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
User=nuwax
Group=nuwax
SupplementaryGroups=video render
WorkingDirectory=@NUWAX_REPO_ROOT@
LogsDirectory=nuwax/gateway
LogsDirectoryMode=0750
Environment=NUWAX_LOG_DIR=/var/log/nuwax/gateway
RuntimeDirectory=nuwax/geometry
RuntimeDirectoryMode=0750
StateDirectory=nuwax/geometry-runtime
StateDirectoryMode=0700
UMask=0007
# 服务默认值；用户配置文件覆盖同名业务设置。
Environment=PYTHONUNBUFFERED=1
Environment=NUWAX_BOOTSTRAP_ENV_FILE=@NUWAX_CONFIG_DIR@/nuwax.env
Environment="NUWAX_LCM_CHANNEL_POINTCLOUD=/go2/lidar/points#sensor_msgs.PointCloud2"
Environment="NUWAX_LCM_CHANNEL_CLOUD_MAP=/cloud_map#sensor_msgs.PointCloud2"
Environment="NUWAX_LCM_CHANNEL_GOAL_POSE=/nav/goal#nuwax_msgs.GoalEnvelope"
Environment="NUWAX_LCM_CHANNEL_NAV_PATH=/nav/path#nuwax_msgs.PathEnvelope"
Environment=NUWAX_LCM_BACKEND=real-lcm
Environment=NUWAX_REAL_LCM_REQUIRED=true
Environment=NUWAX_LCM_URL=udpm://239.255.76.67:7667?ttl=0
Environment=NUWAX_MOTION_GUARD_SOCKET=/run/nuwax/motion-guard.sock
Environment=NUWAX_GEOMETRY_RUNTIME_READY_FILE=/run/nuwax/geometry/nuwax_geometry_runtime.ready
Environment=NUWAX_GEOMETRY_RUNTIME_BINARY=@NUWAX_BIN_DIR@/nuwax-geometry-runtime
Environment=NUWAX_GEOMETRY_RUNTIME_PORT=50051
Environment=NUWAX_GEOMETRY_RUNTIME_HEALTH_TIMEOUT=30
Environment=NUWAX_CLOUDMAP_SHM_PATH=/var/lib/nuwax_robot_bridge/nuwax_cloudmap.mmap
Environment=NUWAX_OCCUPANCY_SHM_PATH=/var/lib/nuwax_robot_bridge/nuwax_occupancy.mmap
Environment=NUWAX_FORBIDDEN_ZONES_PATH=/var/lib/nuwax_robot_bridge/forbidden_zones.json
Environment=NUWAX_GEOMETRY_SEQUENCE_STATE_PATH=/var/lib/nuwax_robot_bridge/geometry/sequence_state.json
Environment=NUWAX_GEOMETRY_EXPLORATION_RECONCILIATION_JOURNAL_PATH=/var/lib/nuwax/geometry-runtime/exploration_ownership_journal.json
Environment=NUWAX_NAV_STACK_READY_FILE=/run/nuwax/navigation/nuwax_nav_stack.ready
EnvironmentFile=-@NUWAX_CONFIG_DIR@/nuwax.env
# Web 保存的 Geometry owner 选择后置覆盖基础配置，文件由共享组以只读方式提供。
EnvironmentFile=-/var/lib/nuwax_robot_bridge/geometry-owner.env
Environment=NUWAX_USER_CONFIG_ENV_FILE=/var/lib/nuwax_robot_bridge/settings.env
EnvironmentFile=-/var/lib/nuwax_robot_bridge/settings.env
ExecStartPre=/usr/bin/env /bin/bash @NUWAX_REPO_ROOT@/scripts/systemd/check_lcm_multicast.sh
ExecStartPre=/usr/bin/rm -f /tmp/nuwax_cloudmap.mmap /tmp/nuwax_occupancy.mmap
ExecStartPre=/usr/bin/rm -f /run/nuwax/geometry/nuwax_geometry_runtime.ready /run/nuwax/geometry/nuwax_geometry_runtime.ready.runtime
ExecStart=/usr/bin/env NUWAX_GEOMETRY_EXPLORATION_RECONCILIATION_JOURNAL_PATH=/var/lib/nuwax/geometry-runtime/exploration_ownership_journal.json /bin/bash @NUWAX_REPO_ROOT@/scripts/systemd/start_geometry_runtime.sh
ExecStartPost=/usr/bin/env /bin/bash @NUWAX_REPO_ROOT@/scripts/systemd/wait_for_geometry_runtime_ready.sh wait
ExecStopPost=/usr/bin/rm -f /run/nuwax/geometry/nuwax_geometry_runtime.ready /run/nuwax/geometry/nuwax_geometry_runtime.ready.runtime
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=3
# 先由启动器和 Rust 根拥有方依序关闭；期限耗尽仍回收整个控制组。
KillMode=mixed
TimeoutStopSec=20
ReadWritePaths=/run/nuwax/geometry /tmp /var/lib/nuwax/geometry-runtime /var/lib/nuwax_robot_bridge
# Phase 8 §13.2 修正:不再把 real-lcm fail-fast code(4) 当 SuccessExitStatus。
# 启动期缺 liblcm / 缺 udpm multicast 应被 systemd 视为真实失败并触发
# Restart=on-failure,只有 exit 0 算 success。
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
