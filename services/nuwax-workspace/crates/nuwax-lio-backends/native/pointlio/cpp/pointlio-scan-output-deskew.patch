+void LaserMapping::record_output_pose(double timestamp) {
+    const auto append = [&](const auto& state, const V3D& omega, const V3D& acceleration) {
+        nuwax_lio::PointLioScanOutput::Pose pose;
+        pose.timestamp = timestamp;
+        pose.position = state.pos;
+        pose.rotation = Eigen::Quaterniond(M3D(state.rot)).normalized();
+        pose.velocity = state.vel;
+        pose.acceleration = acceleration;
+        pose.omega = omega;
+        if (extrinsic_est_en) {
+            pose.body_from_sensor_rotation = Eigen::Quaterniond(M3D(state.offset_R_L_I)).normalized();
+            pose.body_from_sensor_translation = state.offset_T_L_I;
+        } else {
+            pose.body_from_sensor_rotation = Eigen::Quaterniond(Lidar_R_wrt_IMU).normalized();
+            pose.body_from_sensor_translation = Lidar_T_wrt_IMU;
+        }
+        scan_output_.record(pose);
+    };
+    if (use_imu_as_input) {
+        const auto& state = kf_input.x_;
+        append(state, input_in.gyro - state.bg,
+               state.rot * (input_in.acc - state.ba) + state.gravity);
+    } else {
+        const auto& state = kf_output.x_;
+        append(state, state.omg, state.rot * state.acc + state.gravity);
+    }
+}
+
+bool LaserMapping::finish_output_scan(const custom_messages::Odometry& odometry) {
+    const auto& pose = odometry.pose.pose;
+    const auto& q = pose.orientation;
+    const Eigen::Quaterniond rotation(q.w, q.x, q.y, q.z);
+    Eigen::Isometry3d world_from_sensor = Eigen::Isometry3d::Identity();
+    // 下游沿固定配置外参注册，输出参考必须与同源已发布机体位姿组成同一变换。
+    world_from_sensor.linear() = rotation.toRotationMatrix() * Lidar_R_wrt_IMU;
+    world_from_sensor.translation() = Eigen::Vector3d(
+        pose.position.x, pose.position.y, pose.position.z) + rotation * Lidar_T_wrt_IMU;
+    return scan_output_.finish_scan(feats_undistort, Measures.lidar_beg_time, world_from_sensor);
+}
