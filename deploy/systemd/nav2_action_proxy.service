[Unit]
Description=Nuwax Nav2 Action Proxy (独立 ROS 进程 + gRPC)
Documentation=https://openspec/changes/navigation-and-exploration-boundary
After=network-online.target robot-gateway.service
Requires=robot-gateway.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=unitree
Group=unitree
WorkingDirectory=/home/unitree/nuwax-robot-bridge
Environment="PYTHONUNBUFFERED=1"
Environment="RMW_IMPLEMENTATION=rmw_cyclonedds_cpp"
Environment="NAV_PROXY_GRPC_PORT=50061"
Environment="NAV_PROXY_PENDING_QUEUE_MAX_SIZE=4"
Environment="NAV_ACTION_NAMESPACE=/navigate_to_pose"
Environment="NUWAX_NAV2_PROXY_INDEPENDENT_PROCESS=true"
ExecStart=/bin/bash /home/unitree/nuwax-robot-bridge/services/navigation/nav2_action_proxy_launch.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target