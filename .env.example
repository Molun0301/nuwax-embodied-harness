NUWAX_PERCEPTION_SEGMENTATION_DEPTH_COVERAGE_THRESHOLD=0.2
# emit polygon  [高级]
NUWAX_PERCEPTION_SEGMENTATION_EMIT_POLYGON=true
# emit quality details  [高级]
NUWAX_PERCEPTION_SEGMENTATION_EMIT_QUALITY_DETAILS=true
# emit raw mask  [高级]
NUWAX_PERCEPTION_SEGMENTATION_EMIT_RAW_MASK=false
# emit runtime summary  [高级]
NUWAX_PERCEPTION_SEGMENTATION_EMIT_RUNTIME_SUMMARY=true
