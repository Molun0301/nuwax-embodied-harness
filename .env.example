NUWAX_OSM_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NUWAX_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NUWAX_OSM_USER_AGENT=nuwax-mapping-cloud/0.1
