package nuwax_msgs;

struct NavigationStatus {
    string session_id;
    string robot_frame;
    int64_t stamp_sec;
    int32_t stamp_nsec;
    int32_t state;
    // Geometry目标状态：0无目标、1等待输入、2规划、3执行、4到达、5失败、6取消、7被替换、8停止。
    int32_t goal_status;
    string reason;
    double remaining_distance_m;
    boolean input_ready;
    boolean no_feasible_path;
    double goal_x;
    double goal_y;
    double goal_yaw;
    double current_x;
    double current_y;
    double current_yaw;
    double progress;
    string message;
    int64_t runtime_generation;
    int64_t pose_source_timestamp_ns;
    int64_t costmap_source_timestamp_ns;
    int8_t sink_ready;
    string planner_map_frame;
    string planner_pose_frame;
    int64_t cancel_generation;
    string zero_ack_id;
    int64_t zero_applied_monotonic_ns;
    int32_t owner_kind;
    string parent_request_id;
    int64_t goal_generation;
    int64_t path_revision;
    int64_t producer_runtime_generation;
    int64_t planner_runtime_generation;
    // 同一目标与路径修订的局部规划展示；终态为空。
    int32_t local_path_count;
    double local_path[local_path_count][3];
}
