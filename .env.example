# ==================================================
# nuwax_robot_bridge 主配置文件（完整模板 = 默认值全集）
# 说明：
# 1. 本文件由 core/config_registry.py 依据 settings.py 自动生成，覆盖全部平台侧配置项。
# 2. 格式统一 KEY=VALUE；# 开头为注释；同名环境变量优先级高于此文件。
# 3. 每个键的值即 settings.py 的有效默认值；可直接复制为 .env 使用。
# 4. 标注[敏感·留空]的键不写默认值，请按需自行填写。
# 5. 标注[高级]的键不常改；[旧名 X]表示存在历史别名仍兼容读取。
# 6. Go2 设备侧数据面配置在 drivers/go2/data_plane.env(.example)，不在本文件。
# ==================================================


# ==================================================
# 【机器人与运行入口】
# ==================================================
# 激活机器人
NUWAX_ACTIVE_ROBOT=
# interval sec  [高级]
GO2_LOW_LEVEL_INTERVAL_SEC=0.002
# kd  [高级]
GO2_LOW_LEVEL_KD=5.0
# kp  [高级]
GO2_LOW_LEVEL_KP=60.0
# max torque  [高级]
GO2_LOW_LEVEL_MAX_TORQUE=10.0
# max velocity  [高级]
GO2_LOW_LEVEL_MAX_VELOCITY=2.0
# path  [高级]
GO2_SDK_PATH=/home/unitree/unitree_sdk2_python
# volume auto enable vui switch  [高级]
GO2_VOLUME_AUTO_ENABLE_VUI_SWITCH=true

# ==================================================
# 【网关与服务】
# ==================================================
# 网关监听地址
NUWAX_GATEWAY_HOST=0.0.0.0
# 网关端口
NUWAX_GATEWAY_PORT=8766
# agent high risk allowlist  [高级]
NUWAX_GATEWAY_AGENT_HIGH_RISK_ALLOWLIST=
# artifact dir  [高级]
# （默认按安装目录自动推导，留空即可；如需固定请填绝对路径）
NUWAX_GATEWAY_ARTIFACT_DIR=
# high risk allowlist：个人机器狗：网关不鉴权（无 agent/admin 令牌、无来源网段限制）。 仅保留能力风险门控白名单：列出的 HIGH 风险能力才允许被能力调用入口（含 LLM）触发，逗号分隔。  [高级]
NUWAX_GATEWAY_HIGH_RISK_ALLOWLIST=
# public base url  [高级]
NUWAX_GATEWAY_PUBLIC_BASE_URL=http://host.docker.internal:8766
# sse keepalive sec  [高级]
NUWAX_GATEWAY_SSE_KEEPALIVE_SEC=10.0
# ws ping interval sec  [高级]
NUWAX_GATEWAY_WS_PING_INTERVAL_SEC=15.0

# ==================================================
# 【性能监控（遥测）】
# ==================================================
# enabled：性能监控（CPU/内存/进程）采集，平台侧用 psutil，通用不绑定机器人型号。
NUWAX_GATEWAY_TELEMETRY_ENABLED=true
# interval sec：采集周期（秒），弱算力 ARM 设备可调大以降低开销。
NUWAX_GATEWAY_TELEMETRY_INTERVAL_SEC=2.0
# include process tree：是否额外纳入网关本进程树（自身 + 子孙进程）。  [高级]
NUWAX_GATEWAY_TELEMETRY_INCLUDE_PROCESS_TREE=true
# process keywords：被监控进程关键字白名单（逗号分隔，按 cmdline 子串匹配，name 作补充）。  [高级]
NUWAX_GATEWAY_TELEMETRY_PROCESS_KEYWORDS=gateway,nuwax-geometry-runtime,nuwax-nav-stack,nuwax-lcm-runtime,go2_video_streamer

# ==================================================
# 【日志】
# ==================================================
# 日志级别
NUWAX_LOG_LEVEL=INFO
# dir  [高级]
# （默认按安装目录自动推导，留空即可；如需固定请填绝对路径）
GO2_PROXY_LOG_DIR=
# file  [高级]
# （默认按安装目录自动推导，留空即可；如需固定请填绝对路径）
GO2_PROXY_LOG_FILE=
# level  [高级]
GO2_PROXY_LOG_LEVEL=INFO
# max lines  [高级]
GO2_PROXY_LOG_MAX_LINES=100000
# trim check interval  [高级]
GO2_PROXY_LOG_TRIM_CHECK_INTERVAL=200
# dir  [高级]
# （默认按安装目录自动推导，留空即可；如需固定请填绝对路径）
NUWAX_LOG_DIR=
# file  [高级]
# （默认按安装目录自动推导，留空即可；如需固定请填绝对路径）
NUWAX_LOG_FILE=
# max lines  [高级]
NUWAX_LOG_MAX_LINES=100000
# trim check interval  [高级]
NUWAX_LOG_TRIM_CHECK_INTERVAL=200

# ==================================================
# 【几何引擎·话题与坐标系】
# ==================================================
# 启用几何引擎
NUWAX_GEOMETRY_ENABLED=true
# base frame（Python / Rust 共用）  [高级]
NUWAX_BASE_FRAME=go2_base_link
NUWAX_GEOMETRY_POSE_TOPIC=/go2/pose_map
# cloud map topic：cloud_map 首选名（legacy NUWAX_CLOUD_MAP_TOPIC 已弃用，建图 PCD 导出链消费）  [高级 / 旧名 NUWAX_CLOUD_MAP_TOPIC]
NUWAX_GEOMETRY_CLOUD_MAP_TOPIC=/cloud_map
# cost map topic  [高级]
NUWAX_GEOMETRY_COST_MAP_TOPIC=/nav/costmap
# imu frame  [高级]
NUWAX_GEOMETRY_IMU_FRAME=utlidar_imu
# imu topic  [高级]
NUWAX_GEOMETRY_IMU_TOPIC=/utlidar/imu
# lidar frame  [高级]
NUWAX_GEOMETRY_LIDAR_FRAME=utlidar_lidar
# map frame（Python / Rust 共用）  [高级]
NUWAX_MAP_FRAME=map
# min traversability score  [高级]
NUWAX_GEOMETRY_MIN_TRAVERSABILITY_SCORE=0.5
# occupancy topic  [高级]
NUWAX_GEOMETRY_OCCUPANCY_TOPIC=/map_obstacles
# odom frame  [高级]
NUWAX_GEOMETRY_ODOM_FRAME=odom
# odom max age sec  [高级]
NUWAX_GEOMETRY_ODOM_MAX_AGE_SEC=0.5
# odom max angular covariance  [高级]
NUWAX_GEOMETRY_ODOM_MAX_ANGULAR_COVARIANCE=1.0
# odom max linear covariance  [高级]
NUWAX_GEOMETRY_ODOM_MAX_LINEAR_COVARIANCE=1.0
# odom quality source：里程计质量  [高级]
NUWAX_GEOMETRY_ODOM_QUALITY_SOURCE=topic_covariance
# odom require covariance  [高级]
NUWAX_GEOMETRY_ODOM_REQUIRE_COVARIANCE=false
# odom topic：odom 话题：实机由 Unitree 驱动发布 /utlidar/robot_odom（/odom 在实机零消费）。 与 settings.py 默认 (/utlidar/robot_odom) 对齐，勿改回 /odom 否则建图链路接到无人发布话题。  [高级]
NUWAX_GEOMETRY_ODOM_TOPIC=/utlidar/robot_odom
# platform bridge cmd vel enabled：平台补桥 cmd_vel（外部栈未自带输出时由平台补桥，默认关闭）  [高级]
NUWAX_GEOMETRY_PLATFORM_BRIDGE_CMD_VEL_ENABLED=false
# platform odom tf bridge enabled：平台桥（外部栈未自带输入时由平台补桥，默认关闭）  [高级]
NUWAX_GEOMETRY_PLATFORM_ODOM_TF_BRIDGE_ENABLED=false
# point cloud crop forward max m  [高级]
NUWAX_GEOMETRY_POINT_CLOUD_CROP_FORWARD_MAX_M=6.0
# point cloud crop forward min m  [高级]
NUWAX_GEOMETRY_POINT_CLOUD_CROP_FORWARD_MIN_M=-0.5
# point cloud crop lateral m  [高级]
NUWAX_GEOMETRY_POINT_CLOUD_CROP_LATERAL_M=3.0
# point cloud crop max z m  [高级]
NUWAX_GEOMETRY_POINT_CLOUD_CROP_MAX_Z_M=1.6
# point cloud crop min z m  [高级]
NUWAX_GEOMETRY_POINT_CLOUD_CROP_MIN_Z_M=-0.6
# point cloud max age sec  [高级]
NUWAX_GEOMETRY_POINT_CLOUD_MAX_AGE_SEC=0.5
# point cloud max points  [高级]
NUWAX_GEOMETRY_POINT_CLOUD_MAX_POINTS=1200
# point cloud max range m  [高级]
NUWAX_GEOMETRY_POINT_CLOUD_MAX_RANGE_M=8.0
# point cloud min range m  [高级]
NUWAX_GEOMETRY_POINT_CLOUD_MIN_RANGE_M=0.15
# point cloud preprocess enabled：点云预处理  [高级]
NUWAX_GEOMETRY_POINT_CLOUD_PREPROCESS_ENABLED=true
# point cloud topic  [高级]
NUWAX_GEOMETRY_POINT_CLOUD_TOPIC=/utlidar/cloud_deskewed
# point cloud voxel size m  [高级]
NUWAX_GEOMETRY_POINT_CLOUD_VOXEL_SIZE_M=0.05
# secondary odom topics  [高级]
NUWAX_GEOMETRY_SECONDARY_ODOM_TOPICS=
# tf max age sec  [高级]
NUWAX_GEOMETRY_TF_MAX_AGE_SEC=0.5
# tf static topic  [高级]
NUWAX_GEOMETRY_TF_STATIC_TOPIC=/tf_static
# tf topic  [高级]
NUWAX_GEOMETRY_TF_TOPIC=/tf

# ==================================================
# 【几何引擎·点云与质量】
# ==================================================
# sensor skew sec  [高级]
NUWAX_GEOMETRY_MAX_SENSOR_SKEW_SEC=0.2
# require monotonic  [高级]
NUWAX_GEOMETRY_TIMESTAMP_REQUIRE_MONOTONIC=true
# source：时间戳质量  [高级]
NUWAX_GEOMETRY_TIMESTAMP_SOURCE=sensor_header
# filter enabled：可通行性  [高级]
NUWAX_GEOMETRY_TRAVERSABILITY_FILTER_ENABLED=true
# max slope deg  [高级]
NUWAX_GEOMETRY_TRAVERSABILITY_MAX_SLOPE_DEG=18.0
# max step height m  [高级]
NUWAX_GEOMETRY_TRAVERSABILITY_MAX_STEP_HEIGHT_M=0.15
# output layer  [高级]
NUWAX_GEOMETRY_TRAVERSABILITY_OUTPUT_LAYER=traversability

# ==================================================
# 【建图（nuwax-mapping）】
# ==================================================
# nuwax-mapping 配置名称
NUWAX_MAPPING_PROFILE_NAME=nuwax_geometry_runtime
# 启用 nuwax-mapping 建图
NUWAX_MAPPING_PROFILE_ENABLED=true
# 使用默认 nuwax-mapping 配置  [高级]
NUWAX_MAPPING_DEFAULT_PROFILE=true
# nuwax-mapping 数据库目录  [高级]
# （默认按安装目录自动推导，留空即可；如需固定请填绝对路径）
NUWAX_MAPPING_DATABASE_ROOT=
# nuwax-mapping 点云地图目录  [高级]
# （默认按安装目录自动推导，留空即可；如需固定请填绝对路径）
NUWAX_MAPPING_PCD_ROOT=
# nuwax-mapping 映射 crate 名  [高级]
NUWAX_MAPPING_CRATE=nuwax-mapping
# nuwax-mapping 占据投影名称  [高级]
NUWAX_MAPPING_OCCUPANCY_PROJECTION=projected_occupancy
# nuwax-mapping 输入契约  [高级]
NUWAX_MAPPING_INPUT_CONTRACT=platform_geometry_inputs
# nuwax-mapping 输出契约  [高级]
NUWAX_MAPPING_OUTPUT_CONTRACT=platform_map_version_geometry_asset
# nuwax-mapping 数据库制品名称  [高级]
NUWAX_MAPPING_DATABASE_ASSET_NAME=nuwax_mapping_state.db
# nuwax-mapping 点云地图制品名称  [高级]
NUWAX_MAPPING_PCD_ASSET_NAME=cloud_map.pcd
# nuwax-mapping 占据栅格图层  [高级]
NUWAX_MAPPING_OCCUPANCY_LAYER=occupancy_grid
# nuwax-mapping 代价地图图层  [高级]
NUWAX_MAPPING_COSTMAP_LAYER=nuwax_global_costmap
# nuwax-mapping 可通行性图层  [高级]
NUWAX_MAPPING_TRAVERSABILITY_LAYER=traversability
# nuwax-mapping 定位状态字段名  [高级]
NUWAX_MAPPING_LOCALIZATION_STATUS=mapping_localization
# nuwax-mapping 重定位诊断字段名  [高级]
NUWAX_MAPPING_RELOCALIZATION_DIAGNOSTICS=mapping_icp

# ==================================================
# 【Rust mapping 适配器（mapping_adapter.rs）】
# ==================================================
# 映射适配器·栅格分辨率（m/cell）  [高级]
NUWAX_MAPPING_RESOLUTION=0.05
# 映射适配器·栅格宽度（格）  [高级]
NUWAX_MAPPING_WIDTH_CELLS=200
# 映射适配器·栅格高度（格）  [高级]
NUWAX_MAPPING_HEIGHT_CELLS=200
# 映射适配器·栅格原点 X（m）  [高级]
NUWAX_MAPPING_ORIGIN_X=-5.0
# 映射适配器·栅格原点 Y（m）  [高级]
NUWAX_MAPPING_ORIGIN_Y=-5.0
# 映射适配器·体素降采样边长（m）  [高级]
NUWAX_MAPPING_VOXEL_SIZE=0.05
# 原版点云占据 kernel（height_cost / general / simple）  [高级]
NUWAX_MAPPING_OCCUPANCY_ALGO=height_cost
# 机器人世界原点周围强制清空半径（m）  [高级]
NUWAX_MAPPING_INITIAL_SAFE_RADIUS_METERS=0.0

# ==================================================
# 【几何运行时（nuwax-geometry-runtime + LCM）】
# ==================================================
# nuwax-geometry-runtime 二进制路径  [高级]
# （默认按安装目录自动推导，留空即可；如需固定请填绝对路径）
NUWAX_GEOMETRY_RUNTIME_BINARY=
# nuwax-geometry-runtime gRPC 控制面端口
NUWAX_GEOMETRY_RUNTIME_PORT=50051
# nuwax-geometry-runtime ready 文件（standalone 开发路径）  [高级]
# production systemd ExecStart 强制使用 /run/nuwax/geometry，忽略共享 .env 冲突值。
NUWAX_GEOMETRY_RUNTIME_READY_FILE=runtime_data/geometry/nuwax_geometry_runtime.ready
# nuwax-geometry-runtime 健康超时（秒）  [高级]
NUWAX_GEOMETRY_RUNTIME_HEALTH_TIMEOUT=30
# nuwax-geometry-runtime 进程名
NUWAX_GEOMETRY_RUNTIME_PROCESS_NAME=nuwax-geometry-runtime
# nuwax-geometry-runtime 日志名
NUWAX_GEOMETRY_RUNTIME_LOG_NAME=nuwax_geometry_runtime.log
# runtime 提供地图
NUWAX_GEOMETRY_EXTERNAL_PROVIDES_MAP=true
# runtime 提供导航
NUWAX_GEOMETRY_EXTERNAL_PROVIDES_NAV=true
# runtime 提供 TF
NUWAX_GEOMETRY_EXTERNAL_PROVIDES_TF=true
# 启用 nuwax-geometry-runtime
NUWAX_GEOMETRY_EXTERNAL_ENABLED=true

# LCM UDP multicast URL（real-lcm backend 默认启用）
# Phase 4 硬约束：必须 `udpm://...`，`udp://` 是非法，会被 start 脚本拒绝。
NUWAX_LCM_URL=udpm://239.255.76.67:7667?ttl=1
# Phase 4 typed suffix 自动补齐：
# env 中 channel 字段缺 `#<msg_type>` 后缀时，由 Rust channel_registry
# 自动用 default msg_type 补齐；建议显式带 `#msg_type`，避免 deprecation warning。
# real-lcm 是唯一后端；缺 liblcm 或 multicast 不可用时启动必须失败。
NUWAX_LCM_BACKEND=real-lcm
# nuwax-workspace 路径依赖目录(Path dep 源)
# Phase 1 (2026-07-07):已并入本仓 services/nuwax-workspace,无需配置;
# 默认走 contracts.geometry_runtime.build_default_nuwax_workspace_dir()
# 自动计算 repo-local 路径。
NUWAX_NUWAX_WORKSPACE_DIR=

# LCM typed channel 配置
NUWAX_LCM_CHANNEL_ODOM=/odom#nav_msgs.Odometry
NUWAX_LCM_CHANNEL_TF=/tf#tf2_msgs.TFMessage
NUWAX_LCM_CHANNEL_POINTCLOUD=/go2/lidar/points#sensor_msgs.PointCloud2
NUWAX_LCM_CHANNEL_OCCUPANCY=/map/occupancy#nav_msgs.OccupancyGrid
NUWAX_LCM_CHANNEL_CMD_VEL=/cmd_vel#geometry_msgs.Twist
NUWAX_LCM_CHANNEL_GOAL_POSE=/nav/goal#nuwax_msgs.GoalEnvelope
NUWAX_LCM_CHANNEL_NAV_PATH=/nav/path#nuwax_msgs.PathEnvelope
NUWAX_LCM_CHANNEL_FRONTIER=/explore/frontiers#nuwax_msgs.FrontierList
NUWAX_LCM_CHANNEL_CLOUD_MAP=/cloud_map#sensor_msgs.PointCloud2
# Phase 1 channel registry 补齐 4 类 typed channel
NUWAX_LCM_CHANNEL_POSE_STAMPED=/pose_stamped#geometry_msgs.PoseStamped
NUWAX_LCM_CHANNEL_NAV_CANCEL=/nav/cancel#nuwax_msgs.CancelNavigation
# Phase 4:nav_state 独立 platform alias 键（历史上误用 GOAL_POSE alias）
NUWAX_LCM_CHANNEL_NAV_STATE=/nav/state#nuwax_msgs.NavigationState
# Phase 1:runtime 进程直接读取的 typed channel env key（Rust main.rs 解析）
NUWAX_GEOMETRY_RUNTIME_POSE_CHANNEL=/pose_stamped#geometry_msgs.PoseStamped
NUWAX_GEOMETRY_RUNTIME_ODOMETRY_CHANNEL=/odom#nav_msgs.Odometry
NUWAX_GEOMETRY_RUNTIME_TF_CHANNEL=/tf#tf2_msgs.TFMessage
# raw sensor pointcloud 与累计 cloud_map 是两个独立输入，不得互相回退。
NUWAX_GEOMETRY_RUNTIME_POINTCLOUD_CHANNEL=/go2/lidar/points#sensor_msgs.PointCloud2
NUWAX_GEOMETRY_RUNTIME_CLOUDMAP_CHANNEL=/cloud_map#sensor_msgs.PointCloud2
NUWAX_GEOMETRY_RUNTIME_OCCUPANCY_CHANNEL=/map/occupancy#nav_msgs.OccupancyGrid
NUWAX_GEOMETRY_RUNTIME_CMD_VEL_CHANNEL=/cmd_vel#geometry_msgs.Twist
NUWAX_GEOMETRY_RUNTIME_NAV_STATE_CHANNEL=/nav/state#nuwax_msgs.NavigationState
NUWAX_GEOMETRY_RUNTIME_FRONTIERS_CHANNEL=/explore/frontiers#nuwax_msgs.FrontierList
NUWAX_GEOMETRY_RUNTIME_NAV_GOAL_CHANNEL=/nav/goal#nuwax_msgs.GoalEnvelope
NUWAX_GEOMETRY_RUNTIME_NAV_PATH_CHANNEL=/nav/path#nuwax_msgs.PathEnvelope
NUWAX_GEOMETRY_RUNTIME_NAV_CANCEL_CHANNEL=/nav/cancel#nuwax_msgs.CancelNavigation

# ==================================================
# 【Phase 6 导航 / 探索 profile + real-lcm 硬约束】
# ==================================================
# 导航 profile:Rust nav_runtime.rs 装配时读取
# 可选值:simple-2d / replanning-astar / cmu-native / mls3d / exploration-native
# 默认 simple-2d(与 nuwax-nav-stack foundation 组合对齐)
NUWAX_NAV_PROFILE=simple-2d
# 探索 source arbitration：生产构建只 qualification wavefront。
NUWAX_EXPLORE_ARBITRATION=prefer_wavefront
# real-lcm 启动失败 fail-fast 开关
# true 时 real-lcm 失败必须 fail-fast(HealthCheck healthy=false + LCM_BACKEND_UNAVAILABLE),
# 不允许 transport fallback；false 仅供 standalone 开发。
# production systemd ExecStart 强制 true，EnvironmentFile 无权覆盖该安全门。
NUWAX_REAL_LCM_REQUIRED=false

# ==================================================
# 【导航（nuwax-nav-stack，替代旧 Nav2）】
# ==================================================
# 自动启动导航后端
NUWAX_NAV_AUTOSTART=true
# 自动启动 person-follow 独立进程
NUWAX_PERSON_FOLLOW_AUTOSTART=true
# standalone 路径；production systemd 强制使用 /run/nuwax/person-follow。
NUWAX_PERSON_FOLLOW_READY_FILE=runtime_data/person-follow/nuwax_person_follow.ready
NUWAX_PERSON_FOLLOW_START_TIMEOUT_SEC=15
NUWAX_PERSON_FOLLOW_WARMUP_STEPS=150
# production binary 必须通过 scripts/build_nav_stack.sh 构建，固定包含
# simple-2d 与 replanning-astar runtime owners。
# production systemd ExecStart 强制 /run/nuwax/navigation；共享 .env 只定义 standalone 路径。
NUWAX_NAV_STACK_READY_FILE=runtime_data/navigation/nuwax_nav_stack.ready
NUWAX_NAV_STACK_START_TIMEOUT_SEC=15
# 导航目标 LCM channel  [高级]
NUWAX_NAV_GOAL_CHANNEL=/nav/goal
# 导航取消 LCM channel  [高级]
NUWAX_NAV_CANCEL_CHANNEL=/nav/cancel
# 导航状态 LCM channel  [高级]
NUWAX_NAV_STATE_CHANNEL=/nav/state
# 导航代价地图来源
NUWAX_NAV_COSTMAP_SOURCE=nuwax_global_costmap
# 导航代价地图 LCM channel  [高级]
NUWAX_NAV_COSTMAP_CHANNEL=/nav/costmap
# 导航动作命名空间  [高级]
NUWAX_NAV_ACTION_NAMESPACE=/navigate_to_pose
# 闭环判据计数阈值
NUWAX_NAV_LOOP_CLOSURE_THRESHOLD=3
# 导航·是否要求 cmd_vel sink 注入（true 时缺 sink 启动 fail-fast）  [高级]
NUWAX_NAV_REQUIRE_CMD_VEL_SINK=false
# 闭环判据轮询间隔（秒）
NUWAX_NAV_LOOP_CLOSURE_POLL_INTERVAL_SEC=5.0
# 启用 RTAB-Map DB SQLite 闭环 fallback
NUWAX_NAV_DB_SQLITE_FALLBACK_ENABLED=true
# 导航代理 gRPC 端口
NUWAX_NAV_PROXY_GRPC_PORT=50061
# 导航代理 PENDING 队列上限
NUWAX_NAV_PROXY_PENDING_QUEUE_MAX_SIZE=4
# /map_obstacles 仅 RTAB /map + /cloud_obstacles；不含 live /go2/cloud 扫描烙印  [高级]
GO2_OBSTACLE_GRID_LIVE_CLOUD_ENABLED=false
GO2_OBSTACLE_GRID_PUBLISH_ON_CLOUD=false

# ==================================================
# 【感知·检测与跟踪】
# ==================================================
# world confidence
NUWAX_PERCEPTION_YOLO_WORLD_CONFIDENCE=0.25
# world enabled
NUWAX_PERCEPTION_YOLO_WORLD_ENABLED=true
# high threshold  [高级]
NUWAX_PERCEPTION_BYTETRACK_HIGH_THRESHOLD=0.5
# iou  [高级]
NUWAX_PERCEPTION_BYTETRACK_IOU=0.3
# lost ttl frames  [高级]
NUWAX_PERCEPTION_BYTETRACK_LOST_TTL_FRAMES=30
# low threshold  [高级]
NUWAX_PERCEPTION_BYTETRACK_LOW_THRESHOLD=0.1
# name：ByteTrack 跟踪器参数（settings.py:784-789）  [高级]
NUWAX_PERCEPTION_BYTETRACK_NAME=go2_bytetrack_tracker
# trajectory limit  [高级]
NUWAX_PERCEPTION_BYTETRACK_TRAJECTORY_LIMIT=12
# backend  [高级]
NUWAX_PERCEPTION_TRACKER_BACKEND=bytetrack
# world aliases：YOLO-World 动态类别别名（CSV，默认空；settings.py:779）  [高级]
NUWAX_PERCEPTION_YOLO_WORLD_ALIASES=
# world backend name  [高级]
NUWAX_PERCEPTION_YOLO_WORLD_BACKEND_NAME=yolo_world
# world classes  [高级]
NUWAX_PERCEPTION_YOLO_WORLD_CLASSES=person,door,chair,table,shelf,cabinet,box,bag,backpack,bottle,cup,bench,stairs,charger,dock,traffic cone,fire hydrant
# world device  [高级]
NUWAX_PERCEPTION_YOLO_WORLD_DEVICE=
# world dynamic class keys  [高级]
NUWAX_PERCEPTION_YOLO_WORLD_DYNAMIC_CLASS_KEYS=
# world image size  [高级]
NUWAX_PERCEPTION_YOLO_WORLD_IMAGE_SIZE=640
# world iou  [高级]
NUWAX_PERCEPTION_YOLO_WORLD_IOU=0.45
# world max detections  [高级]
NUWAX_PERCEPTION_YOLO_WORLD_MAX_DETECTIONS=100
# world model：模型文件后缀即推理链路：.pt → PyTorch(YOLOWorld 开放词汇)；.engine → TensorRT(YOLO，类别固化)  [高级]
# （默认按安装目录自动推导，留空即可；如需固定请填绝对路径）
NUWAX_PERCEPTION_YOLO_WORLD_MODEL=
# 使用隔离 worker 进程执行 YOLO-World
NUWAX_PERCEPTION_YOLO_WORLD_USE_WORKER=true

# ==================================================
# 【感知·分割/云端视觉/延迟投影】
