// Typed tracked-person input for the production DetectionNavigation owner.
// tracking_state: 0=TRACKED, 1=LOST, 2=STOP.
struct nuwax_msgs__PersonFollowTarget
{
    string   session_id;
    string   query;
    int64_t  stamp_sec;
    int32_t  stamp_nsec;
    string   camera_frame;
    int32_t  image_width;
    int32_t  image_height;
    double   fx;
    double   fy;
    double   cx;
    double   cy;
    double   bbox_x1;
    double   bbox_y1;
    double   bbox_x2;
    double   bbox_y2;
    int32_t  tracking_state;
}
