// LCM IDL — geometry_msgs.Transform
//
// 来源：lcm-gen 标准 .lcm 语法。上游 LCM 1.x geometry_msgs::Transform
// 描述一个 SE(3) 平移+旋转。
struct geometry_msgs__Transform
{
    double translation_x;
    double translation_y;
    double translation_z;
    double rotation_w;
    double rotation_x;
    double rotation_y;
    double rotation_z;
}
