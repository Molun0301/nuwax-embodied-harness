package nuwax_msgs;

// 与 Geometry 的目标载荷一致；可选值用零或一项的数组表示。
struct NavigationGoal {
    string session_id;
    // 原样承载 uint64 运动代次的八个字节。
    int64_t motion_generation;
    geometry_msgs.PoseStamped goal;
    int8_t allow_reverse_length;
    int8_t allow_reverse[allow_reverse_length];
    int8_t position_tolerance_length;
    double position_tolerance_m[position_tolerance_length];
    int8_t yaw_tolerance_length;
    double yaw_tolerance_rad[yaw_tolerance_length];
    int32_t boundary_points_length;
    double boundary_points[boundary_points_length][2];
}
