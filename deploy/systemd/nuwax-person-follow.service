[Unit]
Requires=nuwax-lcm-network.service
After=nuwax-lcm-network.service
# Template: install with scripts/install_motion_guard_deployment.sh.
Description=nuwax person-follow typed LCM owner
Requires=nuwax-motion-safety-guard.service nuwax-nav-stack.service nuwax-geometry-runtime.service
BindsTo=nuwax-motion-safety-guard.service nuwax-nav-stack.service nuwax-geometry-runtime.service
PartOf=nuwax-motion-safety-guard.service nuwax-nav-stack.service nuwax-geometry-runtime.service
After=network-online.target nuwax-motion-safety-guard.service nuwax-nav-stack.service nuwax-geometry-runtime.service
Wants=network-online.target

[Service]
Type=simple
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
User=nuwax
Group=nuwax
WorkingDirectory=@NUWAX_REPO_ROOT@
LogsDirectory=nuwax/gateway
LogsDirectoryMode=0750
Environment=NUWAX_LOG_DIR=/var/log/nuwax/gateway
RuntimeDirectory=nuwax/person-follow
RuntimeDirectoryMode=0750
UMask=0027
# 服务默认值；用户配置文件覆盖同名业务设置。
Environment=NUWAX_BOOTSTRAP_ENV_FILE=@NUWAX_CONFIG_DIR@/nuwax.env
Environment=NUWAX_LCM_BACKEND=real-lcm
Environment=NUWAX_REAL_LCM_REQUIRED=true
Environment=NUWAX_LCM_URL=udpm://239.255.76.67:7667?ttl=0
Environment=NUWAX_MOTION_GUARD_SOCKET=/run/nuwax/motion-guard.sock
Environment=NUWAX_NAV_STACK_READY_FILE=/run/nuwax/navigation/nuwax_nav_stack.ready
Environment=NUWAX_GEOMETRY_RUNTIME_READY_FILE=/run/nuwax/geometry/nuwax_geometry_runtime.ready
Environment=NUWAX_PERSON_FOLLOW_READY_FILE=/run/nuwax/person-follow/nuwax_person_follow.ready
Environment=NUWAX_PERSON_FOLLOW_TARGET_CHANNEL=/person_follow_target
Environment=NUWAX_PERSON_FOLLOW_POINTCLOUD_CHANNEL=/global_map
Environment=NUWAX_PERSON_FOLLOW_TF_CHANNEL=/tf
Environment=NUWAX_PERSON_FOLLOW_COMMAND_CHANNEL=/gateway/person_follow_cmd_vel
Environment=NUWAX_MOTION_GUARD_START_TIMEOUT_SEC=15
Environment=NUWAX_NAV_STACK_START_TIMEOUT_SEC=15
Environment=NUWAX_GEOMETRY_RUNTIME_PORT=50051
Environment=NUWAX_GEOMETRY_RUNTIME_HEALTH_TIMEOUT=30
Environment=NUWAX_PERSON_FOLLOW_WARMUP_STEPS=150
Environment=NUWAX_PERSON_FOLLOW_BINARY=@NUWAX_BIN_DIR@/nuwax-person-follow
Environment=NUWAX_PERSON_FOLLOW_START_TIMEOUT_SEC=15
EnvironmentFile=-@NUWAX_CONFIG_DIR@/nuwax.env
Environment=NUWAX_USER_CONFIG_ENV_FILE=/var/lib/nuwax_robot_bridge/settings.env
EnvironmentFile=-/var/lib/nuwax_robot_bridge/settings.env
# 活动方案最后加载；物化的业务值可由共同加载器和热加载入口更新。
Environment=NUWAX_ROBOT_PROFILE_MODE=1
Environment=NUWAX_CONFIG_FROM_SYSTEMD_FILES=1
EnvironmentFile=-@NUWAX_REPO_ROOT@/runtime_data/settings/active.env
# Channels stay unsuffixed here; nuwax-transport appends the declared LCM type.
ExecStartPre=/usr/bin/env /bin/bash @NUWAX_REPO_ROOT@/scripts/systemd/check_lcm_multicast.sh
ExecStartPre=/usr/bin/env /bin/bash @NUWAX_REPO_ROOT@/scripts/systemd/wait_for_motion_guard_socket.sh check nuwax nuwax
ExecStartPre=/usr/bin/env /bin/bash @NUWAX_REPO_ROOT@/scripts/systemd/wait_for_nav_stack_ready.sh wait
ExecStartPre=/usr/bin/env /bin/bash @NUWAX_REPO_ROOT@/scripts/systemd/wait_for_geometry_runtime_ready.sh wait
ExecStartPre=/usr/bin/rm -f /run/nuwax/person-follow/nuwax_person_follow.ready /run/nuwax/person-follow/nuwax_person_follow.ready.runtime
ExecStart=/usr/bin/env /bin/bash @NUWAX_REPO_ROOT@/scripts/systemd/start_person_follow.sh
ExecStartPost=/usr/bin/env /bin/bash @NUWAX_REPO_ROOT@/scripts/systemd/wait_for_person_follow_ready.sh wait
ExecStopPost=/usr/bin/rm -f /run/nuwax/person-follow/nuwax_person_follow.ready /run/nuwax/person-follow/nuwax_person_follow.ready.runtime
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
FinalKillSignal=SIGKILL
TimeoutStopSec=20
SuccessExitStatus=0
ReadWritePaths=/run/nuwax/person-follow /tmp

[Install]
WantedBy=multi-user.target
