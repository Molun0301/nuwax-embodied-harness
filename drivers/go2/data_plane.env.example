# Nuwax 机器人平台设置示例。复制后仅修改需要覆盖的设置。
# 设置名称、键名、默认值与生效范围可在机器人控制台查看。
# 环境变量优先于文件；修改后重启对应服务。


# 日志
# Go2 视频日志级别
GO2_VIDEO_STREAM_LOG_LEVEL=INFO

# Go2 数据面·输入流
# 启用 Go2 数据面
GO2_DATA_PLANE_ENABLED=false
# 启用 Go2 直连 DDS
GO2_DIRECT_DDS_ENABLED=true
# Go2 数据面 DDS 网卡
GO2_DATA_PLANE_DDS_IFACE=
# Go2 低状态 DDS 话题
GO2_DIRECT_DDS_LOW_STATE_TOPIC=rt/lowstate
# Go2 单次扫描最大点数
GO2_DIRECT_DDS_MAX_POINTS_PER_SCAN=1200
# 启用 Go2 DDS 点云
GO2_DIRECT_DDS_POINT_CLOUD_ENABLED=false
# Go2 DDS 点云话题
GO2_DIRECT_DDS_POINT_CLOUD_TOPIC=rt/utlidar/cloud
# Go2 点云 XYZ 已注册到 odom
GO2_DIRECT_DDS_POINT_CLOUD_XYZ_REGISTERED_TO_ODOM=false
# Go2 姿态 DDS 话题
GO2_DIRECT_DDS_POSE_TOPIC=rt/sportmodestate
# Go2 DDS 读取超时（秒）
GO2_DIRECT_DDS_READ_TIMEOUT_SEC=0.5
# Go2 IMU 陀螺仪死区（弧度/秒）
GO2_IMU_GYRO_DEADBAND_RPS=0.003490658503988659

# Go2 数据面·官方控制
# 启用 Go2 官方控制后端
GO2_OFFICIAL_BACKEND_ENABLED=true
# 默认启用 Go2 官方避障
GO2_OFFICIAL_OBSTACLE_AVOIDANCE_DEFAULT_ENABLED=false
# Go2 官方客户端超时（秒）
GO2_OFFICIAL_CLIENT_TIMEOUT_SEC=3.0
# Go2 官方最大线速度（米/秒）
GO2_OFFICIAL_MAX_LINEAR_VELOCITY_MPS=1.0
# Go2 官方最大偏航角速度（弧度/秒）
GO2_OFFICIAL_MAX_YAW_RATE_RPS=0.8
# 自动启动 Go2 官方服务
GO2_OFFICIAL_SERVICES_AUTO_START=false
# Go2 官方服务名称
GO2_OFFICIAL_SERVICE_NAMES=obstacles_avoid
# Go2 官方偏航角速度死区（弧度/秒）
GO2_OFFICIAL_YAW_RATE_DEADBAND_RPS=0.003490658503988659

# Go2 数据面·视频推流
# Go2 本体 WebRTC 信令 IPv4 地址
GO2_ROBOT_IP=192.168.123.161
# 启用视频推流
GO2_VIDEO_STREAM_ENABLED=true
# Go2 视频重连间隔（秒）
GO2_VIDEO_STREAM_RECONNECT_SEC=1.0
# Go2 WebRTC AES-128 密钥
GO2_WEBRTC_AES_128_KEY=

# Go2专属外参；按驱动与传感器的实际安装关系填写。
# 惯性传感器到机体外参
NUWAX_GEOMETRY_LIO_BODY_FROM_IMU=
# 激光雷达到机体外参
NUWAX_GEOMETRY_LIO_BODY_FROM_SENSOR=
