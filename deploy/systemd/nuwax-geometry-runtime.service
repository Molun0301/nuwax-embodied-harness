[Unit]
Description=nuwax-geometry-runtime（LCM-first geometry native runtime）
# 独立进程顺序固定为 guard -> nav-stack -> geometry runtime -> Gateway。
Requires=nuwax-motion-safety-guard.service nuwax-nav-stack.service
After=network-online.target nuwax-motion-safety-guard.service nuwax-nav-stack.service
Wants=network-online.target

[Service]
Type=simple
User=nuwax-geometry
Group=nuwax-geometry
SupplementaryGroups=nuwax-motion-clients
WorkingDirectory=/home/unitree/nuwax-robot-bridge
RuntimeDirectory=nuwax/geometry
RuntimeDirectoryMode=0750
UMask=0007
Environment=PYTHONUNBUFFERED=1
# Phase 8 §13.2 / §13.5:production profile 必须显式启用 real-lcm 并打开
# fail-fast 硬约束,避免 Rust runtime 静默回退 fake-lcm 或启动期 placeholder 退出。
# 缺 liblcm / 缺 udpm multicast 应当作真实失败,由 systemd 触发 Restart=on-failure。
Environment=NUWAX_LCM_BACKEND=real-lcm
Environment=NUWAX_REAL_LCM_REQUIRED=true
Environment=NUWAX_LCM_URL=udpm://239.255.76.67:7667?ttl=1
Environment=NUWAX_MOTION_GUARD_SOCKET=/run/nuwax/motion-guard.sock
Environment=NUWAX_GEOMETRY_RUNTIME_READY_FILE=/run/nuwax/geometry/nuwax_geometry_runtime.ready
ExecStartPre=/bin/bash /home/unitree/nuwax-robot-bridge/scripts/systemd/wait_for_motion_guard_socket.sh check
ExecStartPre=/bin/bash /home/unitree/nuwax-robot-bridge/scripts/systemd/wait_for_nav_stack_ready.sh wait
ExecStartPre=/usr/bin/rm -f /run/nuwax/geometry/nuwax_geometry_runtime.ready
ExecStart=/home/unitree/nuwax-robot-bridge/services/geometry/nuwax_geometry_runtime/target/release/nuwax-geometry-runtime
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
ReadWritePaths=/run/nuwax/geometry /tmp /var/lib/nuwax_robot_bridge
# Phase 8 §13.2 修正:不再把 real-lcm fail-fast code(4) 当 SuccessExitStatus。
# 启动期缺 liblcm / 缺 udpm multicast 应被 systemd 视为真实失败并触发
# Restart=on-failure,只有 exit 0 算 success。
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
