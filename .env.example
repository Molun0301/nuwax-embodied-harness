NUWAX_PERCEPTION_SEGMENTATION_SCORE_THRESHOLD=0.5
# stability score threshold  [高级]
NUWAX_PERCEPTION_SEGMENTATION_STABILITY_SCORE_THRESHOLD=0.5
# api key  [高级 / 敏感·留空]
OPENAI_API_KEY=

# ==================================================
# 【感知·关键帧与流】
# ==================================================
# auto start
NUWAX_PERCEPTION_STREAM_AUTO_START=false
# enabled：持续视频感知运行时
NUWAX_PERCEPTION_STREAM_ENABLED=true
# interval sec
NUWAX_PERCEPTION_STREAM_INTERVAL_SEC=0.5
# frame count：到点 burst 复核  [高级]
NUWAX_PERCEPTION_BURST_FRAME_COUNT=4
# interval sec  [高级]
NUWAX_PERCEPTION_BURST_INTERVAL_SEC=0.08
# default detector backend  [高级]
NUWAX_PERCEPTION_DEFAULT_DETECTOR_BACKEND=yolo_world
# default scene backend  [高级]
NUWAX_PERCEPTION_DEFAULT_SCENE_BACKEND=hybrid_scene
# default segmentation backend：实例分割（默认整体关闭；settings.py:753-847）  [高级]
NUWAX_PERCEPTION_DEFAULT_SEGMENTATION_BACKEND=segmentation_disabled
# delayed pc max concurrency  [高级]
NUWAX_PERCEPTION_DELAYED_PC_MAX_CONCURRENCY=2
# delayed pc max range m  [高级]
NUWAX_PERCEPTION_DELAYED_PC_MAX_RANGE_M=8.0
# delayed pc max retry  [高级]
NUWAX_PERCEPTION_DELAYED_PC_MAX_RETRY=3
# delayed pc min points：延迟点云重投影参数  [高级]
NUWAX_PERCEPTION_DELAYED_PC_MIN_POINTS=5
# delayed pc refine interval sec  [高级]
NUWAX_PERCEPTION_DELAYED_PC_REFINE_INTERVAL_SEC=6.0
# history limit  [高级]
NUWAX_PERCEPTION_HISTORY_LIMIT=100
# min interval sec：关键帧策略  [高级]
NUWAX_PERCEPTION_KEYFRAME_MIN_INTERVAL_SEC=1.0
# remember enabled  [高级]
NUWAX_PERCEPTION_KEYFRAME_REMEMBER_ENABLED=true
# translation m  [高级]
NUWAX_PERCEPTION_KEYFRAME_TRANSLATION_M=0.75
# yaw deg  [高级]
NUWAX_PERCEPTION_KEYFRAME_YAW_DEG=20.0
# camera id  [高级]
NUWAX_PERCEPTION_STREAM_CAMERA_ID=front_camera
# detector backend  [高级]
NUWAX_PERCEPTION_STREAM_DETECTOR_BACKEND=
# failure backoff sec  [高级]
NUWAX_PERCEPTION_STREAM_FAILURE_BACKOFF_SEC=2.0
# store artifact  [高级]
NUWAX_PERCEPTION_STREAM_STORE_ARTIFACT=false
# 定位模式下跳过后台感知自动调度
NUWAX_PERCEPTION_STREAM_SKIP_WHEN_LOCALIZATION=true
# 启用检测 NMS 后处理  [高级]
NUWAX_PERCEPTION_POSTPROCESS_NMS_ENABLED=true
# 检测 NMS IOU 阈值  [高级]
NUWAX_PERCEPTION_POSTPROCESS_NMS_IOU=0.6
# triangulation max residual m  [高级]
NUWAX_PERCEPTION_TRIANGULATION_MAX_RESIDUAL_M=0.5
# triangulation min parallax deg  [高级]
NUWAX_PERCEPTION_TRIANGULATION_MIN_PARALLAX_DEG=5.0
# triangulation min rays：射线三角化参数  [高级]
NUWAX_PERCEPTION_TRIANGULATION_MIN_RAYS=2

