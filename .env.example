# =========================
# nuwax_robot_bridge 主配置文件（项目/平台层）
# 说明：
# 1. 这里是平台层统一配置入口（NUWAX_* 配置域），由 core/settings.py 读取。
# 2. 格式统一为 KEY=VALUE；# 开头为注释；同名环境变量优先级最高。
# 3. Go2 端侧设备面配置（GO2_* 驱动键）统一在 drivers/go2/data_plane.env 维护，不在本文件暴露。
# =========================

# -------------------------
# 当前激活机器人入口
# 说明：
# 1. 该值必须与 drivers/<robot_name> 文件夹同名。
# 2. 统一入口会按这个名字装配对应机器人实现。
# -------------------------
NUWAX_ACTIVE_ROBOT=go2

# -------------------------
# 平台几何引擎配置
# 说明：
# 1. 默认使用 external_slam_nav2，由 go2.sh 启动 GO2 RTAB-Map + Nav2 栈。
# 2. 这一组配置供平台 geometry 侧车与 go2.sh 共用。
# 3. geometry ROS2 工作空间路径对应 services/geometry/ros2_ws。
# -------------------------
NUWAX_GEOMETRY_ENABLED=true
# Geometry Runtime owner profile：3×2×4 共 24 个结构有效组合；原生后端还要求部署制品与传感器参数通过启动预检。
NUWAX_GEOMETRY_LIO_BACKEND=device                     # device | fastlio2 | pointlio
NUWAX_GEOMETRY_MAPPING_BACKEND=voxel                  # voxel | raytracing
NUWAX_GEOMETRY_CORRECTION_BACKEND=none                # none | library_pgo | native_pgo | relocalization
NUWAX_GEOMETRY_STACK=external_slam_nav2
NUWAX_GEOMETRY_REQUIRE_ROS2=true
NUWAX_ROS_SETUP_SCRIPT=
NUWAX_GEOMETRY_SETUP_SCRIPT=/home/unitree/nuwax-robot-bridge/services/geometry/ros2_ws/install/setup.bash
NUWAX_GEOMETRY_GO2SLAM_SETUP_SCRIPT=/home/unitree/nuwax-robot-bridge/services/geometry/ros2_ws/src/GO2_RTABNAV2/ws/install/setup.bash
NUWAX_GEOMETRY_CYCLONEDDS_LIB_DIR=
NUWAX_GEOMETRY_DDS_IFACE=eth0

# --- go2.sh 注入 GO2 RTAB-Map / Nav2 栈（改这里即可，无需改 launch 源码）---
NUWAX_GEOMETRY_ODOM_TOPIC=/utlidar/robot_odom
NUWAX_GEOMETRY_POINT_CLOUD_TOPIC=/utlidar/cloud_deskewed
NUWAX_GEOMETRY_SCAN_TOPIC=/scan                        # cloud_to_scan 输出 + Nav2 costmap 激光
NUWAX_GEOMETRY_PLAN_TOPIC=/plan                          # debug 面板 / observer 订阅 Nav2 全局规划路径
NUWAX_GEOMETRY_OCCUPANCY_TOPIC=/map_obstacles
NUWAX_GEOMETRY_MAP_FRAME=map
NUWAX_GEOMETRY_ODOM_FRAME=odom
NUWAX_GEOMETRY_BASE_FRAME=go2_base_link
NUWAX_GEOMETRY_POSE_TOPIC=/go2/pose_map
NUWAX_GEOMETRY_LIDAR_FRAME=go2_base_link
NUWAX_GEOMETRY_IMU_TOPIC=/utlidar/imu
NUWAX_GEOMETRY_ROBOT_RADIUS=0.30                         # Nav2 圆形本体半径 (m)，对齐 go2_slam_nav nav2_params_go2.yaml
NUWAX_GEOMETRY_INFLATION_RADIUS=0.85                     # Nav2 障碍物膨胀半径 (m)，对齐 go2_slam_nav nav2_params_go2.yaml
NUWAX_GEOMETRY_INFLATION_COST_SCALING=2.5                # Nav2 inflation_layer cost_scaling_factor
NUWAX_GEOMETRY_EXPLORATION_MIN_FRONTIER_SIZE=10          # 保留字段；GO2_RTABNAV2 探索由 explore_lite 参数控制
NUWAX_GEOMETRY_EXPLORATION_FAILURES_BEFORE_RELAXED=5     # 保留字段；standalone frontier_explorer 不使用分级失败策略
NUWAX_GEOMETRY_EXPLORATION_FAILURES_BEFORE_CORRIDOR=5    # 保留字段；standalone frontier_explorer 不使用分级失败策略
NUWAX_GEOMETRY_EXPLORATION_FAILURES_BEFORE_RETRY=5       # 保留字段；standalone frontier_explorer 不使用分级失败策略
NUWAX_GEOMETRY_EXPLORATION_BOOTSTRAP_FORWARD_M=0.2       # 保留字段；standalone frontier_explorer 不使用 bootstrap
NUWAX_GEOMETRY_EXPLORATION_MIN_NAV_COMMIT_SEC=15.0       # 保留字段；standalone frontier_explorer 不使用 nav commit
NUWAX_GEOMETRY_EXPLORATION_MAX_GOAL_RETRIES=4            # 保留字段；standalone frontier_explorer 不使用 goal retry
NUWAX_GEOMETRY_EXPLORATION_POST_GOAL_PAUSE_SEC=0         # 保留字段；standalone frontier_explorer 不使用 post-goal pause
NUWAX_GEOMETRY_EXPLORATION_MIN_TRAVEL_M=0.5              # 保留字段；standalone frontier_explorer 脚本默认 0.5，launch 未覆盖
NUWAX_GEOMETRY_EXPLORATION_GOAL_SETBACK_M=0              # 保留字段；standalone frontier_explorer 不使用 goal setback

# --- 平台 geometry 侧车专用（go2.sh 不读取）---
NUWAX_GEOMETRY_SECONDARY_ODOM_TOPICS=/uslam/localization/odom,/lio_sam_ros2/mapping/odometry,/odom_lio
NUWAX_GEOMETRY_TF_TOPIC=/tf
NUWAX_GEOMETRY_TF_STATIC_TOPIC=/tf_static
NUWAX_GEOMETRY_COST_MAP_TOPIC=/global_costmap/costmap

# -------------------------
# ROS2 衍生死键（2026-07-09 drop-ros2 后端栈全面下线，已无任何消费者）：
#   - NUWAX_BACKEND_* (5)：原为 ROS2 RTAB-Map 栈启动入口（rtabmap_ros + rtabmap.launch.py）
#   - NUWAX_NAV2_* (9)：Nav2 启动入口（nav2_bringup + navigation_launch.py）
#   - NUWAX_GEOMETRY_EXTERNAL_SCRIPT / ARGS / FRONTIER_TOPIC：external_slam_nav2 外部脚本包装
#   - NUWAX_GEOMETRY_EXTERNAL_INPUT_BRIDGE / POINT_CLOUD_BRIDGE_ENABLED：平台点云桥（栈未自带时启用）
#   - NUWAX_GEOMETRY_EXTERNAL_PROCESS_NAME / LOG_NAME：外部栈进程管理元数据
#   - NUWAX_CLOUD_MAP_TOPIC：legacy alias（已被 NUWAX_GEOMETRY_CLOUD_MAP_TOPIC 替代）
# RTAB-Map 重建为 nuwax-mapping crate（Rust），配置面已迁移到 NUWAX_MAPPING_*（详见下方 mapping 段）
# -------------------------

# legacy NUWAX_CLOUD_MAP_TOPIC 已被 NUWAX_GEOMETRY_CLOUD_MAP_TOPIC 替代（下方映射段）
NUWAX_GEOMETRY_CLOUD_MAP_TOPIC=/cloud_map
# /map_obstacles 不烙 live 扫描；实时避障由 Nav2 local voxel_layer(/go2/cloud) 负责
GO2_OBSTACLE_GRID_LIVE_CLOUD_ENABLED=false
GO2_OBSTACLE_GRID_PUBLISH_ON_CLOUD=false
# GO2_NAV_* 已废弃（审批项 D）；GO2_RTABNAV2 由 go2.sh 传 localize_only/restart_map/slam_mode

# -------------------------
# Rust bridge 直接订阅 Go2 原生话题配置
# 说明：
# 1. bridge 使用 CycloneDDS RMW 直接订阅 Go2 原生 DDS 话题，无需 Python SDK 中转。
# 2. 设置 NUWAX_GO2_DIRECT_SUBSCRIBE=false 回退到 Python gRPC 推送模式。
# -------------------------
NUWAX_GO2_DIRECT_SUBSCRIBE=true
NUWAX_GO2_ODOM_SOURCE=/utlidar/robot_odom
NUWAX_GO2_POINTCLOUD_SOURCE=/utlidar/cloud
NUWAX_ODOM_TOPIC=/odom
NUWAX_POINTCLOUD_TOPIC=/utlidar/cloud_base

# external_slam_nav2 默认外部 SLAM/Nav2 栈说明：
# start_go2_slam_nav2.sh 会在外部 SLAM/Nav2 子进程内默认使用 rmw_cyclonedds_cpp；
# 不要在网关 .env 全局设置 RMW_IMPLEMENTATION，避免影响 Unitree SDK ChannelFactory 初始化。
# start_go2_slam_nav2.sh 已启动 go2_driver，通常不要再让网关桥发布同名 /utlidar/cloud_deskewed。
# 不要让网关点云桥和 go2_driver 同时发布同名点云话题，否则 cloud_accumulation 可能收到混合 PointCloud2 格式。
# 如果机器上没有独立 Unitree ROS2 驱动发布外部栈输入话题，可开启平台输入桥：
# NUWAX_GEOMETRY_EXTERNAL_INPUT_BRIDGE_ENABLED=true
# NUWAX_GEOMETRY_EXTERNAL_POINT_CLOUD_BRIDGE_ENABLED=true

# -------------------------
# 日志配置
# 说明：
# 1. 部署时直接配置 NUWAX_LOG_*。
# 2. 日志目录和日志文件建议与 systemd 或手工启动时的落盘路径保持一致。
# -------------------------
NUWAX_LOG_DIR=/var/log/nuwax/gateway
NUWAX_LOG_FILE=/var/log/nuwax/gateway/nuwax_robot_bridge.log
NUWAX_LOG_LEVEL=DEBUG
NUWAX_LOG_MAX_LINES=100000
NUWAX_LOG_TRIM_CHECK_INTERVAL=200

# -------------------------
# 宿主机网关配置
# 说明：
# 1. 这是给容器内 nuwaclaw / relay 调用的正式入口。
# 2. token 请与容器内配置保持一致。
# 3. 这里把常见 Docker 网段放宽到 172.16.0.0/12，避免 bridge 网络切换后再次 403。
# -------------------------
NUWAX_PYTHON_BIN=python3
NUWAX_GATEWAY_HOST=0.0.0.0
NUWAX_GATEWAY_PORT=8766
NUWAX_GATEWAY_PUBLIC_BASE_URL=http://host.docker.internal:8766
NUWAX_GATEWAY_ARTIFACT_DIR=/var/lib/nuwax/gateway/artifacts
NUWAX_GATEWAY_AGENT_TOKENS=agent-robot-bridge-token
NUWAX_GATEWAY_ADMIN_TOKENS=admin-robot-bridge-token
NUWAX_GATEWAY_AGENT_HIGH_RISK_ALLOWLIST=
NUWAX_GATEWAY_ALLOWED_SOURCE_CIDRS=0.0.0.0/0
NUWAX_GATEWAY_ALLOW_UNKNOWN_CLIENT_HOSTS=false
NUWAX_GATEWAY_SSE_KEEPALIVE_SEC=10.0
NUWAX_GATEWAY_WS_PING_INTERVAL_SEC=15.0

# -------------------------
# 容器内 relay 配置
# 说明：
# 1. 默认关闭，只有在容器内额外跑 relay 时才启用。
# 2. upstream token 一般直接复用 agent token。
# -------------------------
NUWAX_RELAY_ENABLED=false
NUWAX_RELAY_HOST=127.0.0.1
NUWAX_RELAY_PORT=9766
NUWAX_RELAY_UPSTREAM_BASE_URL=http://host.docker.internal:8766
NUWAX_RELAY_INCOMING_TOKENS=agent-robot-bridge-token
NUWAX_RELAY_UPSTREAM_TOKEN=agent-robot-bridge-token

# -------------------------
# 运行时数据与制品保留策略
# -------------------------
NUWAX_STATE_HISTORY_LIMIT=200
NUWAX_DIAGNOSTIC_HISTORY_LIMIT=200
NUWAX_OBSERVATION_HISTORY_LIMIT=100
NUWAX_PERCEPTION_HISTORY_LIMIT=100
NUWAX_LOCALIZATION_HISTORY_LIMIT=100
NUWAX_MAP_CATALOG_ROOT=/var/lib/nuwax/gateway/maps
NUWAX_MAP_AUTO_CREATE_LIBRARY=true
NUWAX_ACTIVE_MAP_RESTORE_ON_START=false
NUWAX_MAP_DELETE_ALSO_DELETE_LIBRARY=true
NUWAX_NAVIGATION_HISTORY_LIMIT=100
NUWAX_MEMORY_HISTORY_LIMIT=200
NUWAX_MEMORY_DB_PATH=/var/lib/nuwax/gateway/memory/vector_memory.db
NUWAX_MEMORY_TEXT_EMBEDDING_MODEL=tongyi-embedding-vision-flash-2026-03-06
NUWAX_MEMORY_TEXT_EMBEDDING_DIM=768
NUWAX_MEMORY_IMAGE_EMBEDDING_MODEL=tongyi-embedding-vision-flash-2026-03-06
NUWAX_MEMORY_IMAGE_EMBEDDING_DIM=768
NUWAX_MEMORY_EMBEDDING_API_KEY=sk-edd9540347ee4f0ebc39fd81eb03d98f
NUWAX_MEMORY_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
NUWAX_MEMORY_EMBEDDING_TIMEOUT_SEC=20.0
NUWAX_MEMORY_VECTOR_STORE_BACKEND=sqlite_named_vectors
# 默认：
# 1. 记忆库在上层显式启用后才会初始化向量模型。
# 2. 文本与图像向量默认使用 tongyi-embedding-vision-flash-2026-03-06。
# 3. 需要在线向量时，请配置 NUWAX_MEMORY_EMBEDDING_API_KEY 或 DASHSCOPE_API_KEY。
# 4. 如果 API Key 留空，运行时会使用 hashing 文本向量并关闭图像向量链路，同时在日志中给出提示。
# 5. 如果使用本地模型目录，可把 TEXT/IMAGE 模型名改成项目内路径，例如 runtime_data/models/BAAI__bge-m3 与 runtime_data/models/openai__clip-vit-base-patch32。
# 6. 如需提前准备本地模型，请运行 scripts/prepare_memory_models.py。
NUWAX_ARTIFACT_RETENTION_DAYS=7
NUWAX_ARTIFACT_MAX_COUNT=1000
NUWAX_ARTIFACT_MAX_TOTAL_BYTES=1073741824
NUWAX_ARTIFACT_CLEANUP_BATCH_SIZE=200

# -------------------------
# 感知与视觉识别配置
# 说明：
# 1. 仓库不内置 YOLO-World 权重，请先按部署文档准备到 runtime_data/models/。
# 2. 本地检测默认优先使用 YOLO-World + ByteTrack，负责开放词汇检测与跨帧跟踪。
# 3. 如需切换别的本地检测器，继续通过 DetectorBackend 扩展即可。
# 4. 云端语义识别统一走 OpenAI SDK 接口风格，适合对接 OpenAI 及同类服务。
# 5. 默认主线不是“每帧重检测”，而是“关键帧驱动 + 到点 burst 复核”。
# -------------------------
NUWAX_PERCEPTION_DEFAULT_DETECTOR_BACKEND=yolo_world
NUWAX_PERCEPTION_DEFAULT_SCENE_BACKEND=hybrid_scene

NUWAX_PERCEPTION_YOLO_WORLD_ENABLED=true
NUWAX_PERCEPTION_YOLO_WORLD_BACKEND_NAME=yolo_world
# 模型文件后缀即推理链路：.pt → PyTorch(YOLOWorld 开放词汇，set_classes 生效)；.engine → TensorRT(YOLO，类别固化)
NUWAX_PERCEPTION_YOLO_WORLD_MODEL=/home/unitree/nuwax-robot-bridge/runtime_data/models/yolov8s-worldv2.engine
NUWAX_PERCEPTION_YOLO_WORLD_DEVICE=0
NUWAX_PERCEPTION_YOLO_WORLD_IMAGE_SIZE=640
NUWAX_PERCEPTION_YOLO_WORLD_CONFIDENCE=0.40
NUWAX_PERCEPTION_YOLO_WORLD_IOU=0.30
NUWAX_PERCEPTION_YOLO_WORLD_MAX_DETECTIONS=30
NUWAX_PERCEPTION_YOLO_WORLD_CLASSES=person,door,chair,table,box,cup
NUWAX_PERCEPTION_YOLO_WORLD_DYNAMIC_CLASS_KEYS=target_classes,open_vocabulary_classes
NUWAX_PERCEPTION_TRACKER_BACKEND=bytetrack
# YOLO-World 动态类别别名（CSV，默认空）
NUWAX_PERCEPTION_YOLO_WORLD_ALIASES=

# ByteTrack 跟踪器参数
NUWAX_PERCEPTION_BYTETRACK_NAME=go2_bytetrack_tracker
NUWAX_PERCEPTION_BYTETRACK_HIGH_THRESHOLD=0.5
NUWAX_PERCEPTION_BYTETRACK_LOW_THRESHOLD=0.1
NUWAX_PERCEPTION_BYTETRACK_IOU=0.3
NUWAX_PERCEPTION_BYTETRACK_LOST_TTL_FRAMES=30
NUWAX_PERCEPTION_BYTETRACK_TRAJECTORY_LIMIT=12

# 实例分割（默认整体关闭）
NUWAX_PERCEPTION_DEFAULT_SEGMENTATION_BACKEND=segmentation_disabled
NUWAX_PERCEPTION_SEGMENTATION_ENABLED=false
NUWAX_PERCEPTION_SEGMENTATION_BACKEND_NAME=
NUWAX_PERCEPTION_SEGMENTATION_BACKEND_KIND=disabled_segmentation
NUWAX_PERCEPTION_SEGMENTATION_ROUTE=primary
NUWAX_PERCEPTION_SEGMENTATION_PRIMARY_BACKEND_NAME=groundingdino_sam2
NUWAX_PERCEPTION_SEGMENTATION_LOW_LATENCY_BACKEND_NAME=yolo_world_sam2
NUWAX_PERCEPTION_SEGMENTATION_ALLOW_BBOX_ONLY_FALLBACK=true
NUWAX_PERCEPTION_SEGMENTATION_SCORE_THRESHOLD=0.5
NUWAX_PERCEPTION_SEGMENTATION_PREDICTED_IOU_THRESHOLD=0.5
NUWAX_PERCEPTION_SEGMENTATION_STABILITY_SCORE_THRESHOLD=0.5
NUWAX_PERCEPTION_SEGMENTATION_DEPTH_COVERAGE_THRESHOLD=0.2
NUWAX_PERCEPTION_SEGMENTATION_MAP_PROJECTION_COVERAGE_THRESHOLD=0.2
NUWAX_PERCEPTION_SEGMENTATION_REPROJECTION_ERROR_THRESHOLD_PX=8.0
NUWAX_PERCEPTION_SEGMENTATION_EMIT_RAW_MASK=false
NUWAX_PERCEPTION_SEGMENTATION_EMIT_POLYGON=true
NUWAX_PERCEPTION_SEGMENTATION_EMIT_QUALITY_DETAILS=true
NUWAX_PERCEPTION_SEGMENTATION_EMIT_RUNTIME_SUMMARY=true
NUWAX_PERCEPTION_SEGMENTATION_POLYGON_SIMPLIFICATION_EPSILON_PX=2.0

NUWAX_PERCEPTION_OPENAI_ENABLED=false
NUWAX_PERCEPTION_OPENAI_BACKEND_NAME=openai_vision
NUWAX_PERCEPTION_OPENAI_BASE_URL=https://api.openai.com/v1
NUWAX_PERCEPTION_OPENAI_API_KEY=
NUWAX_PERCEPTION_OPENAI_MODEL=
NUWAX_PERCEPTION_OPENAI_API_STYLE=auto
NUWAX_PERCEPTION_OPENAI_TIMEOUT_SEC=20.0
NUWAX_PERCEPTION_OPENAI_MAX_TOKENS=1400
NUWAX_PERCEPTION_OPENAI_TEMPERATURE=0.0

# 持续视频感知运行时
NUWAX_PERCEPTION_STREAM_ENABLED=true
NUWAX_PERCEPTION_STREAM_AUTO_START=false
NUWAX_PERCEPTION_STREAM_CAMERA_ID=front_camera
NUWAX_PERCEPTION_STREAM_INTERVAL_SEC=0.25
NUWAX_PERCEPTION_STREAM_DETECTOR_BACKEND=
NUWAX_PERCEPTION_STREAM_STORE_ARTIFACT=false
NUWAX_PERCEPTION_STREAM_FAILURE_BACKOFF_SEC=2.0
# 定位模式(rtabmap_localization)下默认不联动后台感知线程；手动 start_perception_runtime MCP 绕过该门控
NUWAX_PERCEPTION_STREAM_SKIP_WHEN_LOCALIZATION=true

# 关键帧策略
# 说明：纯位姿门控——首帧 bootstrap 记录一次基准位姿，之后每次平移或旋转超阈值更新一次；
#       位姿尚未就绪时等待，拿到首个有效位姿即锚定基准。无“最大间隔”兜底。
NUWAX_PERCEPTION_KEYFRAME_MIN_INTERVAL_SEC=1.0
NUWAX_PERCEPTION_KEYFRAME_TRANSLATION_M=0.75
NUWAX_PERCEPTION_KEYFRAME_YAW_DEG=20.0
NUWAX_PERCEPTION_KEYFRAME_REMEMBER_ENABLED=true

# 到点 burst 复核
NUWAX_PERCEPTION_BURST_FRAME_COUNT=4
NUWAX_PERCEPTION_BURST_INTERVAL_SEC=0.08

# -------------------------
# 延迟投影（多观测聚合定位）
# 说明：YOLO-World 2D 检测瞬间 bbox 常无激光点覆盖 → 实时投影退化为机器人位姿(误差几米)。
# 延迟投影用多观测累积求更准坐标。单轴策略(消除无意义组合)：
#   disabled            ：仅现有实时点云链(=现状，向后兼容)
#   triangulation       ：多视角射线三角化(L2 主推，不等点云，置信≤0.7)
#   delayed_pointcloud  ：延迟点云重投影(等累积点云稠密，锥内取点，置信0.85)
#   triangulation_first ：三角化即时 + 点云累积后 cross-validation(求更高精度)
# -------------------------
NUWAX_PERCEPTION_DEFERRED_STRATEGY=triangulation_first
# 射线三角化参数
NUWAX_PERCEPTION_TRIANGULATION_MIN_RAYS=2
NUWAX_PERCEPTION_TRIANGULATION_MIN_PARALLAX_DEG=5.0
NUWAX_PERCEPTION_TRIANGULATION_MAX_RESIDUAL_M=0.5
# 延迟点云重投影参数
NUWAX_PERCEPTION_DELAYED_PC_MIN_POINTS=5
NUWAX_PERCEPTION_DELAYED_PC_MAX_RETRY=3
NUWAX_PERCEPTION_DELAYED_PC_MAX_RANGE_M=8.0
NUWAX_PERCEPTION_DELAYED_PC_REFINE_INTERVAL_SEC=6.0
NUWAX_PERCEPTION_DELAYED_PC_MAX_CONCURRENCY=2
# triangulation_first cross-validation 阈值(三角化与点云坐标分歧>此值则降置信)
NUWAX_PERCEPTION_DEFERRED_XVAL_THRESHOLD_M=0.3

# -------------------------
# 视频共享内存 / Unix socket 路径（gateways/ws/data_streams.py、ros_bridge_client.py）
# -------------------------
NUWAX_VIDEO_SHM_PATH=/tmp/nuwax_video.shm
NUWAX_VIDEO_UDS_PATH=/tmp/nuwax_video.sock
# PCD 导出参数（cloud_map_fetcher.py）
NUWAX_PCD_MIN_POINTS=500
# NUWAX_CLOUD_MAP_FETCH_TIMEOUT_SEC 已物理删（PCD 导出链切到 Rust nuwax-mapping，Python cloud_map_fetcher.py 已下线）
NUWAX_PCD_DB_EXPORT_TIMEOUT_SEC=45
NUWAX_PCD_DB_EXPORT_TIMEOUT_SEC=45
NUWAX_PCD_EXPORT_FROM_DB=true
# Rust 桥环境脚本（留空走默认推导）
NUWAX_ROS_BRIDGE_ENV_SCRIPT=
# 后端数据库绝对路径（留空则由 BACKEND_DATABASE_ROOT 推导）
# NUWAX_BACKEND_DATABASE_PATH 已物理删（settings.py 1027 起读 NUWAX_BACKEND_DATABASE_ROOT + NUWAX_BACKEND_DATABASE_FILE，旧的 BACKEND_DATABASE_PATH 复合键下线）

# -------------------------
# DDS 配置
# 说明：
# 1. 平台层只保留 CycloneDDS URI（start_gateway.sh 直接 grep 本文件读取并导出）。
# 2. Go2 端侧专属变量（GO2_DDS_IFACE / GO2_SDK_PATH / GO2_ROBOT_IP / GO2_LOW_LEVEL_* /
#    GO2_VOLUME_* / GO2_VUI_* / GO2_INIT_VOLUME_ON_START / GO2_AUDIO_COMMAND_TIMEOUT）
#    统一在 drivers/go2/data_plane.env 维护，不在本文件暴露。
# -------------------------
CYCLONEDDS_URI=<CycloneDDS><Domain><Compatibility><StandardsConformance>lax</StandardsConformance></Compatibility></Domain></CycloneDDS>

# 机器人地址别名（平台层通用；Go2 专属 GO2_ROBOT_IP 在 data_plane.env 维护）
ROBOT_IP=

# --- 由 Web 配置面板追加 ---
NUWAX_GATEWAY_TELEMETRY_INCLUDE_PROCESS_TREE=true
NUWAX_GATEWAY_TELEMETRY_ENABLED=true

# --- 由 Web 配置面板追加 ---
GO2_LOW_LEVEL_INTERVAL_SEC=0.002
GO2_LOW_LEVEL_KD=5.0
GO2_LOW_LEVEL_KP=60.0
GO2_LOW_LEVEL_MAX_TORQUE=10.0
GO2_LOW_LEVEL_MAX_VELOCITY=2.0
GO2_SDK_PATH=/home/unitree/.local/lib/python3.8/site-packages
GO2_VOLUME_AUTO_ENABLE_VUI_SWITCH=true
GO2_VUI_MAX_LEVEL=10
GO2_VUI_MIN_LEVEL=0
NUWAX_GATEWAY_HIGH_RISK_ALLOWLIST=
NUWAX_GATEWAY_TELEMETRY_INTERVAL_SEC=2.0
NUWAX_GATEWAY_TELEMETRY_PROCESS_KEYWORDS=gateway,robot_bridge
GO2_PROXY_LOG_DIR=/var/log/nuwax/gateway
GO2_PROXY_LOG_FILE=/var/log/nuwax/gateway/nuwax_robot_bridge.log
GO2_PROXY_LOG_LEVEL=INFO
GO2_PROXY_LOG_MAX_LINES=100000
GO2_PROXY_LOG_TRIM_CHECK_INTERVAL=200
NUWAX_GEOMETRY_IMU_FRAME=utlidar_imu
NUWAX_GEOMETRY_MIN_TRAVERSABILITY_SCORE=0.5
NUWAX_GEOMETRY_ODOM_MAX_AGE_SEC=0.5
NUWAX_GEOMETRY_ODOM_MAX_ANGULAR_COVARIANCE=1.0
NUWAX_GEOMETRY_ODOM_MAX_LINEAR_COVARIANCE=1.0
NUWAX_GEOMETRY_ODOM_QUALITY_SOURCE=topic_covariance
NUWAX_GEOMETRY_ODOM_REQUIRE_COVARIANCE=false
NUWAX_GEOMETRY_PLATFORM_CMD_VEL_BRIDGE_ENABLED=false
NUWAX_GEOMETRY_PLATFORM_ODOM_TF_BRIDGE_ENABLED=false
NUWAX_GEOMETRY_POINT_CLOUD_CROP_FORWARD_MAX_M=6.0
NUWAX_GEOMETRY_POINT_CLOUD_CROP_FORWARD_MIN_M=-0.5
NUWAX_GEOMETRY_POINT_CLOUD_CROP_LATERAL_M=3.0
NUWAX_GEOMETRY_POINT_CLOUD_CROP_MAX_Z_M=1.6
NUWAX_GEOMETRY_POINT_CLOUD_CROP_MIN_Z_M=-0.6
NUWAX_GEOMETRY_POINT_CLOUD_MAX_AGE_SEC=0.5
NUWAX_GEOMETRY_POINT_CLOUD_MAX_POINTS=1200
NUWAX_GEOMETRY_POINT_CLOUD_MAX_RANGE_M=8.0
NUWAX_GEOMETRY_POINT_CLOUD_MIN_RANGE_M=0.15
NUWAX_GEOMETRY_POINT_CLOUD_PREPROCESS_ENABLED=true
NUWAX_GEOMETRY_POINT_CLOUD_VOXEL_SIZE_M=0.05
NUWAX_GEOMETRY_TF_MAX_AGE_SEC=0.5
NUWAX_GEOMETRY_MAX_SENSOR_SKEW_SEC=0.2
NUWAX_GEOMETRY_TIMESTAMP_REQUIRE_MONOTONIC=true
NUWAX_GEOMETRY_TIMESTAMP_SOURCE=sensor_header
NUWAX_GEOMETRY_TRAVERSABILITY_FILTER_ENABLED=true
NUWAX_GEOMETRY_TRAVERSABILITY_MAX_SLOPE_DEG=18.0
NUWAX_GEOMETRY_TRAVERSABILITY_MAX_STEP_HEIGHT_M=0.15
NUWAX_GEOMETRY_TRAVERSABILITY_OUTPUT_LAYER=traversability
# 2026-07-09 ROS2 衍生死键（NUWAX_RTABMAP_* 17 键 + NUWAX_NAV2_* 4 键）已物理删。
# 外部栈"external_slam_nav2"进程已下线（services/geometry/ros2_ws/ 已物理删）；
# 后续若需"配置扩展"形态,在 R-N14 统一改名为 NUWAX_NUWAX_MAPPING_* 并把 _cfg_* 迁移到 NuwaxMappingConfig。
NUWAX_GEOMETRY_EXTERNAL_ENABLED=true
NUWAX_GEOMETRY_EXTERNAL_PROVIDES_MAP=true
NUWAX_GEOMETRY_EXTERNAL_PROVIDES_NAV2=true
NUWAX_GEOMETRY_EXTERNAL_PROVIDES_TF=true
NUWAX_PERCEPTION_POSTPROCESS_NMS_ENABLED=true
NUWAX_PERCEPTION_POSTPROCESS_NMS_IOU=0.55
NUWAX_MEMORY_EMBEDDING_DIM=768
NUWAX_MEMORY_EMBEDDING_MODEL=tongyi-embedding-vision-flash-2026-03-06
GO2_DDS_IFACE=eth0

PYTHONPATH=/home/unitree/nuwax-robot-bridge:/home/unitree/.local/lib/python3.8/site-packages
NUWAX_CLOUDMAP_SHM_PATH=/var/lib/nuwax_robot_bridge/nuwax_cloudmap.mmap
NUWAX_OCCUPANCY_SHM_PATH=/var/lib/nuwax_robot_bridge/nuwax_occupancy.mmap
NUWAX_MAPPING_DATABASE_ROOT=/var/lib/nuwax/gateway/geometry/mapping
NUWAX_MAPPING_PCD_ROOT=/var/lib/nuwax/gateway/geometry/pcd
YOLO_CONFIG_DIR=/var/lib/nuwax/gateway/ultralytics
XDG_CONFIG_HOME=/var/lib/nuwax/gateway/config
XDG_CACHE_HOME=/var/lib/nuwax/gateway/cache
GO2_DIRECT_DDS_POINT_CLOUD_ENABLED=true
GO2_DIRECT_DDS_POINT_CLOUD_TOPIC=rt/utlidar/cloud_deskewed
GO2_DIRECT_DDS_POINT_CLOUD_XYZ_REGISTERED_TO_ODOM=true
