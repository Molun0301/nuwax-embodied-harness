[Unit]
Description=NuwaX 本机LCM通信网络准备
Before=nuwax-host-gateway.service nuwax-geometry-runtime.service nuwax-nav-stack.service nuwax-person-follow.service

[Service]
Type=oneshot
# 仅宿主机网络准备需要特权，实际消息消费者仍使用各自普通账号。
User=root
Group=nuwax
ProtectHome=read-only
ProtectSystem=strict
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
WorkingDirectory=@NUWAX_REPO_ROOT@
# 只把解析后的总线地址交给特权准备，不导入用户文件中的其它进程环境。
ExecStart=/usr/bin/env /usr/bin/python3 -I -S @NUWAX_REPO_ROOT@/scripts/systemd/prepare_lcm_network.py --config-dir @NUWAX_CONFIG_DIR@
RemainAfterExit=yes
KillMode=control-group
TimeoutStartSec=35
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
