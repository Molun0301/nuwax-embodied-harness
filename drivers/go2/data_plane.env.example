# ==================================================
# Go2 设备侧数据面配置（完整模板 = 默认值全集）
# 说明：
# 1. 本文件由 core/config_registry.py 依据 drivers/go2/settings.py 自动生成。
# 2. 专属 Go2 设备侧输入流、运动执行、避障与机身音量；解析逻辑在 drivers/go2/settings.py。
# 3. 部署时复制为 drivers/go2/data_plane.env；环境变量优先级最高。
# 4. 平台 geometry 主配置在项目根 .env 的 NUWAX_* 配置域。
# ==================================================


# ==================================================
# 【Go2 数据面·输入流】
# ==================================================
# 启用 Go2 数据面：是否启用 Go2 设备侧数据面
GO2_DATA_PLANE_ENABLED=false
# enabled
GO2_DIRECT_DDS_ENABLED=true
# lib dir  [高级]
GO2_CYCLONEDDS_LIB_DIR=
# dds iface  [高级]
# 部署示例：eth0
GO2_DATA_PLANE_DDS_IFACE=
# low state topic  [高级]
GO2_DIRECT_DDS_LOW_STATE_TOPIC=rt/lowstate
# max points per scan  [高级]
GO2_DIRECT_DDS_MAX_POINTS_PER_SCAN=1200
# point cloud enabled  [高级]
GO2_DIRECT_DDS_POINT_CLOUD_ENABLED=false
# point cloud topic  [高级]
GO2_DIRECT_DDS_POINT_CLOUD_TOPIC=rt/utlidar/cloud
# pose topic  [高级]
GO2_DIRECT_DDS_POSE_TOPIC=rt/sportmodestate
# read timeout sec  [高级]
GO2_DIRECT_DDS_READ_TIMEOUT_SEC=0.5

# ==================================================
# 【Go2 数据面·官方控制】
# ==================================================
# backend enabled
GO2_OFFICIAL_BACKEND_ENABLED=true
# obstacle avoidance default enabled
GO2_OFFICIAL_OBSTACLE_AVOIDANCE_DEFAULT_ENABLED=false
# client timeout sec  [高级]
GO2_OFFICIAL_CLIENT_TIMEOUT_SEC=3.0
# max linear velocity mps  [高级]
GO2_OFFICIAL_MAX_LINEAR_VELOCITY_MPS=0.35
# max yaw rate rps  [高级]
GO2_OFFICIAL_MAX_YAW_RATE_RPS=0.8
# services auto start  [高级]
GO2_OFFICIAL_SERVICES_AUTO_START=false
# service names  [高级]
GO2_OFFICIAL_SERVICE_NAMES=obstacles_avoid

# ==================================================
# 【Go2 数据面·视频推流】
# ==================================================
# 启用视频推流
GO2_VIDEO_STREAM_ENABLED=true
# 推流帧率
GO2_VIDEO_STREAM_FPS=15.0
# access token  [高级 / 敏感·留空]
# 部署示例：agent-robot-bridge-token
GO2_VIDEO_STREAM_ACCESS_TOKEN=
# camera id  [高级]
GO2_VIDEO_STREAM_CAMERA_ID=front_camera
# frame id  [高级]
GO2_VIDEO_STREAM_FRAME_ID=world/go2/camera_front
# gateway url  [高级]
GO2_VIDEO_STREAM_GATEWAY_URL=ws://127.0.0.1:8766/streams/video.ingest
# height px  [高级]
GO2_VIDEO_STREAM_HEIGHT_PX=720
# reconnect sec  [高级]
GO2_VIDEO_STREAM_RECONNECT_SEC=1.0
# width px  [高级]
GO2_VIDEO_STREAM_WIDTH_PX=1280


# ==================================================
# 【附录】以下配置键经 os.environ 直读，不经 settings.py，故不在上方受管列表。
# 需要时在对应源码语境设置（环境变量或部署脚本）；此处仅登记，便于排查。
# ==================================================
# 外部几何栈正式入口：services/geometry/ros2_ws/src/GO2_RTABNAV2/go2.sh
# 平台 .env 注入：GO2_RTABNAV2/scripts/load_platform_geometry_env.sh（经 scripts/env.sh 加载）
# Nav2 参数：go2_slam_nav/config/nav2_params_go2.yaml（GO2_NAV_* 已废弃）
# GO2_VIDEO_STREAM_LOG_LEVEL  <- drivers/go2/video_streamer.py
