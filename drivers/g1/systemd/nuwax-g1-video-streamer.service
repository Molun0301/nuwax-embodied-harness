[Unit]
Description=Nuwax G1 DDS Video Streamer
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/unitree/nuwax-robot-bridge
EnvironmentFile=-/home/unitree/nuwax-robot-bridge/drivers/g1/data_plane.env
ExecStart=/usr/bin/python3 -m drivers.g1.video_streamer
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target