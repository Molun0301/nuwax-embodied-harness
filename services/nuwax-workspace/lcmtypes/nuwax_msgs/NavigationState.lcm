package nuwax_msgs;

struct NavigationState {
    string session_id;
    string robot_frame;
    int64_t stamp_sec;
    int32_t stamp_nsec;
    int32_t state;
    double goal_x;
    double goal_y;
    double goal_yaw;
    double current_x;
    double current_y;
    double current_yaw;
    double progress;
    string message;
    int64_t runtime_generation;
    int64_t guard_generation;
    int64_t pose_source_timestamp_ns;
    int64_t costmap_source_timestamp_ns;
    int8_t sink_ready;
    string planner_map_frame;
    string planner_pose_frame;
    int64_t cancel_generation;
    string zero_ack_id;
    int64_t zero_applied_monotonic_ns;
    int32_t owner_kind;
    string parent_request_id;
    int64_t goal_generation;
    int64_t path_revision;
    byte goal_payload_sha256[32];
    byte path_payload_sha256[32];
}
