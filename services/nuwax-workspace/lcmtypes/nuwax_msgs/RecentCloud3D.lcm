package nuwax_msgs;
// 当前会话的即时观测，不更新持久地图。
struct RecentCloud3D {
    string session_id;
    int64_t sequence;
    int8_t cleared;
    int32_t registration_count;
    RegisteredCloudPose registration[registration_count];
    int32_t ground_point_count;
    int32_t ground_point_indices[ground_point_count];
    sensor_msgs.PointCloud2 cloud;
}
