// LCM IDL — nuwax_msgs.FrontierList
//
// Phase 2 自有类型：frontier 列表。长度上限为 256 与上游 ROS explore
// 默认参数一致,可按需调整。
struct nuwax_msgs__FrontierList
{
    int64_t                       stamp_sec;
    int32_t                       stamp_nsec;
    string                        frame_id;
    int32_t                       frontiers_length;
    nuwax_msgs__Frontier          frontiers[256];
}
