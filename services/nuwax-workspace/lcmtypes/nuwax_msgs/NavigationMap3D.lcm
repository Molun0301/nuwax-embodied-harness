package nuwax_msgs;

struct NavigationMap3D {
    string session_id;
    int64_t revision;
    string frame_id;
    int64_t source_timestamp_ns;
    float source_voxel_size;
    // 布尔清空标记：0为生效地图，1为显式清空。
    int8_t cleared;
    // 虚拟禁区，不包含二维物理投影；内容、原点尺寸或会话变化时携带，至少每秒补带一次。
    // 未携带时沿用本进程本会话最近一份；进程启动、换会话或清空后未收到过则等待。
    int8_t has_virtual_obstacles;
    nav_msgs.OccupancyGrid virtual_obstacles;
    // 完整根清单及其所在的同机只读对象目录。
    int8_t has_fine_map;
    int32_t fine_manifest_length;
    byte fine_manifest[fine_manifest_length];
    string fine_repository_path;
    sensor_msgs.PointCloud2 cloud;
}
