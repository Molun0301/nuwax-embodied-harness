[Unit]
Requires=nuwax-lcm-network.service
After=nuwax-lcm-network.service
# Template: install with scripts/install_motion_guard_deployment.sh.
Description=nuwax navigation stack (typed LCM runtime owner)
Requires=nuwax-motion-safety-guard.service
BindsTo=nuwax-motion-safety-guard.service
PartOf=nuwax-motion-safety-guard.service
After=network-online.target nuwax-motion-safety-guard.service
Wants=network-online.target

[Service]
Type=simple
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
User=nuwax
Group=nuwax
WorkingDirectory=@NUWAX_REPO_ROOT@
LogsDirectory=nuwax/gateway
LogsDirectoryMode=0750
Environment=NUWAX_LOG_DIR=/var/log/nuwax/gateway
RuntimeDirectory=nuwax/navigation
RuntimeDirectoryMode=0750
UMask=0027
# 服务默认值；用户配置文件覆盖同名业务设置。
Environment=NUWAX_BOOTSTRAP_ENV_FILE=@NUWAX_CONFIG_DIR@/nuwax.env
Environment=NUWAX_LCM_BACKEND=real-lcm
Environment=NUWAX_REAL_LCM_REQUIRED=true
Environment=NUWAX_LCM_URL=udpm://239.255.76.67:7667?ttl=0
Environment=NUWAX_MOTION_GUARD_SOCKET=/run/nuwax/motion-guard.sock
Environment=NUWAX_NAV_STACK_READY_FILE=/run/nuwax/navigation/nuwax_nav_stack.ready
Environment="NUWAX_LCM_CHANNEL_GOAL_POSE=/nav/goal#nuwax_msgs.GoalEnvelope"
Environment="NUWAX_LCM_CHANNEL_NAV_PATH=/nav/path#nuwax_msgs.PathEnvelope"
Environment=NUWAX_NAV_STACK_WARMUP_STEPS=150
Environment=NUWAX_NAV_STACK_BINARY=@NUWAX_BIN_DIR@/nuwax-nav-stack
EnvironmentFile=-@NUWAX_CONFIG_DIR@/nuwax.env
Environment=NUWAX_USER_CONFIG_ENV_FILE=/var/lib/nuwax_robot_bridge/settings.env
EnvironmentFile=-/var/lib/nuwax_robot_bridge/settings.env
ExecStartPre=/usr/bin/rm -f /run/nuwax/navigation/nuwax_nav_stack.ready
ExecStartPre=/usr/bin/env /bin/bash @NUWAX_REPO_ROOT@/scripts/systemd/check_lcm_multicast.sh
ExecStart=/usr/bin/env /bin/bash @NUWAX_REPO_ROOT@/scripts/systemd/start_nav_stack.sh
ExecStopPost=/usr/bin/rm -f /run/nuwax/navigation/nuwax_nav_stack.ready /run/nuwax/navigation/nuwax_nav_stack.ready.runtime
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
SuccessExitStatus=0
ReadWritePaths=/run/nuwax/navigation /tmp

[Install]
WantedBy=multi-user.target
