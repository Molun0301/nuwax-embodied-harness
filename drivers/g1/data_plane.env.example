# ==================================================
# G1 设备侧数据面配置（完整模板 = 默认值全集）
# 说明：
# 1. 解析逻辑在 drivers/g1/settings.py。
# 2. 部署时复制为 drivers/g1/data_plane.env；环境变量优先级最高。
# 3. 平台 geometry 主配置在项目根 .env 的 NUWAX_* 配置域。
# 4. G1 视频与 Go2 相同，走 DDS videohub VideoClient.GetImageSample()。
# ==================================================


# ==================================================
# 【G1 数据面·总开关】
# ==================================================
G1_DATA_PLANE_ENABLED=false

# ==================================================
# 【G1 数据面·DDS 控制】
# ==================================================
G1_DDS_CONTROL_ENABLED=true
G1_SDK_PATH=/home/unitree/unitree_sdk2_python
G1_CYCLONEDDS_LIB_DIR=
G1_DATA_PLANE_DDS_IFACE=eth0
G1_DDS_CLIENT_TIMEOUT_SEC=10.0
G1_VIDEO_CLIENT_TIMEOUT_SEC=3.0
G1_DDS_POST_INIT_STABILIZE_SEC=1.0
G1_MOVE_FOR_INTERVAL_SEC=0.5
G1_MAX_LINEAR_VELOCITY_MPS=0.5
G1_MAX_YAW_RATE_RPS=0.8

# ==================================================
# 【G1 数据面·视频推流】
# ==================================================
G1_VIDEO_STREAM_ENABLED=true
G1_VIDEO_STREAM_FPS=15.0
G1_VIDEO_STREAM_CAMERA_ID=front_camera
G1_VIDEO_STREAM_FRAME_ID=world/g1/camera_front
G1_VIDEO_STREAM_WIDTH_PX=1280
G1_VIDEO_STREAM_HEIGHT_PX=720
G1_VIDEO_STREAM_RECONNECT_SEC=1.0

# ==================================================
# 【附录】
# ==================================================
# G1_VIDEO_STREAM_LOG_LEVEL  <- drivers/g1/video_streamer.py