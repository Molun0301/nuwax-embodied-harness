[Unit]
# 模板：通过 scripts/install_motion_guard_deployment.sh 安装。
Description=nuwax_robot_bridge Go2 camera video streamer
After=network-online.target nuwax-geometry-runtime.service
Wants=network-online.target nuwax-geometry-runtime.service

[Service]
Type=simple
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
User=nuwax
Group=nuwax
SupplementaryGroups=video render
WorkingDirectory=@NUWAX_REPO_ROOT@
LogsDirectory=nuwax/gateway
LogsDirectoryMode=0750
Environment=NUWAX_LOG_DIR=/var/log/nuwax/gateway
UMask=0007
Environment=PYTHONUNBUFFERED=1
Environment=NUWAX_BOOTSTRAP_ENV_FILE=@NUWAX_CONFIG_DIR@/nuwax.env
Environment=GO2_DATA_PLANE_ENV_FILE=@NUWAX_CONFIG_DIR@/go2-data-plane.env
Environment=NUWAX_VIDEO_UDS_PATH=/tmp/nuwax_video.sock
EnvironmentFile=-@NUWAX_CONFIG_DIR@/nuwax.env
EnvironmentFile=-@NUWAX_CONFIG_DIR@/go2-data-plane.env
Environment=NUWAX_USER_CONFIG_ENV_FILE=/var/lib/nuwax_robot_bridge/settings.env
EnvironmentFile=-/var/lib/nuwax_robot_bridge/settings.env
# 视频发送器不依赖 GO2_DATA_PLANE_ENABLED；它只依赖锁定的 WebRTC 包、
# Go2 IP/key 配置和 geometry runtime 提供的 UDS 中转。
ExecStart=/usr/bin/env PYTHONUNBUFFERED=1 PYTHONPATH=@NUWAX_REPO_ROOT@ @NUWAX_PYTHON_BIN@ -m drivers.go2.video_streamer
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=1
TimeoutStopSec=10
SuccessExitStatus=0
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
