package nuwax_msgs;

struct NativePgoResult {
    const int32_t SCHEMA_VERSION_V3 = 3;
    const int32_t BACKEND_NATIVE_PGO = 2;
    const int32_t TRANSFORM_ABSOLUTE_LEFT_CORRECTION_SE3 = 1;
    const int32_t DISPOSITION_NO_CANDIDATE = 1;
    const int32_t DISPOSITION_CORRECTION = 2;
    const int32_t DISPOSITION_REJECTED = 3;
    const int32_t REJECTION_NONE = 0;
    const int32_t REJECTION_INSUFFICIENT_GRAPH = 1;
    const int32_t REJECTION_INVALID_GRAPH = 2;
    const int32_t REJECTION_NUMERIC_FAILURE = 3;
    const int32_t REJECTION_RESOURCE_LIMIT = 4;
    const int32_t REJECTION_CANCELLED = 5;
    // Online SimplePGO owner hard limits. These bind every CORRECTION result.
    const int64_t MAX_GRAPH_NODES = 2000;
    const int64_t MAX_GRAPH_EDGES = 3997;
    const int64_t MAX_GRAPH_LOOP_EDGES = 1998;
    const int64_t MAX_LOOP_INLIERS = 20000;
    const int32_t MAX_OPTIMIZATION_ITERATIONS = 300;

    int32_t schema_version;
    int32_t backend;
    int64_t runtime_generation;
    int64_t backend_generation;
    int64_t request_sequence;
    string mapping_session_id;
    int64_t mapping_session_generation;
    // Actual occupancy-owner domain; distinct from correction backend_generation.
    string mapping_backend_kind;
    int64_t mapping_backend_generation;
    int64_t map_frame_generation;
    byte mapping_commit_boot_nonce[16];
    int64_t mapping_commit_sequence;
    int64_t occupancy_revision;
    int64_t cloud_revision;
    int64_t committed_map_source_timestamp_ns;
    // Existing admitted LIO source domain, not the correction backend.
    int32_t registered_cloud_backend;
    int64_t registered_cloud_runtime_generation;
    int64_t registered_cloud_source_sequence;
    int64_t registered_cloud_source_timestamp_ns;
    // Original admitted scan count; the selected body payload may be smaller.
    int64_t registered_cloud_point_count;
    int64_t registered_body_point_count;
    int64_t correlated_odom_source_sequence;
    int64_t correlated_odom_source_timestamp_ns;
    double frozen_odom_translation_m[3];
    double frozen_odom_rotation_xyzw[4];
    int64_t committed_map_width;
    int64_t committed_map_height;
    double committed_map_resolution_m;
    double committed_map_origin_x_m;
    double committed_map_origin_y_m;
    int64_t source_timestamp_ns;
    string map_frame_id;
    string odom_frame_id;
    string body_frame_id;
    string points_frame_id;
    byte correction_lease_boot_nonce[16];
    int64_t correction_lease_generation;
    // Every admitted request has exactly one terminal disposition.
    int32_t result_disposition;
    int64_t result_timestamp_ns;
    // Zero for NO_CANDIDATE/REJECTED; fixed to ABSOLUTE_LEFT for CORRECTION.
    int32_t transform_semantics;
    double translation_m[3];
    // Quaternion component order is x, y, z, w.
    double rotation_xyzw[4];
    // CORRECTION-only proof. Lower fitness/RMSE is better and both are nonnegative.
    double fitness_score;
    double inlier_rmse_m;
    int64_t loop_source_node_id;
    int64_t loop_target_node_id;
    int64_t loop_inlier_count;
    int64_t optimized_graph_node_count;
    int64_t optimized_graph_edge_count;
    int64_t optimized_graph_loop_edge_count;
    int32_t optimization_iterations;
    int8_t optimization_converged;
    double optimization_initial_cost;
    double optimization_final_cost;
    // 完整优化关键帧，时间精确保留源纳秒，位姿属于优化后的里程计世界坐标。
    int32_t trajectory_count;
    int64_t trajectory_timestamp_ns[trajectory_count];
    double trajectory_translation_m[trajectory_count][3];
    double trajectory_rotation_xyzw[trajectory_count][4];

    // REJECTED requires a typed rejection reason and detail; other dispositions use zero/empty.
    int32_t rejection_reason_code;
    string rejection_reason;
}
