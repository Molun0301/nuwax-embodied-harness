NUWAX_PERCEPTION_SEGMENTATION_LOW_LATENCY_BACKEND_NAME=yolo_world_sam2
# map projection coverage threshold  [高级]
NUWAX_PERCEPTION_SEGMENTATION_MAP_PROJECTION_COVERAGE_THRESHOLD=0.2
# polygon simplification epsilon px  [高级]
NUWAX_PERCEPTION_SEGMENTATION_POLYGON_SIMPLIFICATION_EPSILON_PX=2.0
