package nuwax_msgs;

struct PathEnvelope {
    int32_t schema_version;
    string session_id;
    // 原目标的 uint64 运动代次，保持相同的八个字节。
    int64_t motion_generation;
    int64_t planner_runtime_generation;
    int64_t path_revision;
    // 0为完整路线，1为仅到可达已观测地面的逼近路线。
    int8_t route_kind;
    nav_msgs.Path path;
}
