package nuwax_msgs;

struct NavigationMapBlock {
    const int8_t OBJECT_KIND_ASSIGNED = 1;
    const int8_t OBJECT_KIND_LEGACY = 2;

    // Exactly one identity is nonzero; legacy aliases are opaque, never recomputed.
    int8_t object_kind;
    byte object_id[16];
    byte legacy_alias[32];
    int32_t data_length;
    byte data[data_length];
}
