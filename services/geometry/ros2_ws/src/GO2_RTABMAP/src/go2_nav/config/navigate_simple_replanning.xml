<!--
  Minimal Nav2 tree for GO2 mapping tests.
  It avoids recovery actions that can leave controller goals active after BT aborts
  on ROS 2 Foxy under mapping load.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="NavigateWithReplanning">
      <!-- 0.25 Hz: mapping mode /map shifts often; 1 Hz replan made FollowPath
           restart every second when side walls flickered, causing stop-go. -->
      <RateController hz="0.25">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" server_timeout="5000"/>
      </RateController>
      <FollowPath path="{path}" controller_id="FollowPath" server_timeout="5000"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
